{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }
{%- endstyle -%}

<section class="product-results-section color-{{ section.settings.color_scheme }}">
  <div class="section ">
    <div class="container">
      <!-- Header -->
      <div class="pr-header">
        <h2 class="pr-heading">
          {{ section.settings.heading }}
        </h2>
        <p class="pr-subheading">
          {{ section.settings.subheading }}
        </p>
      </div>

      <!-- Testimonials Carousel -->
      <div class="pr-carousel-wrapper">
        <div class="pr-carousel">
          <div class="pr-carousel-inner" id="carouselWrapper" data-items-desktop="{{ section.settings.items_per_row_desktop }}" data-items-mobile="{{ section.settings.items_per_row_mobile }}">
            {% for block in section.blocks %}
              <div class="pr-slide">
                <div class="pr-slide-content">
                  <!-- Before/After Images -->
                  <div class="pr-images">
                    <div class="pr-image-pair">
                      <div class="pr-image-box">
                        {% if block.settings.before_image %}
                          <img 
                            src="{{ block.settings.before_image | image_url: width: 300 }}"
                            alt="Before"
                          >
                        {% else %}
                          <div class="pr-image-placeholder">
                            <span>Before Image</span>
                          </div>
                        {% endif %}
                      </div>
                      <span class="pr-image-label">Before</span>
                    </div>
                    <div class="pr-image-pair">
                      <div class="pr-image-box">
                        {% if block.settings.after_image %}
                          <img 
                            src="{{ block.settings.after_image | image_url: width: 300 }}"
                            alt="After"
                          >
                        {% else %}
                          <div class="pr-image-placeholder">
                            <span>After Image</span>
                          </div>
                        {% endif %}
                      </div>
                      <span class="pr-image-label">{{ block.settings.after_text }}</span>
                    </div>
                  </div>

                  <!-- Customer Info -->
                  <div class="pr-customer-info">
                    <div class="pr-customer-header">
                      <div class="pr-customer-header-name">
                        {% if block.settings.country_flag %}
                          <span class="pr-flag">{{ block.settings.country_flag }}</span>
                        {% endif %}
                          <span class="pr-customer-name">{{ block.settings.customer_name }}</span>
                      </div>
                      {% if block.settings.verified %}
                        <div class="pr-customer-badge">
                          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M14.2429 14.25H14.25H14.2429ZM14.2429 14.25C13.7758 14.7131 12.9295 14.5978 12.3359 14.5978C11.6074 14.5978 11.2565 14.7403 10.7366 15.2603C10.2938 15.703 9.70028 16.5 9 16.5C8.29973 16.5 7.70618 15.703 7.26343 15.2603C6.74346 14.7403 6.39262 14.5978 5.66405 14.5978C5.07051 14.5978 4.22413 14.7131 3.75712 14.25C3.28636 13.7832 3.40221 12.9333 3.40221 12.3359C3.40221 11.5811 3.23712 11.2339 2.69954 10.6964C1.89986 9.8967 1.50001 9.4968 1.5 9C1.50001 8.50313 1.89984 8.1033 2.69951 7.30363C3.1794 6.82374 3.40221 6.34821 3.40221 5.66405C3.40221 5.07049 3.28687 4.2241 3.75 3.75708C4.21682 3.28633 5.0667 3.4022 5.66406 3.4022C6.3482 3.4022 6.82374 3.1794 7.30361 2.69953C8.1033 1.89984 8.50313 1.5 9 1.5C9.49687 1.5 9.8967 1.89984 10.6964 2.69953C11.1761 3.1793 11.6516 3.4022 12.3359 3.4022C12.9295 3.4022 13.7759 3.28685 14.243 3.75C14.7137 4.21682 14.5978 5.06669 14.5978 5.66405C14.5978 6.41894 14.7629 6.76603 15.3005 7.30363C16.1002 8.1033 16.5 8.50313 16.5 9C16.5 9.4968 16.1002 9.8967 15.3005 10.6964C14.7629 11.2339 14.5978 11.5811 14.5978 12.3359C14.5978 12.9333 14.7136 13.7832 14.2429 14.25Z" fill="#26736D"/>
                          <path d="M14.2429 14.25H14.25M14.2429 14.25C13.7758 14.7131 12.9295 14.5978 12.3359 14.5978C11.6074 14.5978 11.2565 14.7403 10.7366 15.2603C10.2938 15.7031 9.70028 16.5 9 16.5C8.29972 16.5 7.70618 15.7031 7.26343 15.2603C6.74346 14.7403 6.39262 14.5978 5.66405 14.5978C5.07051 14.5978 4.22414 14.7131 3.75712 14.25C3.28636 13.7832 3.40221 12.9333 3.40221 12.3359C3.40221 11.5811 3.23712 11.2339 2.69954 10.6963C1.89986 9.8967 1.50001 9.4968 1.5 9C1.50001 8.50312 1.89984 8.1033 2.69951 7.30363C3.1794 6.82374 3.40221 6.34821 3.40221 5.66405C3.40221 5.07049 3.28687 4.2241 3.75 3.75708C4.21682 3.28633 5.0667 3.4022 5.66406 3.4022C6.3482 3.4022 6.82374 3.1794 7.30361 2.69953C8.1033 1.89984 8.50312 1.5 9 1.5C9.49688 1.5 9.8967 1.89984 10.6963 2.69953C11.1761 3.1793 11.6516 3.4022 12.3359 3.4022C12.9295 3.4022 13.7759 3.28685 14.243 3.75C14.7137 4.21682 14.5978 5.06669 14.5978 5.66405C14.5978 6.41894 14.7629 6.76603 15.3005 7.30363C16.1002 8.1033 16.5 8.50312 16.5 9C16.5 9.4968 16.1002 9.8967 15.3005 10.6963C14.7629 11.2339 14.5978 11.5811 14.5978 12.3359C14.5978 12.9333 14.7136 13.7832 14.2429 14.25Z" stroke="#26736D" stroke-width="1.5"/>
                          <path d="M6.75 9.66968L8.1 10.875L11.25 7.125" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>

                          <span class="pr-badge-text">Verified customer</span>
                          </div>
                      {% endif %}
                    </div>
                    <p class="pr-testimonial-title">{{ block.settings.testimonial_title }}</p>
                    <p class="pr-testimonial-text">
                      "{{ block.settings.testimonial_text }}"
                    </p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- Navigation -->
        <div class="pr-navigation">
          <button class="pr-nav-btn pr-nav-prev" id="prevBtn">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <span class="pr-slide-counter" id="slideCount">
            <span id="currentSlide">1</span>/<span id="totalSlides">{{ section.blocks.size }}</span>
          </span>
          <button class="pr-nav-btn pr-nav-next" id="nextBtn">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      
      const wrapper = section.querySelector('#carouselWrapper');
      const slides = section.querySelectorAll('.pr-slide');
      const prevBtn = section.querySelector('#prevBtn');
      const nextBtn = section.querySelector('#nextBtn');
      const currentSlideSpan = section.querySelector('#currentSlide');
      const totalSlidesSpan = section.querySelector('#totalSlides');
      
      if (!wrapper || !slides.length) return;

      const itemsDesktop = parseInt(wrapper.dataset.itemsDesktop) || 3;
      const itemsMobile = parseInt(wrapper.dataset.itemsMobile) || 1;
      const totalItems = slides.length;
      
      let currentSlide = 0;

      function getItemsPerSlide() {
        return window.innerWidth < 768 ? itemsMobile : itemsDesktop;
      }

      function getTotalSlides() {
        const itemsPerSlide = getItemsPerSlide();
        return Math.ceil(totalItems / itemsPerSlide);
      }

      function updateCarousel() {
        if (!wrapper) return;
        const offset = -currentSlide * 100;
        wrapper.style.transform = `translateX(calc(${offset}% - ${currentSlide * 2}rem))`;
        if (currentSlideSpan) {
          currentSlideSpan.textContent = currentSlide + 1;
        }
      }

      function setVariables() {
        const itemsPerSlide = getItemsPerSlide();
        document.documentElement.style.setProperty('--items-per-slide', itemsPerSlide);
        const totalSlides = getTotalSlides();
        if (totalSlidesSpan) {
          totalSlidesSpan.textContent = totalSlides;
        }
        const maxSlide = Math.max(0, totalSlides - 1);
        if (currentSlide > maxSlide) {
          currentSlide = maxSlide;
        }
        updateCarousel();
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          const totalSlides = getTotalSlides();
          currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
          updateCarousel();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const totalSlides = getTotalSlides();
          currentSlide = (currentSlide + 1) % totalSlides;
          updateCarousel();
        });
      }

      // Set initial variables
      setVariables();

      // Handle window resize
      window.addEventListener('resize', setVariables);
    })();
  </script>

  <style>
    #shopify-section-{{ section.id }} {
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .product-results-section {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
    }

    #shopify-section-{{ section.id }} .pr-header {
      text-align: center;
      max-width: 720px;
      margin-inline: auto;
      margin-bottom: 3rem;
    }

    #shopify-section-{{ section.id }} .pr-heading {
      {% comment %} font-size: 2rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 1rem;
      line-height: 1.2; {% endcomment %}
    }

    #shopify-section-{{ section.id }} .pr-subheading {
      font-size: 1.125rem;
      color: #666666;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .pr-carousel-wrapper {
      position: relative;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .pr-carousel {
      
      width: 100%;
    }

    #shopify-section-{{ section.id }} .pr-carousel-inner {
      display: flex;
      transition: transform 0.3s ease;
      will-change: transform;
      gap: 2rem;
    }

    #shopify-section-{{ section.id }} .pr-slide {
      flex: 0 0 calc((100% - 4rem) / 3);
      padding: 1rem;
      padding-bottom: 1.25rem;
      display: flex;
      justify-content: center;
      background: #FFFFFF;
      box-shadow: 0px 1px 2px rgba(10, 13, 18, 0.05);
      border-radius: 20px;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .pr-slide-content {
      max-width: 500px;
      width: 100%;
      padding: 0 0.5rem;
    }

    #shopify-section-{{ section.id }} .pr-images {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    #shopify-section-{{ section.id }} .pr-image-pair {
      flex: 1;
      position: relative;
    }

    #shopify-section-{{ section.id }} .pr-image-box {
      background-color: #e0e0e0;
      border-radius: 0.5rem;
      height: 16rem;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .pr-image-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #shopify-section-{{ section.id }} .pr-image-placeholder {
      width: 100%;
      height: 100%;
      background-color: #d0d0d0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999999;
      font-size: 0.875rem;
    }

    #shopify-section-{{ section.id }} .pr-image-label {
      position: absolute;
      left: 8px;
      top: 8px;
      background: #FFFFFF;
      border-radius: 9999px;
      padding: 4px 12px;
      font-weight: 500;
      font-size: 14px;
      line-height: 145%;
    }

    #shopify-section-{{ section.id }} .pr-customer-info {
      display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem;
    }

    #shopify-section-{{ section.id }} .pr-customer-header {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 0;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    #shopify-section-{{ section.id }} .pr-customer-header-name {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
    }

    #shopify-section-{{ section.id }} .pr-customer-badge {
          display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 4px 12px 4px 8px;
    background: #ECF9F8;
    border: 1px solid #BCD9D6;
    border-radius: 30px;
        font-size: 14px;
    line-height: 145%;
      font-weight: 500;
        
    /* Brand/500 */
    color: #26736D;

    }

    #shopify-section-{{ section.id }} .pr-flag {
      font-size: 1.5rem;
    }

    #shopify-section-{{ section.id }} .pr-customer-name {
      font-style: normal;
      font-weight: 700;
      font-size: 16px;
      line-height: 150%;

      /* Gray/900 */
      color: #181D27;
      margin: 0;

    }
{% comment %} 
    #shopify-section-{{ section.id }} .pr-badge-icon {
      width: 1.25rem;
      height: 1.25rem;
      color: #16a34a;
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .pr-badge-text {
      font-size: 0.75rem;
      color: #16a34a;
      font-weight: 500;
    } {% endcomment %}

    #shopify-section-{{ section.id }} .pr-testimonial-title {
      font-size: 20px;
      line-height: 140%;
      align-items: center;
      color: #181D27;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .pr-testimonial-text {
          font-size: 1rem;
    color: #535862;
    font-style: italic;
    margin: 0;
    line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .pr-navigation {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 3rem;
    }



    #shopify-section-{{ section.id }} .pr-nav-btn {
      padding: 0.5rem;
      background: transparent;
      border: none;
      cursor: pointer;
      border-radius: 9999px;
      transition: background-color 0.2s ease;
      width: 40px;
      height: 40px;
      background: #E3E3DE;
      border-radius: 40px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;

      width: 40px;
      height: 40px;

      /* White */
      background: #FFFFFF;
      /* Gray/100 */
      border: 1px solid #F5F5F5;
      /* Shadows/shadow-lg

      Shadows allow you to add depth and realism to designs by positioning elements on a z-axis.
      */
      box-shadow: 0px 12px 16px -4px rgba(10, 13, 18, 0.08), 0px 4px 6px -2px rgba(10, 13, 18, 0.03), 0px 2px 2px -1px rgba(10, 13, 18, 0.04);
      border-radius: 40px;
      transform: matrix(1, 0, 0, -1, 0, 0);
    }

    #shopify-section-{{ section.id }} .pr-nav-btn:hover {
      background-color: #E3E3DE;
    }

    #shopify-section-{{ section.id }} .pr-nav-btn svg {
      width: 1.5rem;
      height: 1.5rem;
      color: #666666;
    }

    #shopify-section-{{ section.id }} .pr-slide-counter {
      font-weight: 500;
      font-size: 24px;
      line-height: 140%;
      color: #181D27;
    }

    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .product-results-section {
        padding-top: var(--section-padding-top-mobile);
        padding-bottom: var(--section-padding-bottom-mobile);
      }

      #shopify-section-{{ section.id }} .pr-heading {
        font-size: 1.5rem;
      }

      #shopify-section-{{ section.id }} .pr-subheading {
        font-size: 1rem;
      }

      #shopify-section-{{ section.id }} .pr-image-box {
        height: 12rem;
      }

      #shopify-section-{{ section.id }} .pr-slide {
        flex: 0 0 100%;
        padding: 0 0.25rem;
      }

      #shopify-section-{{ section.id }} .pr-slide-content {
        margin: 0 0.25rem;
      }
    }

    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .pr-carousel {
          --items-per-slide: 2;
      }
    }

    @media (min-width: 1200px) {
      #shopify-section-{{ section.id }} .pr-carousel {
        {% comment %} overflow-x: auto; {% endcomment %}
         --items-per-slide: 3;
         overflow: hidden;
      }
    }
  </style>
</section>

