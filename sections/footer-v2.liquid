<style>
  #shopify-section-{{ section.id }} .footer {
    background-color: #F5F3EE;
    padding: 3rem 0;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer {
      padding: 4rem 0;
    }
  }

  #shopify-section-{{ section.id }} .footer .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .section {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .footer .section {
      padding: 0 2rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .footer-contents {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .footer-contents {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .footer .footer-contents {
      grid-template-columns: repeat(3, 1fr);
      gap: 4rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .newsletter-section h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .newsletter-section h3 {
      font-size: 1.25rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .newsletter-section p {
    font-size: 0.8125rem;
    color: #666666;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .newsletter-section p {
      font-size: 0.875rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .newsletter-form {
    position: relative;
  }

  #shopify-section-{{ section.id }} .footer .newsletter-form input[type="email"] {
    width: 100%;
    padding: 0.625rem 0;
    font-size: 0.8125rem;
    border: none;
    border-bottom: 1px solid #D1D1D1;
    background: transparent;
    color: #1a1a1a;
    outline: none;
    transition: border-color 0.3s;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .newsletter-form input[type="email"] {
      font-size: 0.875rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .newsletter-form input[type="email"]::placeholder {
    color: #999999;
  }

  #shopify-section-{{ section.id }} .footer .newsletter-form input[type="email"]:focus {
    border-bottom-color: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .footer .newsletter-form button {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: #4A9B8E;
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.3s;
  }

  #shopify-section-{{ section.id }} .footer .newsletter-form button:hover {
    color: #3d8275;
  }

  #shopify-section-{{ section.id }} .footer .help-links-section h4,
  #shopify-section-{{ section.id }} .footer .company-links-section h4 {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .help-links-section h4,
    #shopify-section-{{ section.id }} .footer .company-links-section h4 {
      font-size: 0.875rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .help-links-section ul,
  #shopify-section-{{ section.id }} .footer .company-links-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .footer .help-links-section li,
  #shopify-section-{{ section.id }} .footer .company-links-section li {
    margin-bottom: 0.625rem;
  }

  #shopify-section-{{ section.id }} .footer .help-links-section a,
  #shopify-section-{{ section.id }} .footer .company-links-section a {
    font-size: 0.8125rem;
    color: #666666;
    text-decoration: none;
    line-height: 1.6;
    transition: color 0.3s;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .help-links-section a,
    #shopify-section-{{ section.id }} .footer .company-links-section a {
      font-size: 0.875rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .help-links-section a:hover,
  #shopify-section-{{ section.id }} .footer .company-links-section a:hover {
    color: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .footer .payment-icons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .footer .payment-icon {
    background: white;
    border-radius: 0.375rem;
    padding: 0.375rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  #shopify-section-{{ section.id }} .footer .payment-icon img {
    height: 1rem;
    width: auto;
  }

  #shopify-section-{{ section.id }} .footer .payment-icon span {
    font-size: 0.75rem;
    font-weight: 500;
    color: #666666;
  }

  #shopify-section-{{ section.id }} .footer .social-icons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  #shopify-section-{{ section.id }} .footer .social-icons a {
    color: #1a1a1a;
    transition: color 0.3s;
  }

  #shopify-section-{{ section.id }} .footer .social-icons a:hover {
    color: #4A9B8E;
  }

  #shopify-section-{{ section.id }} .footer .copyright {
    text-align: center;
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .footer .copyright p {
    font-size: 0.75rem;
    color: #666666;
  }

  #shopify-section-{{ section.id }} .footer .footer-logo {
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .footer .footer-logo img {
    height: 2.5rem;
    width: auto;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .footer-logo img {
      height: 3.5rem;
    }
  }

  #shopify-section-{{ section.id }} .footer .footer-logo h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer .footer-logo h2 {
      font-size: 2.25rem;
    }
  }
</style>

<footer class="footer bg-[#F5F3EE] py-12 md:py-16">
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
    <div class="footer-contents">
      
      {%- comment -%} Newsletter Section {%- endcomment -%}
      <div class="newsletter-section">
        {%- if section.settings.newsletter_heading != blank -%}
          <h3 class="text-lg md:text-xl font-semibold text-[#1a1a1a] mb-3 leading-tight">
            {{ section.settings.newsletter_heading }}
          </h3>
        {%- endif -%}
        
        {%- if section.settings.newsletter_description != blank -%}
          <p class="text-[13px] md:text-sm text-[#666666] mb-6 leading-relaxed">
            {{ section.settings.newsletter_description }}
          </p>
        {%- endif -%}

        {%- if section.settings.show_newsletter_form -%}
          <div class="newsletter-form">
            {%- form 'customer', class: 'newsletter-form-wrapper' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="relative">
                <input
                  type="email"
                  name="contact[email]"
                  class="w-full px-0 py-2.5 text-[13px] md:text-sm border-0 border-b border-[#D1D1D1] bg-transparent focus:outline-none focus:border-[#1a1a1a] transition-colors text-[#1a1a1a] placeholder:text-[#999999]"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
                  aria-label="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
                  required
                >
                <button
                  type="submit"
                  class="absolute right-0 top-1/2 -translate-y-1/2 text-[#4A9B8E] hover:text-[#3d8275] transition-colors"
                  aria-label="{{ section.settings.newsletter_button_label | default: 'Subscribe' }}"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Help Links Section {%- endcomment -%}
      {%- if section.settings.show_help_section -%}
        <div class="help-links-section">
          {%- if section.settings.help_heading != blank -%}
            <h4 class="text-[13px] md:text-sm font-semibold text-[#1a1a1a] mb-4">
              {{ section.settings.help_heading }}
            </h4>
          {%- endif -%}
          
          {%- if section.settings.help_menu != blank -%}
            {%- assign help_menu = linklists[section.settings.help_menu] -%}
            {%- if help_menu.links.size > 0 -%}
              <ul class="space-y-2.5">
                {%- for link in help_menu.links -%}
                  <li>
                    <a 
                      href="{{ link.url }}" 
                      class="text-[13px] md:text-sm text-[#666666] hover:text-[#1a1a1a] transition-colors leading-relaxed"
                    >
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Company Links Section {%- endcomment -%}
      {%- if section.settings.show_company_section -%}
        <div class="company-links-section">
          {%- if section.settings.company_heading != blank -%}
            <h4 class="text-[13px] md:text-sm font-semibold text-[#1a1a1a] mb-4">
              {{ section.settings.company_heading }}
            </h4>
          {%- endif -%}
          
          {%- if section.settings.company_menu != blank -%}
            {%- assign company_menu = linklists[section.settings.company_menu] -%}
            {%- if company_menu.links.size > 0 -%}
              <ul class="space-y-2.5">
                {%- for link in company_menu.links -%}
                  <li>
                    <a 
                      href="{{ link.url }}" 
                      class="text-[13px] md:text-sm text-[#666666] hover:text-[#1a1a1a] transition-colors leading-relaxed"
                    >
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Payment Icons {%- endcomment -%}
    {%- if section.settings.show_payment_icons -%}
      <div class="payment-icons flex justify-center items-center gap-2.5 mb-6 flex-wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == 'payment_icon' -%}
            <div class="payment-icon bg-white rounded-md px-3 py-1.5 flex items-center justify-center shadow-sm">
              {%- if block.settings.icon_image != blank -%}
                <img 
                  src="{{ block.settings.icon_image | image_url: width: 50 }}" 
                  alt="{{ block.settings.icon_name }}"
                  loading="lazy"
                  class="h-4 w-auto"
                >
              {%- else -%}
                <span class="text-xs font-medium text-[#666666]">{{ block.settings.icon_name }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Social Icons {%- endcomment -%}
    {%- if section.settings.show_social_icons -%}
      <div class="social-icons flex justify-center items-center gap-5 mb-6">
        {%- for block in section.blocks -%}
          {%- if block.type == 'social_icon' -%}
            <a 
              href="{{ block.settings.url }}" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-[#1a1a1a] hover:text-[#4A9B8E] transition-colors"
              aria-label="{{ block.settings.platform }}"
            >
              {%- case block.settings.platform -%}
                {%- when 'instagram' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                {%- when 'tiktok' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                  </svg>
                {%- when 'facebook' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                {%- when 'linkedin' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                {%- when 'twitter' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                  </svg>
                {%- when 'youtube' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                {%- when 'pinterest' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
                  </svg>
              {%- endcase -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Copyright {%- endcomment -%}
    {%- if section.settings.show_copyright and section.settings.copyright_text != blank -%}
      <div class="copyright text-center mb-8">
        <p class="text-xs text-[#666666]">
          {{ section.settings.copyright_text }}
        </p>
      </div>
    {%- endif -%}

    {%- comment -%} Logo {%- endcomment -%}
    {%- if section.settings.show_logo -%}
      <div class="footer-logo flex justify-center">
        {%- if section.settings.logo_image != blank -%}
          <img 
            src="{{ section.settings.logo_image | image_url: width: 400 }}" 
            alt="{{ shop.name }}"
            loading="lazy"
            class="h-10 md:h-14 w-auto"
          >
        {%- else -%}
          <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a]">
            {{ shop.name }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer V2",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5F3EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    },
    {
      "type": "header",
      "content": "Newsletter Section"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter_form",
      "label": "Show newsletter form",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe and get your 20% discount!"
    },
    {
      "type": "textarea",
      "id": "newsletter_description",
      "label": "Newsletter description",
      "default": "You'll receive news, discounts, and helpful tips to take care of your skin and hair with lots of love."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Button aria label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Help Links Section"
