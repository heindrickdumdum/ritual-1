{{ 'base.css' | asset_url | stylesheet_tag }}

<footer class="footer bg-[#F5F3EE] py-12 md:py-16">
  <div class="container mx-auto px-4 md:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12 mb-12">
      
      {%- comment -%} Newsletter Section {%- endcomment -%}
      <div class="newsletter-section">
        {%- if section.settings.newsletter_heading != blank -%}
          <h3 class="text-xl md:text-2xl font-medium text-gray-900 mb-3">
            {{ section.settings.newsletter_heading }}
          </h3>
        {%- endif -%}
        
        {%- if section.settings.newsletter_description != blank -%}
          <p class="text-sm text-gray-600 mb-6">
            {{ section.settings.newsletter_description }}
          </p>
        {%- endif -%}

        {%- if section.settings.show_newsletter_form -%}
          <div class="newsletter-form">
            {%- form 'customer', class: 'newsletter-form-wrapper' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="relative">
                <input
                  type="email"
                  name="contact[email]"
                  class="w-full px-0 py-3 text-sm border-0 border-b border-gray-300 bg-transparent focus:outline-none focus:border-gray-900 transition-colors"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
                  aria-label="{{ section.settings.newsletter_placeholder | default: 'Email' }}"
                  required
                >
                <button
                  type="submit"
                  class="absolute right-0 top-1/2 -translate-y-1/2 text-[#4A9B8E] hover:text-[#3A8B7E] transition-colors"
                  aria-label="Subscribe"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Help Links Section {%- endcomment -%}
      <div class="help-links-section">
        {%- if section.settings.help_heading != blank -%}
          <h4 class="text-sm font-medium text-gray-900 mb-4">
            {{ section.settings.help_heading }}
          </h4>
        {%- endif -%}
        
        <ul class="space-y-2">
          {%- for block in section.blocks -%}
            {%- if block.type == 'help_link' -%}
              <li>
                <a 
                  href="{{ block.settings.link }}" 
                  class="text-sm text-gray-600 hover:text-gray-900 transition-colors"
                >
                  {{ block.settings.text }}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Company Links Section {%- endcomment -%}
      <div class="company-links-section">
        {%- if section.settings.company_heading != blank -%}
          <h4 class="text-sm font-medium text-gray-900 mb-4">
            {{ section.settings.company_heading }}
          </h4>
        {%- endif -%}
        
        <ul class="space-y-2">
          {%- for block in section.blocks -%}
            {%- if block.type == 'company_link' -%}
              <li>
                <a 
                  href="{{ block.settings.link }}" 
                  class="text-sm text-gray-600 hover:text-gray-900 transition-colors"
                >
                  {{ block.settings.text }}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    {%- comment -%} Payment Icons {%- endcomment -%}
    {%- if section.settings.show_payment_icons -%}
      <div class="payment-icons flex justify-center items-center gap-3 mb-6 flex-wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == 'payment_icon' -%}
            <div class="payment-icon bg-white rounded px-3 py-2 flex items-center justify-center">
              {%- if block.settings.icon_image != blank -%}
                <img 
                  src="{{ block.settings.icon_image | image_url: width: 50 }}" 
                  alt="{{ block.settings.icon_name }}"
                  loading="lazy"
                  class="h-5 w-auto"
                >
              {%- else -%}
                <span class="text-xs font-medium text-gray-600">{{ block.settings.icon_name }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Social Icons {%- endcomment -%}
    {%- if section.settings.show_social_icons -%}
      <div class="social-icons flex justify-center items-center gap-4 mb-6">
        {%- for block in section.blocks -%}
          {%- if block.type == 'social_icon' -%}
            <a 
              href="{{ block.settings.url }}" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-gray-900 hover:text-[#4A9B8E] transition-colors"
              aria-label="{{ block.settings.platform }}"
