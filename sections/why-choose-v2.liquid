{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }

  #shopify-section-{{ section.id }} .section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .why-choose-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .why-choose-header__title {
    font-weight: 400;
    margin: 0 0 1rem;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .why-choose-header__title .highlight {
    color: {{ section.settings.highlight_color }};
  }

  #shopify-section-{{ section.id }} .why-choose-header__description {
    font-size: 1.25rem;
    color: rgba(var(--color-foreground), 0.7);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .why-choose-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .why-choose-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .why-choose-card {
    background: #F7F7F5;
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .why-choose-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .why-choose-card__content {
    margin-bottom: 1.5rem;
    text-align: var(--card-text-align, left);
  }

  #shopify-section-{{ section.id }} .why-choose-card__title {
    font-weight: 500;
    margin: 0 0 0.75rem;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .why-choose-card__description {
    font-size: 1.125rem;
    color: #535862; /* Gray/600 */
    line-height: 1.6;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .why-choose-card__image {
    width: 100%;
    height: 400px;
    background: #E5E5E0;
    border-radius: 12px;
    overflow: hidden;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .why-choose-card__image--full-height {
    /* height: 100%; */
    flex: 1;
  }

  #shopify-section-{{ section.id }} .why-choose-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .why-choose-testimonial {
    background: #F7F7F5;
    border-radius: 16px;
    padding: 2rem;
    text-align: var(--testimonial-text-align, center);
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .why-choose-testimonial__quote {
    color: rgb(var(--color-foreground));
    line-height: normal;
    margin: 0 0 1rem;
    font-weight: normal;
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .why-choose-testimonial__author {
    font-size: 1.125rem;
    color: rgba(var(--color-foreground), 0.6);
    font-style: normal;
    /* Gray/600 */
    color: #535862;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .why-choose-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: var(--section-padding-top-mobile);
      --section-padding-bottom: var(--section-padding-bottom-mobile);
    }

    #shopify-section-{{ section.id }} .why-choose-header__description {
      line-height: 1.5rem;
    }

    #shopify-section-{{ section.id }} .why-choose-card__description {
          line-height: 24px;
    }

    #shopify-section-{{ section.id }} .why-choose-card__image--full-height {
      flex: none;
    }

    #shopify-section-{{ section.id }} .why-choose-header__title {
      line-height: 32px;
    }

    #shopify-section-{{ section.id }} .why-choose-card__title {
      line-height: 28px;
    }

    #shopify-section-{{ section.id }} .why-choose-grid {
      gap: 1rem;
    }

    #shopify-section-{{ section.id }} .why-choose-header {
      margin-bottom: 2.5rem;
    }

    #shopify-section-{{ section.id }} .why-choose-card {
      padding: 1.25rem;
    }

    #shopify-section-{{ section.id }} .why-choose-column {
      gap: 1rem;
    }

    #shopify-section-{{ section.id }} .why-choose-testimonial {
      padding: 1.25rem;
    }

    #shopify-section-{{ section.id }} .why-choose-testimonial__quote {
      line-height: 32px;
    }
    
    {% if section.settings.header_title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-header__title {
      font-size: {{ section.settings.header_title_font_size_mobile }}px;
    }
    {% endif %}
    
    {% if section.settings.header_title_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-header__title {
      font-weight: {{ section.settings.header_title_font_weight_mobile }};
    }
    {% endif %}
    
    {% if section.settings.header_description_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-header__description {
      font-size: {{ section.settings.header_description_font_size_mobile }}px;
    }
    {% endif %}
    
    {% if section.settings.header_description_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-header__description {
      font-weight: {{ section.settings.header_description_font_weight_mobile }};
    }
    {% endif %}
    
    {% if section.settings.header_text_alignment_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-header {
      text-align: {{ section.settings.header_text_alignment_mobile }};
    }
    {% endif %}
    
    {% if section.settings.card_title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-card__title {
      font-size: {{ section.settings.card_title_font_size_mobile }}px;
    }
    {% endif %}
    
    {% if section.settings.card_title_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-card__title {
      font-weight: {{ section.settings.card_title_font_weight_mobile }};
    }
    {% endif %}
    
    {% if section.settings.card_description_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-card__description {
      font-size: {{ section.settings.card_description_font_size_mobile }}px;
    }
    {% endif %}
    
    {% if section.settings.card_description_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-card__description {
      font-weight: {{ section.settings.card_description_font_weight_mobile }};
    }
    {% endif %}
    
    {% if section.settings.testimonial_quote_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-testimonial__quote {
      font-size: {{ section.settings.testimonial_quote_font_size_mobile }}px;
    }
    {% endif %}
    
    {% if section.settings.testimonial_quote_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-testimonial__quote {
      font-weight: {{ section.settings.testimonial_quote_font_weight_mobile }};
    }
    {% endif %}
    
    {% if section.settings.testimonial_author_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-testimonial__author {
      font-size: {{ section.settings.testimonial_author_font_size_mobile }}px;
    }
    {% endif %}
    
    {% if section.settings.testimonial_author_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .why-choose-testimonial__author {
      font-weight: {{ section.settings.testimonial_author_font_weight_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .why-choose-testimonial {
      text-align: var(--testimonial-text-align-mobile, var(--testimonial-text-align, center));
    }

    #shopify-section-{{ section.id }} .why-choose-card__content {
      text-align: var(--card-text-align-mobile, var(--card-text-align, left));
      margin-bottom: 1rem;
    }
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="why-choose-header">
        {%- if section.settings.title != blank -%}
          <h2 class="why-choose-header__title">
            {%- liquid
              if section.settings.highlight_word != blank
                assign title_parts = section.settings.title | split: section.settings.highlight_word
                echo title_parts[0]
                echo '<span class="highlight">'
                echo section.settings.highlight_word
                echo '</span>'
                echo title_parts[1]
              else
                echo section.settings.title
              endif
            -%}
          </h2>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <p class="why-choose-header__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="why-choose-grid">
      {%- comment -%} Left Column {%- endcomment -%}
      <div class="why-choose-column">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'left' -%}
            {%- case block.type -%}
              {%- when 'feature_card' -%}
                {%- liquid
                  assign card_id = 'why-choose-card-' | append: block.id
                -%}
                <article class="why-choose-card" {{ block.shopify_attributes }} style="--card-text-align: {{ block.settings.text_alignment }}; {% if block.settings.text_alignment_mobile != blank %}--card-text-align-mobile: {{ block.settings.text_alignment_mobile }};{% endif %}">
                  {%- if block.settings.link != blank -%}
                    <a 
                      href="{{ block.settings.link }}" 
                      class="why-choose-card__link"
                      aria-labelledby="{{ card_id }}"
                    >
                      <span class="visually-hidden">{{ block.settings.title }}</span>
                    </a>
                  {%- endif -%}

                  <div class="why-choose-card__content">
                    {%- if block.settings.title != blank -%}
                      <h3 class="why-choose-card__title" id="{{ card_id }}">
                        {{ block.settings.title }}
                      </h3>
                    {%- endif -%}
                    
                    {%- if block.settings.description != blank -%}
                      <p class="why-choose-card__description">
                        {{ block.settings.description }}
                      </p>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.image != blank -%}
                    <div class="why-choose-card__image{% if block.settings.full_height_image %} why-choose-card__image--full-height{% endif %}">
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          width: block.settings.image.width,
                          height: block.settings.image.height,
                          alt: block.settings.image.alt
                      }}
                    </div>
                  {%- else -%}
                    <div class="why-choose-card__image{% if block.settings.full_height_image %} why-choose-card__image--full-height{% endif %}"></div>
                  {%- endif -%}
                </article>

              {%- when 'testimonial' -%}
                <div class="why-choose-testimonial" {{ block.shopify_attributes }} style="--testimonial-text-align: {{ block.settings.text_alignment }}; {% if block.settings.text_alignment_mobile != blank %}--testimonial-text-align-mobile: {{ block.settings.text_alignment_mobile }};{% endif %}">
                  {%- if block.settings.quote != blank -%}
                     <h3 class="tw-mb-0">
                        <blockquote class="why-choose-testimonial__quote">
                          "{{ block.settings.quote }}"
                        </blockquote>
                      </h3>
                  {%- endif -%}
                  
                  {%- if block.settings.author != blank -%}
                    <cite class="why-choose-testimonial__author">
                      {{ block.settings.author }}
                    </cite>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Right Column {%- endcomment -%}
      <div class="why-choose-column">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'right' -%}
            {%- case block.type -%}
              {%- when 'feature_card' -%}
                {%- liquid
                  assign card_id = 'why-choose-card-' | append: block.id
                -%}
                <article class="why-choose-card" {{ block.shopify_attributes }} style="--card-text-align: {{ block.settings.text_alignment }}; {% if block.settings.text_alignment_mobile != blank %}--card-text-align-mobile: {{ block.settings.text_alignment_mobile }};{% endif %}">
                  {%- if block.settings.link != blank -%}
                    <a 
                      href="{{ block.settings.link }}" 
                      class="why-choose-card__link"
                      aria-labelledby="{{ card_id }}"
                    >
                      <span class="visually-hidden">{{ block.settings.title }}</span>
                    </a>
                  {%- endif -%}

                  <div class="why-choose-card__content">
                    {%- if block.settings.title != blank -%}
                      <h3 class="why-choose-card__title" id="{{ card_id }}">
                        {{ block.settings.title }}
                      </h3>
                    {%- endif -%}
                    
                    {%- if block.settings.description != blank -%}
                      <p class="why-choose-card__description">
                        {{ block.settings.description }}
                      </p>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.image != blank -%}
                    <div class="why-choose-card__image{% if block.settings.full_height_image %} why-choose-card__image--full-height{% endif %}">
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          width: block.settings.image.width,
                          height: block.settings.image.height,
                          alt: block.settings.image.alt
                      }}
                    </div>
                  {%- else -%}
                    <div class="why-choose-card__image{% if block.settings.full_height_image %} why-choose-card__image--full-height{% endif %}"></div>
                  {%- endif -%}
                </article>

              {%- when 'testimonial' -%}
                <div class="why-choose-testimonial" {{ block.shopify_attributes }} style="--testimonial-text-align: {{ block.settings.text_alignment }}; {% if block.settings.text_alignment_mobile != blank %}--testimonial-text-align-mobile: {{ block.settings.text_alignment_mobile }};{% endif %}">
                  {%- if block.settings.quote != blank -%}
                    <blockquote class="why-choose-testimonial__quote">
                      "{{ block.settings.quote }}"
                    </blockquote>
                  {%- endif -%}
                  
                  {%- if block.settings.author != blank -%}
                    <cite class="why-choose-testimonial__author">
                      {{ block.settings.author }}
                    </cite>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
