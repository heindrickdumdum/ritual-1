{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .main-product{
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-background-color);
  }

  #shopify-section-{{ section.id }} .main-product__container {
    display: flex;
    gap: 4rem;
    align-items: start;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .main-product__container > div {
    flex: 1 1 50%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .main-product__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    object-fit: cover;
    background-size: cover;
    overflow: hidden;
    background-color: #f0f0f0;
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .main-product__container > div:first-child {
    position: sticky;
    top: 120px;
  }

  #shopify-section-{{ section.id }} .main-product__title {
    font-size: 56px;
    font-weight: 500;
    line-height: 68px;
    letter-spacing: -0.02em;
    color: #181d27;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .main-product__label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #717680;
      margin: 0;
  }

  #shopify-section-{{ section.id }} .main-product__rating {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    color: #535862;
  }

  #shopify-section-{{ section.id }} .main-product__stars {
    color: #ffc107;
  }

  #shopify-section-{{ section.id }} .main-product__rating-value {
    font-size: 16px;
    font-weight: 700;
    line-height: 150%;
    color: #181d27;
  }

  #shopify-section-{{ section.id }} .main-product__review-count {
    font-size: 16px;
    font-weight: 500;
    line-height: 150%;
    color: #535862;
  }

  #shopify-section-{{ section.id }} .main-product__header {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .main-product__content {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .main-product__description {
    font-size: 16px;
    font-weight: 400;
    line-height: 150%;
    color: #181D27;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .main-product__details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .main-product__detail-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  #shopify-section-{{ section.id }} .main-product__detail-label {
    font-size: 16px;
    font-weight: 700;
    line-height: 150%;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .main-product__detail-value {
    font-size: 16px;
    font-weight: 500;
    line-height: 150%;
    color: #535862;
  }

  #shopify-section-{{ section.id }} .take-quiz-wrapper {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 24px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .take-quiz-button {
    background-color: #26736D;
    border-radius: 8px;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.3s ease;
    white-space: nowrap;
    flex-shrink: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .take-quiz-button:hover {
    background-color: #235957;
  }

  #shopify-section-{{ section.id }} .take-quiz-button__heading {
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .take-quiz-button__items {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .take-quiz-button__item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #181d27;
    font-size: 14px;
    line-height: 150%;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .take-quiz-button__icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .take-quiz-button__icon img {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .benefits-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .benefits-row__heading {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .benefits-row__heading-main {
    font-size: 14px;
    font-weight: 500;
    line-height: 150%;
    color: #181d27;
    letter-spacing: 2%;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .benefits-row__heading-sub {
    font-size: 12px;
    font-weight: 500;
    line-height: 135%;
    color: #535862;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .benefits-row__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .benefits-row__carousel {
    width: 100%;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    padding-bottom: 8px;
    user-select: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #shopify-section-{{ section.id }} .benefits-row__carousel::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .benefits-row__carousel:active {
    cursor: grabbing;
  }

  #shopify-section-{{ section.id }} .benefits-row__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    text-align: center;
    flex: 0 0 calc((100% - 40px) / 3.1);
    min-width: 160px;
    background-color: #EEEDE7;
    border-radius: 12px;
  }

  #shopify-section-{{ section.id }} .benefits-row__image {
    width: 100%;
    aspect-ratio: 1.5/1;
    background-color: #E3E3DE;
    border-radius: 8px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .benefits-row__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .benefits-row__title {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: #181d27;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .pricing-row {
    display: flex;
    width: 100%;
    border-top: 1px solid #E3E3DE;
    border-bottom: 1px solid #E3E3DE;
    padding: 16px 0;
  }

  #shopify-section-{{ section.id }} .pricing-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .pricing-item__label {
    font-size: 16px;
    font-weight: 700;
    line-height: 150%;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .pricing-item__price {
    font-size: 16px;
    font-weight: 500;
    line-height: 150%;
    color: #535862;
  }

  #shopify-section-{{ section.id }} .pricing-item__price-with-icon {
    display: flex;
    align-items: center;
    height: 16px;
    width: fit-content;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .accordion-row {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid #E3E3DE;
    border-bottom: 1px solid #E3E3DE;
  }

  #shopify-section-{{ section.id }} .accordion-item {
    border-bottom: 1px solid #E3E3DE;
    padding: 16px 20px;
  }

  #shopify-section-{{ section.id }} .accordion-item:last-child {
    border-bottom: none;
  }

  #shopify-section-{{ section.id }} .accordion-item__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    padding: 0;
    background: none;
    border: none;
    width: 100%;
    font-size: 16px;
    font-weight: 500;
    line-height: 150%;
    color: #181d27;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .accordion-item__header:hover {
    color: #2a7f7e;
  }

  #shopify-section-{{ section.id }} .accordion-item__toggle {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #535862;
    font-size: 18px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .accordion-item__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    font-size: 14px;
    line-height: 150%;
    margin-top: 12px;
    color: #535862;
  }

  #shopify-section-{{ section.id }} .accordion-item__content.active {
    max-height: 500px;
  }

  #shopify-section-{{ section.id }} .accordion-list {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .accordion-list__item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    flex: 0 1 calc(50% - 8px);
  }

  #shopify-section-{{ section.id }} .accordion-list__item::before {
    content: "•";
    color: #2a7f7e;
    font-weight: bold;
    margin-top: 2px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .videos-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .videos-row__heading {
    font-size: 16px;
    font-weight: 700;
    line-height: 150%;
    color: #181d27;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .videos-row__carousel {
    width: 100%;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    padding-bottom: 8px;
    user-select: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #shopify-section-{{ section.id }} .videos-row__carousel::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .videos-row__carousel:active {
    cursor: grabbing;
  }

  #shopify-section-{{ section.id }} .videos-row__item {
    position: relative;
    flex: 0 0 calc((100% - 40px) / 3.1);
    min-width: 150px;
    aspect-ratio: 1/1.5;
    background-color: #E3E3DE;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .videos-row__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .videos-row__play-button {
    position: absolute;
    width: 40px;
    height: 40px;
    background-color: #E3E3DE;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .videos-row__play-icon {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .videos-row__progress-indicator {
    width: 100%;
    height: 4px;
    background-color: #d0d0d0;
    border-radius: 2px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .videos-row__progress-bar {
    height: 100%;
    background-color: #181d27;
    border-radius: 2px;
    width: 33.33%;
    transition: left 0.1s ease-out;
    position: relative;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .main-product__container {
      flex-direction: column;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .main-product__container > div:first-child {
      position: static;
    }

    #shopify-section-{{ section.id }} .main-product__title {
      font-size: 32px;
      line-height: 40px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .main-product {
      padding-top: 40px;
      padding-bottom: 40px;
    }

    #shopify-section-{{ section.id }} .main-product__container {
      flex-direction: column;
      padding: 0;
      gap: 32px;
    }



    #shopify-section-{{ section.id }} .main-product__title {
      font-size: 32px;
      line-height: 40px;
    }

    #shopify-section-{{ section.id }} .main-product__header {
      gap: 4px;
    }

    #shopify-section-{{ section.id }} .main-product__title {
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .main-product__content {
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .main-product__details {
      gap: 24px;
    }
  }
{%- endstyle -%}
<div class="main-product section">
  <div class="main-product__container">
    <!-- Product Image -->
    <div>
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="800"
          height="800"
          class="main-product__image"
        >
      {% endif %}
    </div>

    <!-- Product Content -->
    <div class="main-product__content">
      <div class="main-product__header">
        <p class="main-product__label">Your Personalized</p>
        <h1 class="main-product__title">{{ product.title }}</h1>
        {% if product.metafields.custom.ratings %}
          <div class="main-product__rating">
            <span class="main-product__stars">★★★★★</span>
            <span class="main-product__rating-value">{{ product.metafields.custom.ratings }}/5</span>
            <span class="main-product__review-count">({{ product.metafields.custom.review_count }}+ Reviews)</span>
          </div>
        {% endif %}
      </div>

      <!-- Product Details Row -->
      <div class="main-product__details">
        {% if product.description %}
          <p class="main-product__description">{{ product.description | strip_html | truncatewords: 30 }}</p>
        {% endif %}

        {% if product.metafields.custom.size %}
          <div class="main-product__detail-row">
            <span class="main-product__detail-label">Size:</span>
            <span class="main-product__detail-value">{{ product.metafields.custom.size }}</span>
          </div>
        {% endif %}
      </div>

      <!-- Pricing Row -->
      <div class="pricing-row">
        <div class="pricing-item">
          <span class="pricing-item__label">Buy Once</span>
          <span class="pricing-item__price">{{ product.price | money }}</span>
        </div>
        <div class="pricing-item">
          <span class="pricing-item__label">Subscribe & Save 15%</span>
          <div class="pricing-item__price-with-icon">
            <span class="pricing-item__price">$41.65</span>
            <img src="{{ 'icon-question-mark-circle.svg' | asset_url }}" alt="Question mark" width="16" height="16">
          </div>
        </div>
      </div>

      <!-- Take Quiz Row -->
      <div class="take-quiz-wrapper">
        <div class="take-quiz-button">
          <h3 class="take-quiz-button__heading">Take the Quiz</h3>
        </div>
        <div class="take-quiz-button__items">
          <div class="take-quiz-button__item">
            <div class="take-quiz-button__icon">
              <img src="{{ 'icon-star.svg' | asset_url }}" alt="Money back" width="18" height="18">
            </div>
            <span>60-day money-back</span>
          </div>
          <div class="take-quiz-button__item">
            <div class="take-quiz-button__icon">
              <img src="{{ 'icon-truck.svg' | asset_url }}" alt="Free shipping" width="18" height="18">
            </div>
            <span>Free shipping & returns</span>
          </div>
        </div>
      </div>

      <!-- Benefits Row -->
      <div class="benefits-row">
        <div class="benefits-row__heading">
          <span class="benefits-row__heading-main">Benefits</span>
          <span class="benefits-row__heading-sub">(Result 6-12 months)</span>
        </div>

        <div class="benefits-row__wrapper">
          <div class="benefits-row__carousel" id="benefits-carousel-{{ section.id }}">
            {% if product.metafields.custom.benefits %}
              {% for benefit in product.metafields.custom.benefits.value %}
                <div class="benefits-row__item">
                  {% if benefit.image %}
                    <div class="benefits-row__image">
                      <img
                        src="{{ benefit.image | image_url: width: 300 }}"
                        alt="{{ benefit.title | escape }}"
                        width="{{ benefit.image.width }}"
                        height="{{ benefit.image.height }}"
                      >
                    </div>
                  {% else %}
                    <div class="benefits-row__image"></div>
                  {% endif %}
                  <h3 class="benefits-row__title">{{ benefit.title }}</h3>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Accordion Row -->
      <div class="accordion-row">
        <div class="accordion-item">
          <div class="accordion-item__header" data-accordion="accordion-1">
            <span>Key ingredients</span>
            <span class="accordion-item__toggle">+</span>
          </div>
          <div class="accordion-item__content" id="accordion-1">
            <div class="accordion-list">
              {% for ingredient in product.metafields.custom.key_ingredients.value %}
                <div class="accordion-list__item">{{ ingredient }}</div>
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="accordion-item">
          <div class="accordion-item__header" data-accordion="accordion-2">
            <span>How to use?</span>
            <span class="accordion-item__toggle">+</span>
          </div>
          <div class="accordion-item__content" id="accordion-2">
            {{ product.metafields.custom.how_to_use }}
          </div>
        </div>

        <div class="accordion-item">
          <div class="accordion-item__header" data-accordion="accordion-3">
            <span>Clinical study</span>
            <span class="accordion-item__toggle">+</span>
          </div>
          <div class="accordion-item__content" id="accordion-3">
            {{ product.metafields.custom.clinical_study }}
          </div>
        </div>
      </div>

      <!-- Videos Row -->
      <div class="videos-row">
        <p class="videos-row__heading">Loved by over 100,000 satisfied customers.</p>
        <div class="videos-row__carousel" id="videos-carousel-{{ section.id }}">
          <div class="videos-row__item">
            <div class="videos-row__play-button">
              <img
                src="{{ 'icon-play-2.svg' | asset_url }}"
                alt="Play"
                class="videos-row__play-icon"
                width="16"
                height="16"
              >
            </div>
          </div>
          <div class="videos-row__item">
            <div class="videos-row__play-button">
              <img
                src="{{ 'icon-play-2.svg' | asset_url }}"
                alt="Play"
                class="videos-row__play-icon"
                width="16"
                height="16"
              >
            </div>
          </div>
          <div class="videos-row__item">
            <div class="videos-row__play-button">
              <img
                src="{{ 'icon-play-2.svg' | asset_url }}"
                alt="Play"
                class="videos-row__play-icon"
                width="16"
                height="16"
              >
            </div>
          </div>
          <div class="videos-row__item">
            <div class="videos-row__play-button">
              <img
                src="{{ 'icon-play-2.svg' | asset_url }}"
                alt="Play"
                class="videos-row__play-icon"
                width="16"
                height="16"
              >
            </div>
          </div>
        </div>
        <div class="videos-row__progress-indicator">
          <div class="videos-row__progress-bar" id="videos-progress-{{ section.id }}"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  setTimeout(function () {
    const carousel = document.getElementById('benefits-carousel-{{ section.id }}');
    if (!carousel) return;

    // Mouse drag support for desktop
    let isDown = false;
    let startX;
    let scrollLeft;

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - carousel.offsetLeft;
      scrollLeft = carousel.scrollLeft;
    });

    carousel.addEventListener('mouseleave', () => {
      isDown = false;
    });

    carousel.addEventListener('mouseup', () => {
      isDown = false;
    });

    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5;
      carousel.scrollLeft = scrollLeft - walk;
    });
  }, 100);

  // Videos carousel drag support
  setTimeout(function () {
    const videosCarousel = document.getElementById('videos-carousel-{{ section.id }}');
    const progressBar = document.getElementById('videos-progress-{{ section.id }}');
    if (!videosCarousel) return;

    let isDown = false;
    let startX;
    let scrollLeft;

    // Update progress bar (scrollbar style)
    const updateProgressBar = () => {
      if (!progressBar) return;
      const scrollableWidth = videosCarousel.scrollWidth - videosCarousel.clientWidth;
      const thumbWidth = (videosCarousel.clientWidth / videosCarousel.scrollWidth) * 100;
      const thumbPosition = (videosCarousel.scrollLeft / videosCarousel.scrollWidth) * 100;
      progressBar.style.width = thumbWidth + '%';
      progressBar.style.left = thumbPosition + '%';
    };

    // Initial progress bar update
    updateProgressBar();

    videosCarousel.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - videosCarousel.offsetLeft;
      scrollLeft = videosCarousel.scrollLeft;
    });

    videosCarousel.addEventListener('mouseleave', () => {
      isDown = false;
    });

    videosCarousel.addEventListener('mouseup', () => {
      isDown = false;
    });

    videosCarousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - videosCarousel.offsetLeft;
      const walk = (x - startX) * 1.5;
      videosCarousel.scrollLeft = scrollLeft - walk;
      updateProgressBar();
    });

    // Update progress on scroll (for touch and scrollbar)
    videosCarousel.addEventListener('scroll', () => {
      updateProgressBar();
    });
  }, 100);

  // Accordion functionality
  const accordionHeaders = document.querySelectorAll('.accordion-item__header');
  accordionHeaders.forEach((header) => {
    header.addEventListener('click', () => {
      const contentId = header.getAttribute('data-accordion');
      const content = document.getElementById(contentId);
      const toggle = header.querySelector('.accordion-item__toggle');

      // Close all other accordion items
      accordionHeaders.forEach((otherHeader) => {
        if (otherHeader !== header) {
          const otherId = otherHeader.getAttribute('data-accordion');
          const otherContent = document.getElementById(otherId);
          const otherToggle = otherHeader.querySelector('.accordion-item__toggle');
          otherContent.classList.remove('active');
          otherToggle.textContent = '+';
        }
      });

      // Toggle current item
      content.classList.toggle('active');
      toggle.textContent = content.classList.contains('active') ? '−' : '+';
    });
  });
</script>

