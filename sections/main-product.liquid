{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .main-product {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-background-color);
  }

  #shopify-section-{{ section.id }} .main-product__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .main-product__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    background-color: #f0f0f0;
  }

  #shopify-section-{{ section.id }} .main-product__title {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    color: #181d27;
    margin: 0;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .main-product__container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    #shopify-section-{{ section.id }} .main-product__title {
      font-size: 2rem;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .main-product {
      padding-top: 40px;
      padding-bottom: 40px;
    }

    #shopify-section-{{ section.id }} .main-product__container {
      padding: 0 16px;
      gap: 1.5rem;
    }

    #shopify-section-{{ section.id }} .main-product__title {
      font-size: 1.5rem;
    }
  }
{%- endstyle -%}
<div class="main-product">
  <div class="main-product__container">
    <!-- Product Image -->
    <div>
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="800"
          height="800"
          class="main-product__image"
        >
      {% endif %}
    </div>

    <!-- Product Title -->
    <div>
      <h1 class="main-product__title">{{ product.title }}</h1>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": [
    {
      "type": "number",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "default": 80
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Main Product",
      "category": "Products"
    }
  ]
}
{% endschema %}
