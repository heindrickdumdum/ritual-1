{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg-color: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-bg-color);
  }

  #shopify-section-{{ section.id }} .benefits-carousel-wrapper {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-bg-color);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .benefits-carousel-main {
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .benefits-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .benefits-header__title {
    max-width: 600px;
    font-size: 44px;
    font-weight: 500;
    line-height: 136%;
    letter-spacing: -0.02em;
    color: #181d27;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .benefits-header__cta {
    background-color: #26736D;
    color: white;
    padding: 16px 32px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    transition: opacity 0.3s linear;
    text-decoration: none;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .benefits-header__cta:hover {
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .benefits-carousel-container {

    position: relative;
  }

  #shopify-section-{{ section.id }} .benefits-carousel-track {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .benefits-carousel-track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .benefit-card {
    min-height: 380px;
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - 64px) / 3);
    min-width: 0;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .benefit-card__image-wrapper {
    position: relative;
  }

  #shopify-section-{{ section.id }} .benefit-card__image {
    width: 100%;
    aspect-ratio: 7/8;
    background-color: #E3E3DE;
    border-radius: 12px;
    display: block;
  }

  #shopify-section-{{ section.id }} .benefit-card__image-gallery {
    width: 60%;
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .benefit-card__image-thumbnail {
    flex: 1;
    aspect-ratio: 7/8;
    height: auto;
    border-radius: 8px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .benefit-card__image-thumbnail:nth-child(1) {
    background-color: #E3E3DE;
  }

  #shopify-section-{{ section.id }} .benefit-card__image-thumbnail:nth-child(2) {
    background-color: rgb(150, 180, 200);
  }

  #shopify-section-{{ section.id }} .benefit-card__image-thumbnail:nth-child(3) {
    background-color: rgb(180, 150, 200);
  }

  #shopify-section-{{ section.id }} .benefit-card__image-thumbnail:hover {
    border-color: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .benefit-card__image-thumbnail.active {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 0 3px rgba({{ section.settings.accent_color }}, 0.1);
  }

  #shopify-section-{{ section.id }} .benefit-card__duration {
    width: fit-content;
    background-color: #FFFFFF;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 14px;
    line-height: 150%;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: {{ section.settings.accent_color }};
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .benefit-card__title {
    font-size: 24px;
    font-weight: 700;
    color: #181d27;
    line-height: 140%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .benefit-card__benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .benefit-card__benefit {
    font-size: 18px;
    color: #535862;
    padding-left: 1.5rem;
    position: relative;
    line-height: 145%;
  }

  #shopify-section-{{ section.id }} .benefit-card__benefit::before {
    content: "•";
    position: absolute;
    left: 0;
    color: {{ section.settings.accent_color }};
    font-weight: bold;
  }

  #shopify-section-{{ section.id }} .carousel-controls {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .carousel-progress-bar {
    flex: 1;
    height: 3px;
    background-color: #E9EAEB;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .carousel-progress-bar__fill {
    height: 100%;
    background-color: #181D27;
    border-radius: 2px;
    transition: left 0.3s ease;
    position: absolute;
    top: 0;
    width: 20%;
  }

  #shopify-section-{{ section.id }} .carousel-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: white;
    border: 1px solid #e0e0e0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 1.25rem;
  }

  #shopify-section-{{ section.id }} .carousel-btn:hover:not(:disabled) {
    background-color: {{ section.settings.accent_color }};
    color: white;
    border-color: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .carousel-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .featured-product {
    background: #f8f8f7;
    padding: 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} h2.featured-product__title  {
    font-size: 44px;
    font-weight: 500;
    color: #181d27;
    margin: 0;
  }

  #shopify-section-{{ section.id }} p.featured-product__description {
    font-size: 20px;
    color: #535862;
    line-height: 140%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .featured-product p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .trust-badges {
    margin-top: 100px;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: #FFFFFF;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .trust-badges__container {
    display: flex;
    gap: 40px;
    white-space: nowrap;
    animation: scroll-badges 45s linear infinite;
    padding: 24px 40px;
  }

  #shopify-section-{{ section.id }} .trust-badge {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  @keyframes scroll-badges {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  #shopify-section-{{ section.id }} .trust-badge__icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 500;
    line-height: 145%;
  }

  #shopify-section-{{ section.id }} .trust-badge__text {
    font-size: 0.875rem;
    color: #181D27;
    font-weight: 500;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .benefits-carousel-wrapper {
      padding-top: 0;
      padding-bottom: 0;
      row-gap: 40px;
    }

    #shopify-section-{{ section.id }} .benefits-carousel-main {
      gap: 40px;
      margin: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .benefits-carousel-track {
      gap: 4px;
    }

    #shopify-section-{{ section.id }} .trust-badges__container {
      gap: 24px;
      padding: 12px 16px;
    }

    #shopify-section-{{ section.id }} .benefits-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .benefits-header__title {
      font-size: 24px;
      font-weight: 700;
      line-height: 32px;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .benefits-header__cta {
      text-align: center;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .benefit-card {
      min-height: auto;
      flex: 0 0 calc((100% - 4px) / 1.1);
    }

    #shopify-section-{{ section.id }} .benefit-card__duration {
      padding: 4px 8px;
    }

    #shopify-section-{{ section.id }} .benefit-card__title {
      font-size: 20px;
      line-height: 28px;
    }

    #shopify-section-{{ section.id }} .benefit-card__benefit {
      font-size: 16px;
      line-height: 24px;
      font-weight: 500;
      padding-left: 16px;
    }

    #shopify-section-{{ section.id }} .featured-product {
      padding: 0;
    }

    #shopify-section-{{ section.id }} h2.featured-product__title {
      font-size: 24px;
      font-weight: 700;
      line-height: 32px;
    }

    #shopify-section-{{ section.id }} .featured-product p {
      font-size: 16px;
      font-weight: 500;
      line-height: 24px;
      margin: 0;
      color: #535862;
    }

    #shopify-section-{{ section.id }} .trust-badges {
      margin-top: 0;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }
{%- endstyle -%}

<div class="benefits-carousel-wrapper section">
  <div class="benefits-carousel-main">
    {%- if section.settings.title -%}
      <div class="benefits-header">
        <h2 class="benefits-header__title">{{ section.settings.title }}</h2>
        {%- if section.settings.button_text -%}
          <a href="{{ section.settings.button_link }}" class="benefits-header__cta">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="benefits-carousel-container">
      <div class="benefits-carousel-track" id="carousel-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="benefit-card">
              <div class="benefit-card__image-wrapper">
                <div
                  class="benefit-card__image"
                  {%- if block.settings.image_1 != blank %}
                    style="background-image: url('{{ block.settings.image_1 | image_url: width: 500 }}'); background-size: cover;"
                  {%- else %}
                    style="background-color: #E3E3DE;"
                  {%- endif %}
                ></div>
                <div class="benefit-card__image-gallery">
                  <div
                    class="benefit-card__image-thumbnail active"
                    alt="Image 1"
                    data-image-index="0"
                    {%- if block.settings.image_1 != blank %}
                      data-image-src="{{ block.settings.image_1 | image_url: width: 500 }}"
                      style="background-image: url('{{ block.settings.image_1 | image_url: width: 100 }}'); background-size: cover;"
                    {%- endif %}
                  ></div>
                  <div
                    class="benefit-card__image-thumbnail"
                    alt="Image 2"
                    data-image-index="1"
                    {%- if block.settings.image_2 != blank %}
                      data-image-src="{{ block.settings.image_2 | image_url: width: 500 }}"
                      style="background-image: url('{{ block.settings.image_2 | image_url: width: 100 }}'); background-size: cover;"
                    {%- endif %}
                  ></div>
                  <div
                    class="benefit-card__image-thumbnail"
                    alt="Image 3"
                    data-image-index="2"
                    {%- if block.settings.image_3 != blank %}
                      data-image-src="{{ block.settings.image_3 | image_url: width: 500 }}"
                      style="background-image: url('{{ block.settings.image_3 | image_url: width: 100 }}'); background-size: cover;"
                    {%- endif %}
                  ></div>
                </div>
              </div>
              <div class="benefit-card__duration">{{ block.settings.duration }}</div>
              <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
              <ul class="benefit-card__benefits">
                {%- for i in (1..3) -%}
                  {%- assign benefit_key = 'benefit_' | append: i -%}
                  {%- if block.settings[benefit_key] != blank -%}
                    <li class="benefit-card__benefit">{{ block.settings[benefit_key] }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="carousel-controls">
        <button class="carousel-btn" id="prev-btn-{{ section.id }}" aria-label="Previous slide">❮</button>
        <div class="carousel-progress-bar">
          <div class="carousel-progress-bar__fill" id="progress-bar-{{ section.id }}"></div>
        </div>
        <button class="carousel-btn" id="next-btn-{{ section.id }}" aria-label="Next slide">❯</button>
      </div>
    </div>

    <div class="featured-product">
      <h2 class="featured-product__title">{{ product.title }}</h2>
      <p class="featured-product__description">{{ product.description }}</p>
    </div>
  </div>

  {%- if section.settings.show_trust_badges -%}
    <div class="trust-badges">
      <div class="trust-badges__container" id="trust-badges-{{ section.id }}">
        {%- if section.settings.badge_1_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-organic-food.svg' | asset_url }}" alt="Organic Food" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_1_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_2_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-save-money-dollar.svg' | asset_url }}" alt="Save Money" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_2_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_3_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-swiss.svg' | asset_url }}" alt="Swiss" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_3_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_4_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-organic-food.svg' | asset_url }}" alt="Organic Food" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_4_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_5_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-security-check.svg' | asset_url }}" alt="Security Check" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_5_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_6_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-atom.svg' | asset_url }}" alt="Proven Results" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_6_text }}</div>
          </div>
        {%- endif -%}
        <!-- Duplicate items for seamless loop -->
        {%- if section.settings.badge_1_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-organic-food.svg' | asset_url }}" alt="Organic Food" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_1_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_2_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-save-money-dollar.svg' | asset_url }}" alt="Save Money" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_2_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_3_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-swiss.svg' | asset_url }}" alt="Swiss" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_3_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_4_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-organic-food.svg' | asset_url }}" alt="Organic Food" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_4_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_5_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-security-check.svg' | asset_url }}" alt="Security Check" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_5_text }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.badge_6_text != blank -%}
          <div class="trust-badge">
            <div class="trust-badge__icon">
              <img src="{{ 'icon-atom.svg' | asset_url }}" alt="Proven Results" width="28" height="28">
            </div>
            <div class="trust-badge__text">{{ section.settings.badge_6_text }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.getElementById('carousel-track-{{ section.id }}');
    const prevBtn = document.getElementById('prev-btn-{{ section.id }}');
    const nextBtn = document.getElementById('next-btn-{{ section.id }}');
    const progressBar = document.getElementById('progress-bar-{{ section.id }}');

    if (!track || !prevBtn || !nextBtn) return;

    const gap = window.innerWidth <= 768 ? 4 : 32;
    let scrollPosition = 0;

    function getScrollDistance() {
      let visibleCards = 3;
      if (window.innerWidth <= 768) {
        visibleCards = 1.1;
      }
      const availableWidth = track.clientWidth;
      const totalGapWidth = gap * (visibleCards - 1);
      const cardWidth = (availableWidth - totalGapWidth) / visibleCards;
      return cardWidth + gap;
    }
    7;
    function updateButtons() {
      const maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = scrollPosition <= 0;
      nextBtn.disabled = scrollPosition >= maxScroll - 1;

      // Update progress bar to act like a scrollbar
      if (progressBar) {
        const visibleWidth = track.clientWidth;
        const totalWidth = track.scrollWidth;

        // Scrollbar thumb width = percentage of content visible
        const thumbWidth = (visibleWidth / totalWidth) * 100;

        // Scrollbar thumb position = scroll position mapped to available space
        const maxThumbPosition = 100 - thumbWidth;
        const thumbPosition = (scrollPosition / maxScroll) * maxThumbPosition;

        progressBar.style.width = thumbWidth + '%';
        progressBar.style.left = thumbPosition + '%';
      }
    }

    prevBtn.addEventListener('click', () => {
      const distance = getScrollDistance();
      scrollPosition = Math.max(0, scrollPosition - distance);
      track.scrollLeft = scrollPosition;
      updateButtons();
    });

    nextBtn.addEventListener('click', () => {
      const distance = getScrollDistance();
      const maxScroll = track.scrollWidth - track.clientWidth;
      scrollPosition = Math.min(maxScroll, scrollPosition + distance);
      track.scrollLeft = scrollPosition;
      updateButtons();
    });

    // Update on scroll as well
    track.addEventListener('scroll', () => {
      scrollPosition = track.scrollLeft;
      updateButtons();
    });

    // Image gallery thumbnail switching
    const thumbnails = document.querySelectorAll('#shopify-section-{{ section.id }} .benefit-card__image-thumbnail');
    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => {
        const cardWrapper = thumbnail.closest('.benefit-card__image-wrapper');
        const mainImage = cardWrapper.querySelector('.benefit-card__image');
        const galleryWrapper = thumbnail.closest('.benefit-card__image-gallery');

        // Get the computed styles from the thumbnail
        const computedStyle = window.getComputedStyle(thumbnail);
        const bgImage = computedStyle.backgroundImage;
        const bgColor = computedStyle.backgroundColor;

        // Apply to main image
        if (bgImage && bgImage !== 'none') {
          mainImage.style.backgroundImage = bgImage;
          mainImage.style.backgroundSize = 'cover';
        } else {
          mainImage.style.backgroundImage = 'none';
          mainImage.style.backgroundColor = bgColor;
        }

        // Update active state
        const allThumbnails = galleryWrapper.querySelectorAll('.benefit-card__image-thumbnail');
        allThumbnails.forEach((thumb) => thumb.classList.remove('active'));
        thumbnail.classList.add('active');
      });
    });

    updateButtons();
  });
</script>

{% schema %}
{
  "name": "Product Benefits Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Complete Probiotic That Delivers Results in Just 7 Days."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "See Clinical Evidence"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2c8a7e"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
