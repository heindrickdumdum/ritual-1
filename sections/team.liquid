{%- style -%}
  #shopify-section-{{ section.id }} {
    --text-color: {{ section.settings.text_color }};
    --card-background: {{ section.settings.card_background }};
    --orbit-color: {{ section.settings.orbit_color }};
    --orbit-color--outer: #D5D7DA;
    --padding-top: {{ section.settings.padding-block-start }}px;
    --padding-bottom: {{ section.settings.padding-block-end }}px;
    --padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --padding-top: var(--padding-top-mobile);
      --padding-bottom: var(--padding-bottom-mobile);
    }
  }
{%- endstyle -%}

<div class="team-section section section--page-width color-{{ section.settings.color_scheme }}" style="padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);">
  <div class="container">
    <div class="team-section__wrapper">
      {%- comment -%} Left Content {%- endcomment -%}
      <div class="team-section__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="team-section__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="team-section__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Team Orbit {%- endcomment -%}
      <div class="team-section__orbit">
        {%- comment -%} Center Logo {%- endcomment -%}
        <div class="team-section__center">
          {%- if section.settings.center_logo != blank -%}
            <img src="{{ section.settings.center_logo | image_url: width: 200 }}" alt="{{ section.settings.center_logo_alt }}" loading="lazy">
          {%- else -%}
            <div class="team-section__center-placeholder">
              <span>rituall</span>
            </div>
          {%- endif -%}
        </div>
        {%- comment -%} Orbit Rings {%- endcomment -%}
        <div class="team-section__orbit-ring team-section__orbit-ring--1"></div>
        <div class="team-section__orbit-ring team-section__orbit-ring--2"></div>
        <div class="team-section__orbit-ring team-section__orbit-ring--3"></div>
        {%- comment -%} Team Members {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'team_member' -%}
              <div class="team-section__member" style="top: {{ block.settings.position_y }}%; left: {{ block.settings.position_x }}%;" {{ block.shopify_attributes }}>
                <div class="team-section__member-card">
                  {%- if block.settings.avatar != blank -%}
                    <img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.name }}" class="team-section__avatar" loading="lazy">
                  {%- else -%}
                    <div class="team-section__avatar team-section__avatar--placeholder"></div>
                  {%- endif -%}


                  <div class="tw-flex tw-items-center tw-justify-between">
                    <div>
                      {%- if block.settings.name != blank -%}
                        <h3 class="team-section__name">{{ block.settings.name }}</h3>
                      {%- endif -%}
                      {%- if block.settings.role != blank -%}
                        <p class="team-section__role">{{ block.settings.role }}</p>
                      {%- endif -%}
                    </div>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.16663 2.5L10.6009 6.93432C10.9134 7.24673 10.9134 7.75327 10.6009 8.06569L6.16663 12.5" stroke="#26736D" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                </div>
                
                {%- comment -%} Team Member Popup {%- endcomment -%}
                <div class="team-section__modal-trigger" data-team-member="{{ block.settings.popup_title }}"></div>

                {%- comment -%} Modal Overlay {%- endcomment -%}
                <div class="team-section__modal-overlay" data-modal="{{ block.settings.popup_title }}"></div>

                {%- comment -%} Modal {%- endcomment -%}
                <div class="team-section__modal" data-modal="{{ block.settings.popup_title }}">
                  <div class="team-section__modal-content-inner">
                    {%- comment -%} Close Button {%- endcomment -%}
                    <button class="team-section__modal-close" aria-label="Close" data-close="{{ block.settings.popup_title }}">
                      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22.5 22.5L15 15M15 15L7.5 7.5M15 15L22.5 7.5M15 15L7.5 22.5" stroke="#181D27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>

                    {%- comment -%} Profile Image {%- endcomment -%}
                    {%- if block.settings.avatar != blank -%}
                      <div class="team-section__modal-image--wrapper">
                        <img src="{{ block.settings.avatar | image_url: width: 300 }}" alt="{{ block.settings.name }}" class="team-section__modal-image" loading="lazy">
                      </div>
                    {%- endif -%}
                    
                    <div class="team-section__modal-content">
                        {%- comment -%} Name {%- endcomment -%}
                      <div class="tw-flex tw-flex-col tw-gap-8">
                        <div>
                          {%- if block.settings.popup_title != blank -%}
                            <h2 class="team-section__modal-title">{{ block.settings.popup_title }}</h2>
                          {%- endif -%}
                          
                          {%- comment -%} Title/Role {%- endcomment -%}
                          {%- if block.settings.popup_role != blank -%}
                            <p class="team-section__modal-role">{{ block.settings.popup_role }}</p>
                          {%- endif -%}
                        </div>
                        
                        <div class="team-section__modal-body">
                          {%- comment -%} Bio {%- endcomment -%}
                          {%- if block.settings.popup_bio != blank -%}
                            <div class="team-section__modal-section">
                              <h3 class="team-section__modal-section-title">About {{ block.settings.popup_title }}</h3>
                              <p>{{ block.settings.popup_bio }}</p>
                            </div>
                          {%- endif -%}
                          
                          {%- comment -%} Areas of Expertise {%- endcomment -%}
                          {%- if block.settings.areas_of_expertise != blank -%}
                            <div class="team-section__modal-section">
                              <h3 class="team-section__modal-section-title">Areas of Expertise</h3>
                              {{ block.settings.areas_of_expertise }}
                            </div>
                          {%- endif -%}
                          
                          {%- comment -%} Philosophy {%- endcomment -%}
                          {%- if block.settings.philosophy != blank -%}
                            <div class="team-section__modal-section">
                              <h3 class="team-section__modal-section-title">Philosophy</h3>
                              {{ block.settings.philosophy }}
                            </div>
                          {%- endif -%}
                        </div>

                        <div class="team-section__modal-footer">
                          {%- if block.settings.cta_link != blank -%}
                            <a href="{{ block.settings.cta_link }}" class="team-section__modal-cta">{{ block.settings.cta_text }}</a>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                    
                   
                  </div>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .team-section__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .team-section__heading {
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 1.5rem 0;
  }

  {% if section.settings.heading_font_size != blank %}
  #shopify-section-{{ section.id }} .team-section__heading {
    font-size: {{ section.settings.heading_font_size }}px;
  }
  {% endif %}

  {% if section.settings.heading_font_weight != blank %}
  #shopify-section-{{ section.id }} .team-section__heading {
    font-weight: {{ section.settings.heading_font_weight }};
  }
  {% endif %}

  {% if section.settings.heading_line_height != blank %}
  #shopify-section-{{ section.id }} .team-section__heading {
    line-height: {{ section.settings.heading_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .team-section__description {
    font-size: 1.25rem;
    line-height: 1.6;
    color: #535862;
  }

  {% if section.settings.description_font_size != blank %}
  #shopify-section-{{ section.id }} .team-section__description {
    font-size: {{ section.settings.description_font_size }}px;
  }
  {% endif %}

  {% if section.settings.description_font_weight != blank %}
  #shopify-section-{{ section.id }} .team-section__description {
    font-weight: {{ section.settings.description_font_weight }};
  }
  {% endif %}

  {% if section.settings.description_line_height != blank %}
  #shopify-section-{{ section.id }} .team-section__description {
    line-height: {{ section.settings.description_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .team-section__orbit {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .team-section__center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: var(--card-background, #fff);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
    border: 12px solid var(--orbit-color, #BCD9D6);
  }

  #shopify-section-{{ section.id }} .team-section__center img {
    max-width: 70%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .team-section__center-placeholder {
    font-size: 1.5rem;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .team-section__orbit-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px dashed var(--orbit-color--outer, #BCD9D6);
    opacity: 0.4;
  }

  #shopify-section-{{ section.id }} .team-section__orbit-ring--1 {
    width: 70%;
    height: 70%;
  }

  #shopify-section-{{ section.id }} .team-section__orbit-ring--2 {
    width: 90%;
    height: 90%;
  }

  #shopify-section-{{ section.id }} .team-section__orbit-ring--3 {
    width: 50%;
    height: 50%;
  }

  #shopify-section-{{ section.id }} .team-section__member {
    position: absolute;
    {% comment %} z-index: 3; {% endcomment %}
  }

  #shopify-section-{{ section.id }} .team-section__member-card {
    background: #F7F7F4;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0px 12px 16px -4px rgba(10, 13, 18, 0.08), 0px 4px 6px -2px rgba(10, 13, 18, 0.03), 0px 2px 2px -1px rgba(10, 13, 18, 0.04);
    width: 100%;
    max-width: 146px;
    cursor: pointer;
  }

  {%- comment -%} Team Member Drawer Styles {%- endcomment -%}
  #shopify-section-{{ section.id }} .team-section__modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 99;
  }

  #shopify-section-{{ section.id }} .team-section__modal-overlay--active {
    opacity: 1;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .team-section__modal {
    position: fixed;
    right: 0;
    top: 0;
    height: 100vh;
    width: 440px;
    max-width: 100%;
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
    /* transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); */
    transition: all 0.4s linear;
    background: #FFFFFF;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
    z-index: 100;
    overflow: hidden;
    display: flex;
    flex-direction: column;

        overflow: auto;
  }

  #shopify-section-{{ section.id }} .team-section__modal--active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  #shopify-section-{{ section.id }} .team-section__modal-content {
    {% comment %} padding: 2.5rem 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto; {% endcomment %}
    padding: 32px 20px 40px;
    overflow-y: auto;
    height: auto;
    /*max-height: calc(100vh - 239px);*/
  }

  #shopify-section-{{ section.id }} .team-section__modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    background: #f5f5f5;
    cursor: pointer;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
    border-radius: 8px;
    padding: 9px;
    outline: none;
  }

  #shopify-section-{{ section.id }} .team-section__modal-close:hover {
    background-color: #e5e5e5;
  }

  #shopify-section-{{ section.id }} .team-section__modal-image--wrapper {
    width: 100%;
    height: auto;
    border-radius: 0;
    background: #e5e5e5;
    height: 239px;
    overflow: hidden;

  }
    #shopify-section-{{ section.id }} .team-section__modal-image {
      object-fit: cover;
    display: block;

    
    }

  #shopify-section-{{ section.id }} .team-section__modal-title {
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
    line-height: 28px;
    /* Gray/900 */
    color: #181D27;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .team-section__modal-role {
    font-size: 1rem;
    line-height: 1.5;
    color: #535862;
    font-weight: 500;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-section__modal-body {
    flex: 1;
    overflow-y: auto;
  }

  #shopify-section-{{ section.id }} .team-section__modal-cta {
    display: block;
    width: 100%;
    padding: 1rem 1.5rem;
    background-color: #26736D;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-align: center;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .team-section__modal-cta:hover {
    background-color: #1f5952;
  }

  #shopify-section-{{ section.id }} .team-section__modal-section {
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .team-section__modal-section:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .team-section__modal-section-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 12px 0;
    line-height: 24px;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .team-section__modal-section p {
    font-size: 16px;
    line-height: 150%;
    margin: 0 0 0.75rem 0;
    color: #535862;
    font-weight: 450;
  }

  #shopify-section-{{ section.id }} .team-section__modal-section p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .team-section__modal-philosophy {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
    color: #535862;
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .team-section__modal-list {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-section__modal-list li {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #535862;
    margin-bottom: 0.5rem;
  }

  #shopify-section-{{ section.id }} .team-section__modal-list li:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .team-section__avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 0.75rem;
    background: #e5e5e5;
  }

  #shopify-section-{{ section.id }} .team-section__avatar--placeholder {
    background: #e5e5e5;
  }

  #shopify-section-{{ section.id }} .team-section__name {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.5;
  }

  {% if section.settings.member_name_font_size != blank %}
  #shopify-section-{{ section.id }} .team-section__name {
    font-size: {{ section.settings.member_name_font_size }}px;
  }
  {% endif %}

  {% if section.settings.member_name_font_weight != blank %}
  #shopify-section-{{ section.id }} .team-section__name {
    font-weight: {{ section.settings.member_name_font_weight }};
  }
  {% endif %}

  {% if section.settings.member_name_line_height != blank %}
  #shopify-section-{{ section.id }} .team-section__name {
    line-height: {{ section.settings.member_name_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .team-section__role {
    font-size: 0.75rem;
    margin: 0;
    line-height: 135%;
  }

  {% if section.settings.member_role_font_size != blank %}
  #shopify-section-{{ section.id }} .team-section__role {
    font-size: {{ section.settings.member_role_font_size }}px;
  }
  {% endif %}

  {% if section.settings.member_role_font_weight != blank %}
  #shopify-section-{{ section.id }} .team-section__role {
    font-weight: {{ section.settings.member_role_font_weight }};
  }
  {% endif %}

  {% if section.settings.member_role_line_height != blank %}
  #shopify-section-{{ section.id }} .team-section__role {
    line-height: {{ section.settings.member_role_line_height }};
  }
  {% endif %}

  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .team-section__wrapper {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    #shopify-section-{{ section.id }} .team-section__heading {
      font-size: 2rem;
    }

    #shopify-section-{{ section.id }} .team-section__orbit {
      max-width: 500px;
    }

    #shopify-section-{{ section.id }} .team-section__center {
      width: 150px;
      height: 150px;
      border-width: 7.5px;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .team-section__heading {
      font-size: 1.75rem;
      margin-bottom: 0.75rem;
    }
    #shopify-section-{{ section.id }} .team-section__wrapper {
      gap: 2.5rem;
    }

    {% if section.settings.heading_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.heading_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__heading {
      font-weight: {{ section.settings.heading_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.heading_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__heading {
      line-height: {{ section.settings.heading_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .team-section__orbit {
      max-width: 400px;
    }

    #shopify-section-{{ section.id }} .team-section__center {
      width: 120px;
      height: 120px;
    }

    #shopify-section-{{ section.id }} .team-section__member-card {
      padding: 0.75rem;
