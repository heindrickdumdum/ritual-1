    {% if section.settings.member_name_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__name {
      font-size: {{ section.settings.member_name_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.member_name_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__name {
      font-weight: {{ section.settings.member_name_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.member_name_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__name {
      line-height: {{ section.settings.member_name_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .team-section__role {
      font-size: 0.8rem;
    }

    {% if section.settings.member_role_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__role {
      font-size: {{ section.settings.member_role_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.member_role_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__role {
      font-weight: {{ section.settings.member_role_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.member_role_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__role {
      line-height: {{ section.settings.member_role_line_height_mobile }};
    }
    {% endif %}

    {% if section.settings.description_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__description {
      font-size: {{ section.settings.description_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.description_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__description {
      font-weight: {{ section.settings.description_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.description_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .team-section__description {
      line-height: {{ section.settings.description_line_height_mobile }};
    }
    {% endif %}

    /* Drawer responsive styles */
    #shopify-section-{{ section.id }} .team-section__modal {
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      transform: translateY(100%);
      width: 100%;
      height: auto;

            height: calc(100vh - 60px);
    }

    #shopify-section-{{ section.id }} .team-section__modal--active {
      transform: translateY(0);
    }
  }
</style>

<script src="{{ 'team-member-popup.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Team Section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
