{{ 'overflow-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
    --heading-font-size: {{ section.settings.heading_font_size }}px;
    --heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --card-title-font-size: {{ section.settings.card_title_font_size }}px;
    --card-title-font-size-mobile: {{ section.settings.card_title_font_size_mobile }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .ingredients-header {
    margin-bottom: 5rem;
  }

  #shopify-section-{{ section.id }} .ingredients-header__title {
    font-weight: 400;
    font-size: var(--heading-font-size);
    margin: 0 0 1.5rem 0;
    color: rgb(var(--color-foreground));
    text-align: left;
  }

  {% if section.settings.heading_font_weight != blank %}
  #shopify-section-{{ section.id }} .ingredients-header__title {
    font-weight: {{ section.settings.heading_font_weight }};
  }
  {% endif %}

  {% if section.settings.heading_line_height != blank %}
  #shopify-section-{{ section.id }} .ingredients-header__title {
    line-height: {{ section.settings.heading_line_height }};
  }
  {% endif %}

   #shopify-section-{{ section.id }} .ingredients-header__subtitle-wrapper {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .ingredients-header__subtitle {
    font-size: 1.25rem;
    color: #535862;
    margin: 0;
    line-height: 140%;
  }

  #shopify-section-{{ section.id }} .ingredients-header__link {
    font-size: 1.125rem;
    color: #26736D;
    text-decoration: none;
    font-weight: 500;
    display: inline-block;
    line-height: 135%;
    text-decoration-line: underline;
  }

  #shopify-section-{{ section.id }} .ingredients-header__link:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel {
    position: relative;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__wrapper {
    margin-bottom: 0.5rem;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__track {
    display: flex;
    gap: 2rem;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .ingredient-card {
    flex: 0 0 316px;
    background: #F7F7F4;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    min-width: 316px;
    position: relative;
    padding-top: 5rem;
    gap: 0.5rem;
  }

  #shopify-section-{{ section.id }} .ingredient-card__image-wrapper {
    width: 137px;
    height: 100px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    overflow: hidden;
    position: absolute;
    right: 0;
    top: -40px;
  }

  #shopify-section-{{ section.id }} .ingredient-card__image {
    width: 100%;
    height: 100%;
        object-fit: contain;
  }

  #shopify-section-{{ section.id }} .ingredient-card__title {
    font-size: var(--card-title-font-size);
    font-weight: 500;
    line-height: 145%;
    margin: 0;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .ingredient-card__description {
        color: #535862;
    margin: 0;
    line-height: 145%;
    font-weight: 450;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__nav--wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    max-width: 1360px;
    margin: 2rem auto 0;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__nav {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #26736D;
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__nav:hover {
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    background: #F7F7F4;
    border: 1px solid #D5D7DA;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__nav svg {
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__progress {
    height: 2px;
    background: #E5E5E0;
    border-radius: 1px;
    overflow: hidden;
    flex: 1;
    margin: 0 1rem;
  }

  #shopify-section-{{ section.id }} .ingredients-carousel__progress-bar {
    height: 100%;
    background: #181D27;
    transition: width 0.3s ease;
  }

  /* Mobile Styles */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: var(--section-padding-top-mobile);
      --section-padding-bottom: var(--section-padding-bottom-mobile);
    }

    #shopify-section-{{ section.id }} .ingredients-header__title {
      font-size: var(--heading-font-size-mobile);
      line-height: 32px;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }

    #shopify-section-{{ section.id }} .ingredients-header__subtitle {
      font-size: 0.9rem;
    }

    #shopify-section-{{ section.id }} .ingredients-header__link {
      font-weight: 700;
      font-size: 16px;
      line-height: 24px;
      color: #1E5B57;
    }

    #shopify-section-{{ section.id }} .ingredients-carousel__track {
      gap: 0.25rem;
    }

    #shopify-section-{{ section.id }} .ingredient-card {
      flex: 0 0 320px;
      min-width: 320px;
    }

    #shopify-section-{{ section.id }} .ingredient-card__image-wrapper {
      width: 120px;
      height: 120px;
      margin-bottom: 1rem;
    }

    #shopify-section-{{ section.id }} .ingredient-card__title {
      font-size: var(--card-title-font-size-mobile);
    }

    #shopify-section-{{ section.id }} .ingredient-card__description {
      font-size: 0.85rem;
    }

    #shopify-section-{{ section.id }} .ingredients-carousel__nav {
      width: 48px;
      height: 48px;
    }

    #shopify-section-{{ section.id }} .ingredients-header {
      margin-bottom: 2.5rem;
    }

    {% if section.settings.heading_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .ingredients-header__title {
      font-weight: {{ section.settings.heading_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.heading_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .ingredients-header__title {
      line-height: {{ section.settings.heading_line_height_mobile }};
    }
    {% endif %}
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="ingredients-header">
       
          <h2 class="ingredients-header__title">{{ section.settings.title }}</h2>
          
       

        <div class="ingredients-header__subtitle-wrapper">
        {%- if section.settings.subtitle != blank -%}
            <p class="ingredients-header__subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}
        {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
          <a href="{{ section.settings.link_url }}" class="ingredients-header__link">{{ section.settings.link_text }}</a>
        {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="ingredients-carousel" data-carousel>
      <div class="ingredients-carousel__wrapper">
        <div class="ingredients-carousel__track" data-carousel-track>
          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient_item' -%}
              <article class="ingredient-card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="ingredient-card__image-wrapper">
                    {{
                      block.settings.image
                      | image_url: width: 200
                      | image_tag:
                        loading: 'lazy',
                        width: block.settings.image.width,
                        height: block.settings.image.height,
                        alt: block.settings.title,
                        class: 'ingredient-card__image'
                    }}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="ingredient-card__title">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <p class="ingredient-card__description">{{ block.settings.description }}</p>
                {%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="ingredients-carousel__nav--wrapper">
        <button class="ingredients-carousel__nav ingredients-carousel__nav--prev" data-carousel-prev aria-label="{{ section.settings.previous_button_label }}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="ingredients-carousel__progress">
          <div class="ingredients-carousel__progress-bar" data-carousel-progress></div>
        </div>

        <button class="ingredients-carousel__nav ingredients-carousel__nav--next" data-carousel-next aria-label="{{ section.settings.next_button_label }}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;

    const carousels = section.querySelectorAll('[data-carousel]');
    
    carousels.forEach(carousel => {
      const track = carousel.querySelector('[data-carousel-track]');
      const prevBtn = carousel.querySelector('[data-carousel-prev]');
      const nextBtn = carousel.querySelector('[data-carousel-next]');
      const progressBar = carousel.querySelector('[data-carousel-progress]');
      const cards = track.querySelectorAll('.ingredient-card');
      
      let currentIndex = 0;
      
      function calculateCardWidth() {
        if (cards.length === 0) return 0;
        const cardWidth = cards[0].offsetWidth;
        const trackStyle = window.getComputedStyle(track);
        const gap = parseFloat(trackStyle.gap) || 24;
        return cardWidth + gap;
      }
      
      function calculateMaxIndex() {
        const wrapperWidth = carousel.querySelector('.ingredients-carousel__wrapper').offsetWidth;
        const trackWidth = track.scrollWidth;
        
        if (trackWidth <= wrapperWidth) {
          return 0;
        }
        
        const cardWidth = calculateCardWidth();
        if (cardWidth === 0) return 0;
        
        const visibleCards = Math.floor(wrapperWidth / cardWidth);
        
        return Math.max(0, cards.length - visibleCards);
      }

      function updateCarousel() {
        const wrapperWidth = carousel.querySelector('.ingredients-carousel__wrapper').offsetWidth;
        const trackWidth = track.scrollWidth;
        const allItemsVisible = trackWidth <= wrapperWidth;
        
        if (allItemsVisible) {
          track.style.transform = 'translateX(0px)';
          progressBar.style.width = '100%';
          prevBtn.disabled = true;
          nextBtn.disabled = true;
          return;
        }
        
        const cardWidth = calculateCardWidth();
        const maxIndex = calculateMaxIndex();
        const maxOffset = Math.max(0, trackWidth - wrapperWidth);
        
        const offset = Math.min(currentIndex * cardWidth, maxOffset);
        
        track.style.transform = `translateX(-${offset}px)`;
        
        const progress = maxIndex > 0 ? ((currentIndex + 1) / (maxIndex + 1)) * 100 : 100;
        progressBar.style.width = `${progress}%`;
        
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex >= maxIndex;
      }
      
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          updateCarousel();
        }
      });
      
      nextBtn.addEventListener('click', () => {
        const maxIndex = calculateMaxIndex();
        if (currentIndex < maxIndex) {
          currentIndex++;
          updateCarousel();
        }
      });
      
      window.addEventListener('resize', () => {
        currentIndex = 0;
        updateCarousel();
      });
      
      updateCarousel();
    });
  });
</script>

