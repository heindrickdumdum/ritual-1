<style>
  #shopify-section-{{ section.id }} {
    color: rgb(var(--color-foreground));
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="tw-flex tw-items-center tw-justify-center color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_prefix -%}
    <div class="tw-flex-none tw-px-6" style="border-right: 1px solid {{ section.settings.border_color }};">
      {%- if section.settings.prefix_link != blank -%}
        <a href="{{ section.settings.prefix_link }}" style="color: rgb(var(--color-foreground)); text-decoration: none;">
          {{ section.settings.prefix_text }}
        </a>
      {%- else -%}
        <span>{{ section.settings.prefix_text }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <aside
    class="announcement-bar-marquee section section--full-width"
    style="--marquee-speed: {{ section.settings.speed }}s; --border-bottom-width: {{ section.settings.divider_width }}px;"
  >
    <div class="announcement-bar-marquee__wrapper">
    
      <div class="announcement-bar-marquee__track" data-marquee-track>
        <div class="announcement-bar-marquee__content" data-marquee-content>
          {%- for block in section.blocks -%}
            <div class="announcement-bar-marquee__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-bar-marquee__link">
                  {{ block.settings.text }}
                </a>
              {%- else -%}
                <span class="announcement-bar-marquee__text">
                  {{ block.settings.text }}
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="announcement-bar-marquee__content" data-marquee-content aria-hidden="true">
          {%- for block in section.blocks -%}
            <div class="announcement-bar-marquee__item">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-bar-marquee__link" tabindex="-1">
                  {{ block.settings.text }}
                </a>
              {%- else -%}
                <span class="announcement-bar-marquee__text">
                  {{ block.settings.text }}
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </aside>
</div>

{% stylesheet %}
  .announcement-bar-marquee {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    padding: 12px 0;
    overflow: hidden;
  }

  .announcement-bar-marquee__wrapper {
    width: 100%;
    overflow: hidden;
  }

  .announcement-bar-marquee__track {
    display: flex;
    width: fit-content;
    animation: marquee var(--marquee-speed, 20s) linear infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .announcement-bar-marquee__track:hover {
    animation-play-state: paused;
  }

  .announcement-bar-marquee__content {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding-right: 3rem;
    white-space: nowrap;
  }

  .announcement-bar-marquee__item {
    display: inline-flex;
    align-items: center;
  }

  .announcement-bar-marquee__text,
  .announcement-bar-marquee__link {
    font-size: 1rem;
    font-weight: 400;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .announcement-bar-marquee__link:hover {
    opacity: 0.8;
  }
{% endstylesheet %}

<script>
  // Ensure seamless loop by duplicating content if needed
  document.addEventListener('DOMContentLoaded', function() {
    const tracks = document.querySelectorAll('[data-marquee-track]');
    
    tracks.forEach(track => {
      const firstContent = track.querySelector('[data-marquee-content]');
      if (firstContent) {
        const trackWidth = track.offsetWidth;
        const contentWidth = firstContent.offsetWidth;
        
        // Adjust animation speed based on content width
        const speed = Math.max(20, contentWidth / 50);
        track.style.setProperty('--marquee-speed', `${speed}s`);
      }
    });
  });
</script>

