{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
  }

  #shopify-section-{{ section.id }} .customer-reviews-section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .customer-reviews__header {
    text-align: center;
    margin-bottom: 5rem;
  }

  #shopify-section-{{ section.id }} .customer-reviews__title {
    font-weight: 500;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .customer-reviews__title {
      font-size: 2rem;
    }
  }

  #shopify-section-{{ section.id }} .customer-reviews__grid {
    position: relative;
    column-count: 3;
    column-gap: 2rem;
    margin-bottom: 5rem;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .customer-reviews__grid {
      column-count: 2;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .customer-reviews__grid {
      column-count: 1;
    }
  }

  #shopify-section-{{ section.id }} .review-card {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.08);
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .review-card__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    /* Beige-dark */
    border-bottom: 1px solid #E3E3DE;
    padding-bottom: 1.25rem;
  }

  #shopify-section-{{ section.id }} .review-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #E5E5E0;
    flex-shrink: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .review-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .review-card__info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .review-card__name {
    font-size: 1rem;
    font-weight: bold;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .review-card__rating {
    display: flex;
    gap: 0.25rem;
  }

  #shopify-section-{{ section.id }} .review-card__star {
    width: 16px;
    height: 16px;
    color: #4A9B8E;
  }

  #shopify-section-{{ section.id }} .review-card__text {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.8);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .customer-reviews__cta {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .customer-reviews__button {
    display: inline-block;
    padding: 1rem 2rem;
    background: #ffffff;
    border: 1.5px solid #E9EAEB;
    border-radius: 8px;
    color: #1E5B57;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .customer-reviews__button:hover {
    background: #F7F7F4;
    border-color: #4A9B8E;
  }

  #shopify-section-{{ section.id }} .fading-section {
    /* Overlap */

    position: absolute;
    width: 100%;
    height: 160px;
    left: calc(50% - 1360px/2);
    bottom: 0px;

    background: linear-gradient(0deg, #F7F7F4 0%, rgba(247, 247, 244, 0) 100%);

    /* Inside auto layout */
    flex: none;
    order: 3;
    flex-grow: 0;
    z-index: 3;

  }
{%- endstyle -%}

<div class="customer-reviews-section section section--page-width color-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="customer-reviews__header">
        <h2 class="customer-reviews__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="customer-reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="review-card" {{ block.shopify_attributes }}>
            <div class="review-card__header">
              <div class="review-card__avatar">
                {%- if block.settings.avatar != blank -%}
                  <img src="{{ block.settings.avatar | image_url: width: 96 }}" alt="{{ block.settings.name }}" loading="lazy">
                {%- endif -%}
              </div>
              <div class="review-card__info">
                {%- if block.settings.name != blank -%}
                  <h3 class="review-card__name">{{ block.settings.name }}</h3>
                {%- endif -%}
                <div class="review-card__rating">
                  {%- for i in (1..5) -%}
                    <svg class="review-card__star" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {%- endfor -%}
                </div>
              </div>
            </div>
            {%- if block.settings.review_text != blank -%}
              <p class="review-card__text">{{ block.settings.review_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      
        <div class="fading-section">

        </div>
    </div>


    {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
      <div class="customer-reviews__cta">
        <a href="{{ section.settings.button_url }}" class="customer-reviews__button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by 1.5m+ Customers"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All Reviews"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
