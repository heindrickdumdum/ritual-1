{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }

  #shopify-section-{{ section.id }} .customer-reviews-section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .customer-reviews__header {
    text-align: center;
    margin-bottom: 5rem;
  }

  #shopify-section-{{ section.id }} .customer-reviews__title {
    font-weight: 500;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  {% if section.settings.title_font_size != blank %}
  #shopify-section-{{ section.id }} .customer-reviews__title {
    font-size: {{ section.settings.title_font_size }}px;
  }
  {% endif %}

  {% if section.settings.title_font_weight != blank %}
  #shopify-section-{{ section.id }} .customer-reviews__title {
    font-weight: {{ section.settings.title_font_weight }};
  }
  {% endif %}

  {% if section.settings.title_line_height != blank %}
  #shopify-section-{{ section.id }} .customer-reviews__title {
    line-height: {{ section.settings.title_line_height }};
  }
  {% endif %}


  #shopify-section-{{ section.id }} .customer-reviews__grid {
    position: relative;
    column-count: 3;
    column-gap: 2rem;
    margin-bottom: 5rem;
  }


  #shopify-section-{{ section.id }} .review-card {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.08);
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .review-card__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    /* Beige-dark */
    border-bottom: 1px solid #E3E3DE;
    padding-bottom: 1.25rem;
  }

  #shopify-section-{{ section.id }} .review-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #E5E5E0;
    flex-shrink: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .review-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .review-card__info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .review-card__name {
    font-size: 1rem;
    font-weight: bold;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  {% if section.settings.name_font_size != blank %}
  #shopify-section-{{ section.id }} .review-card__name {
    font-size: {{ section.settings.name_font_size }}px;
  }
  {% endif %}

  {% if section.settings.name_font_weight != blank %}
  #shopify-section-{{ section.id }} .review-card__name {
    font-weight: {{ section.settings.name_font_weight }};
  }
  {% endif %}

  {% if section.settings.name_line_height != blank %}
  #shopify-section-{{ section.id }} .review-card__name {
    line-height: {{ section.settings.name_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .review-card__rating {
    display: flex;
    gap: 0.25rem;
  }

  #shopify-section-{{ section.id }} .review-card__star {
    width: 16px;
    height: 16px;
    color: #26736D;
  }

  #shopify-section-{{ section.id }} .review-card__media {
    width: 100%;
    margin-bottom: 1.5rem;
    border-radius: 8px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .review-card__video {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    background: #E5E5E0;
  }

  #shopify-section-{{ section.id }} .review-card__video-container {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .review-card__video iframe {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .review-card__play-button {
    position: absolute;
    width: 60px;
    height: 60px;
    background: rgba(38, 115, 109, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .review-card__play-button svg {
    width: 24px;
    height: 24px;
    margin-left: 4px;
  }

  #shopify-section-{{ section.id }} .review-card__photos {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  #shopify-section-{{ section.id }} .review-card__photos--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  #shopify-section-{{ section.id }} .review-card__photos--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  #shopify-section-{{ section.id }} .review-card__photos--4 {
    grid-template-columns: repeat(2, 1fr);
  }

  #shopify-section-{{ section.id }} .review-card__photo {
    width: 100%;
    aspect-ratio: 1;
    background: #E5E5E0;
    border-radius: 8px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .review-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .review-card__text {
    font-size: 1rem;
    line-height: 1.5;
    /* color: rgba(var(--color-foreground), 0.8); */
    color: #535862;
    margin: 0;
  }

  {% if section.settings.review_text_font_size != blank %}
  #shopify-section-{{ section.id }} .review-card__text {
    font-size: {{ section.settings.review_text_font_size }}px;
  }
  {% endif %}

  {% if section.settings.review_text_font_weight != blank %}
  #shopify-section-{{ section.id }} .review-card__text {
    font-weight: {{ section.settings.review_text_font_weight }};
  }
  {% endif %}

  {% if section.settings.review_text_line_height != blank %}
  #shopify-section-{{ section.id }} .review-card__text {
    line-height: {{ section.settings.review_text_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .customer-reviews__cta {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .customer-reviews__button {
    display: inline-block;
    padding: 1rem 2rem;
    border: 1.5px solid #E9EAEB;
    border-radius: 8px;
    color: #1E5B57;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  {% if section.settings.button_font_size != blank %}
  #shopify-section-{{ section.id }} .customer-reviews__button {
    font-size: {{ section.settings.button_font_size }}px;
  }
  {% endif %}

  {% if section.settings.button_font_weight != blank %}
  #shopify-section-{{ section.id }} .customer-reviews__button {
    font-weight: {{ section.settings.button_font_weight }};
  }
  {% endif %}

  {% if section.settings.button_line_height != blank %}
  #shopify-section-{{ section.id }} .customer-reviews__button {
    line-height: {{ section.settings.button_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .customer-reviews__button:hover {
    background: #F7F7F4;
    border-color: #4A9B8E;
  }

  #shopify-section-{{ section.id }} .fading-section {
    /* Overlap */

    position: absolute;
    width: 100%;
    height: 160px;
    /* left: calc(50% - 1360px/2); */
    left: 0;
    right: 0;
    bottom: 0px;

    background: linear-gradient(0deg, #F7F7F4 0%, rgba(247, 247, 244, 0) 100%);

    /* Inside auto layout */
    flex: none;
    order: 3;
    flex-grow: 0;
    z-index: 3;

  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .customer-reviews__grid {
      column-count: 2;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: var(--section-padding-top-mobile);
      --section-padding-bottom: var(--section-padding-bottom-mobile);
    }

    #shopify-section-{{ section.id }} .customer-reviews__title {
      font-size: 2rem;
    }

    #shopify-section-{{ section.id }} .customer-reviews__header {
      margin-bottom: 2.5rem;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .review-card {
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    #shopify-section-{{ section.id }} .review-card__header {
      gap: 0.75rem;
      padding-bottom: 1rem;
      margin-bottom: 1rem;
    }

    #shopify-section-{{ section.id }} .customer-reviews__button {
      width: 100%;
    }

    {% if section.settings.title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .customer-reviews__title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.title_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .customer-reviews__title {
      font-weight: {{ section.settings.title_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.title_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .customer-reviews__title {
      line-height: {{ section.settings.title_line_height_mobile }};
    }
    {% endif %}

    {% if section.settings.name_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .review-card__name {
      font-size: {{ section.settings.name_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.name_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .review-card__name {
      font-weight: {{ section.settings.name_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.name_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .review-card__name {
      line-height: {{ section.settings.name_line_height_mobile }};
    }
    {% endif %}

    {% if section.settings.review_text_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .review-card__text {
      font-size: {{ section.settings.review_text_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.review_text_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .review-card__text {
      font-weight: {{ section.settings.review_text_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.review_text_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .review-card__text {
      line-height: {{ section.settings.review_text_line_height_mobile }};
    }
    {% endif %}

    {% if section.settings.button_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .customer-reviews__button {
      font-size: {{ section.settings.button_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.button_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .customer-reviews__button {
      font-weight: {{ section.settings.button_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.button_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .customer-reviews__button {
      line-height: {{ section.settings.button_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .customer-reviews__grid {
      column-count: 1;
      margin-bottom: 2.5rem;
    }
  }
{%- endstyle -%}

<div class="customer-reviews-section section section--page-width color-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="customer-reviews__header">
        <h2 class="customer-reviews__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="customer-reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="review-card" {{ block.shopify_attributes }}>

            <div class="review-card__header">
              <div class="review-card__avatar">
                {%- if block.settings.avatar != blank -%}
                  <img src="{{ block.settings.avatar | image_url: width: 96 }}" alt="{{ block.settings.name }}" loading="lazy">
                {%- endif -%}
              </div>
              <div class="review-card__info">
                {%- if block.settings.name != blank -%}
                  <h3 class="review-card__name">{{ block.settings.name }}</h3>
                {%- endif -%}
                <div class="review-card__rating">
                  {%- for i in (1..5) -%}
                    <svg class="review-card__star" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {%- endfor -%}
                </div>
              </div>
            </div>

            {%- if block.settings.media_type == 'video' and block.settings.video_url != blank -%}
              <div class="review-card__media">
                <div class="review-card__video">
                  <div class="review-card__video-container">
                    {%- if block.settings.video_url contains 'youtube' or block.settings.video_url contains 'youtu.be' -%}
                      {%- if block.settings.video_url contains 'youtu.be' -%}
                        {%- assign video_id = block.settings.video_url | split: '/' | last | split: '?' | first -%}
                      {%- else -%}
                        {%- assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first -%}
                      {%- endif -%}
                      <iframe src="https://www.youtube.com/embed/{{ video_id }}?rel=0" title="YouTube video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen="allowfullscreen"></iframe>
                    {%- elsif block.settings.video_url contains 'vimeo' -%}
                      {%- assign video_id = block.settings.video_url | split: '/' | last | split: '?' | first -%}
                      <iframe src="https://player.vimeo.com/video/{{ video_id }}" title="Vimeo video" allow="autoplay; fullscreen" allowfullscreen="allowfullscreen"></iframe>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- elsif block.settings.media_type == 'photos' -%}
              {%- assign photo_count = 0 -%}
              {%- if block.settings.photo_1 != blank -%}
                {%- assign photo_count = photo_count | plus: 1 -%}
              {%- endif -%}
              {%- if block.settings.photo_2 != blank -%}
                {%- assign photo_count = photo_count | plus: 1 -%}
              {%- endif -%}
              {%- if block.settings.photo_3 != blank -%}
                {%- assign photo_count = photo_count | plus: 1 -%}
              {%- endif -%}
              {%- if block.settings.photo_4 != blank -%}
                {%- assign photo_count = photo_count | plus: 1 -%}
              {%- endif -%}
              
              {%- if photo_count > 0 -%}
                <div class="review-card__photos review-card__photos--{{ photo_count }}">
                  {%- if block.settings.photo_1 != blank -%}
                    <div class="review-card__photo">
                      <img src="{{ block.settings.photo_1 | image_url: width: 400 }}" alt="Review photo" loading="lazy">
                    </div>
                  {%- endif -%}
                  {%- if block.settings.photo_2 != blank -%}
                    <div class="review-card__photo">
                      <img src="{{ block.settings.photo_2 | image_url: width: 400 }}" alt="Review photo" loading="lazy">
                    </div>
                  {%- endif -%}
                  {%- if block.settings.photo_3 != blank -%}
                    <div class="review-card__photo">
                      <img src="{{ block.settings.photo_3 | image_url: width: 400 }}" alt="Review photo" loading="lazy">
                    </div>
                  {%- endif -%}
                  {%- if block.settings.photo_4 != blank -%}
                    <div class="review-card__photo">
                      <img src="{{ block.settings.photo_4 | image_url: width: 400 }}" alt="Review photo" loading="lazy">
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
            
        
            {%- if block.settings.review_text != blank -%}
              <p class="review-card__text">{{ block.settings.review_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      
        <div class="fading-section">

        </div>
    </div>


    {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
      <div class="customer-reviews__cta">
        <a href="{{ section.settings.button_url }}" class="customer-reviews__button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

