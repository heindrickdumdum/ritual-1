{%- style -%}
  #shopify-section-{{ section.id }} {
  }

  #shopify-section-{{ section.id }} .product-promotion-wrapper {
    place-items: center;
    padding: 160px;
    background-color: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .product-promotion-main {
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-self: center;
    max-width: 720px;
  }

  #shopify-section-{{ section.id }} .promotion-heading {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .promotion-heading__icon {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .promotion-heading__icon img {
    width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .promotion-heading__content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .promotion-heading__title {
    margin: 0;
    font-size: 32px;
    line-height: 136%;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .promotion-heading__subtitle {
    text-transform: uppercase;
    font-size: 16px;
    line-height: 100%;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin: 0;
    white-space: nowrap;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .promotion-heading__content img {
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .question-mark-icon {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .modal {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background-color: rgba(24, 29, 39, 0.95);
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    line-height: 18px;
    white-space: nowrap;
    z-index: 100;
    margin-bottom: 8px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .modal.active {
    display: block;
  }

  #shopify-section-{{ section.id }} .question-mark-icon {
    position: relative;
  }

  #shopify-section-{{ section.id }} .modal-content {
    all: unset;
  }

  #shopify-section-{{ section.id }} .modal-content h2 {
    display: none;
  }

  #shopify-section-{{ section.id }} .modal-close {
    display: none;
  }

  #shopify-section-{{ section.id }} .content {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .content-header {
    grid-column: 1 / -1;
    display: contents;
  }

  #shopify-section-{{ section.id }} .content-header-cell {
    padding: 32px;
    font-weight: 700;
    text-align: center;
    border-bottom: 1px solid #E9EAEB;
  }

  #shopify-section-{{ section.id }} .content-header-cell:nth-child(2) {
    font-size: 20px;
    line-height: 140%;
    font-weight: 700;
    background-color: #FFFFFF;
    border-radius: 20px 20px 0 0;
  }

  #shopify-section-{{ section.id }} .content-row {
    display: contents;
  }

  #shopify-section-{{ section.id }} .content-label {
    padding: 16px;
    font-weight: 500;
    border-bottom: 1px solid #E9EAEB;
  }

  #shopify-section-{{ section.id }} .content-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
    border-bottom: 1px solid #E9EAEB;
    font-size: 14px;
    line-height: 145%;
    font-weight: 500;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .content-cell:nth-child(3n + 2) {
    background-color: #FFFFFF;
  }

  #shopify-section-{{ section.id }} .promotion-heading__top {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .terms-and-conditions {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: #FFFFFF;
    gap: 32px;
    padding: 20px;
  }

  #shopify-section-{{ section.id }} .guarantee-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border: 1px solid #181D27;
    border-radius: 0 0 0 20px;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .guarantee-content img {
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .guarantee-content h5 {
    margin: 0;
    font-size: 13px;
    line-height: 20px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  #shopify-section-{{ section.id }} .guarantee-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .guarantee-top h4 {
    margin: 0;
    font-size: 20px;
    line-height: 26px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .terms-link__anchor {
    display: inline-block;
    width: fit-content;
    text-decoration: underline;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    letter-spacing: 0;
    color: #1E5B57;
  }

  #shopify-section-{{ section.id }} .terms-link {
    flex-shrink: 0;
    display: inline-block;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .product-promotion-wrapper {
      padding: 64px 0;
    }

    #shopify-section-{{ section.id }} .promotion-heading {
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .promotion-heading__icon {
      width: 64px;
      height: 64px;
    }

    #shopify-section-{{ section.id }} .promotion-heading__subtitle {
      font-size: 16px;
      line-height: 24px;
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .content {
      grid-template-columns: 1fr 1fr 1fr;
    }

    #shopify-section-{{ section.id }} .content-header {
      grid-template-columns: 1fr 1fr 1fr;
    }

    #shopify-section-{{ section.id }} .content-header-cell {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      font-size: 14px;
      line-height: 24px;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .content-header-cell:nth-child(2) {
      font-size: 20px;
      line-height: 140%;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .content-label {
      display: flex;
      align-items: center;
      margin: auto 0;
      grid-column: auto;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .content-cell {
      display: flex;
      align-items: center;
      justify-content: center;
      grid-column: auto;
      font-size: 16px;
      line-height: 24px;
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .promotion-heading__title {
      font-size: 32px;
      line-height: 40px;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .guarantee-content h5 {
      white-space: nowrap;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .guarantee-content {
      gap: 5px;
    }

    #shopify-section-{{ section.id }} .terms-and-conditions {
      gap: 20px;
    }
  }
{%- endstyle -%}

<div class="product-promotion-wrapper section">
  <main class="product-promotion-main">
    <div class="promotion-heading">
      <div class="promotion-heading__icon">
        <img src="{{ 'icon-piggy-bank.svg' | asset_url }}" alt="Piggy Bank Icon" width="72" height="72">
      </div>
      <div class="promotion-heading__content">
        <div class="promotion-heading__top">
          <h3 class="promotion-heading__title">{{ section.settings.promote_title }}</h3>
          <p class="promotion-heading__subtitle">{{ section.settings.promote_subtitle }}</p>
          <button class="question-mark-icon" type="button">
            <img
              src="{{ 'icon-question-mark-circle.svg' | asset_url }}"
              alt="Question Mark Icon"
              width="24"
              height="24"
            >
          </button>
          <div class="modal" id="infoModal-{{ section.id }}">
            <div class="modal-content">Learn more about this offer</div>
          </div>
        </div>
        <div class="promotion-heading__bottom">
          <p>{{ section.settings.description }}</p>
        </div>
      </div>
    </div>

    <div class="content">
      <div class="content-header">
        <div class="content-label"></div>
        <div class="content-header-cell">Ritual1</div>
        <div class="content-header-cell">Traditional</div>
      </div>
      <div class="content-row">
        <div class="content-label">Online visit</div>
        <div class="content-cell">{{ section.settings.ritual1_online_visit }}</div>
        <div class="content-cell">{{ section.settings.traditional_online_visit }}</div>
      </div>
      <div class="content-row">
        <div class="content-label">Solution</div>
        <div class="content-cell">{{ section.settings.ritual1_solution }}</div>
        <div class="content-cell">{{ section.settings.traditional_solution }}</div>
      </div>
      <div class="content-row">
        <div class="content-label">60-day consultation</div>
        <div class="content-cell">{{ section.settings.ritual1_consultation }}</div>
        <div class="content-cell">{{ section.settings.traditional_consultation }}</div>
      </div>
    </div>
    <div class="terms-and-conditions">
      <div class="terms-guarantee">
        <div class="guarantee-content">
          <div class="guarantee-top">
            <h4>1 Year</h4>
            <img src="{{ 'icon-security-check.svg' | asset_url }}" alt="Shield Check Icon" width="28" height="28">
          </div>
          <h5>Result Guarantee</h5>
        </div>
      </div>
      <div class="terms-link">
        <a href="/terms" class="terms-link__anchor">View Terms & Conditions</a>
      </div>
    </div>
  </main>
</div>

{% schema %}
{
  "name": "Product Promotion",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "promote_title",
      "label": "Promote Title",
      "default": "10X"
    },
    {
      "type": "text",
      "id": "promote_subtitle",
      "label": "Promote Subtitle",
      "default": "More Affordable"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Significantly cheaper visits and treatments compared to standard prescriptions or laser treatment:</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F7F4"
    },
    {
      "type": "header",
      "content": "Online Visit"
    },
    {
      "type": "text",
      "id": "ritual1_online_visit",
      "label": "Ritual1 Online Visit",
      "default": "$20"
    },
    {
      "type": "text",
      "id": "traditional_online_visit",
      "label": "Traditional Online Visit",
      "default": "$200+"
    },
    {
      "type": "header",
      "content": "Solution"
    },
    {
      "type": "text",
      "id": "ritual1_solution",
      "label": "Ritual1 Solution",
      "default": "$36/mo."
    },
    {
      "type": "text",
      "id": "traditional_solution",
      "label": "Traditional Solution",
      "default": "$400–$1000+"
    },
    {
      "type": "header",
      "content": "Consultation"
    },
    {
      "type": "text",
      "id": "ritual1_consultation",
      "label": "Ritual1 Consultation",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "traditional_consultation",
      "label": "Traditional Consultation",
      "default": "None"
    }
  ],
  "presets": [
    {
      "name": "Product Promotion",
      "category": "Products",
      "settings": {
        "promote_title": "10X",
        "promote_subtitle": "More Affordable",
        "ritual1_online_visit": "$20",
        "traditional_online_visit": "$200+",
        "ritual1_solution": "$36/mo.",
        "traditional_solution": "$400–$1000+",
        "ritual1_consultation": "Free",
        "traditional_consultation": "None"
      }
    }
  ]
}
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const modal = document.getElementById(`infoModal-${sectionId}`);
    const btn = document.querySelector(`#shopify-section-${sectionId} .question-mark-icon`);

    if (btn && modal) {
      btn.addEventListener('mouseenter', function () {
        modal.classList.add('active');
      });

      btn.addEventListener('mouseleave', function () {
        modal.classList.remove('active');
      });
    }
  });
</script>
