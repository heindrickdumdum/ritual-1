{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }

  #shopify-section-{{ section.id }} .community-section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .community-section__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .community-section__left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  #shopify-section-{{ section.id }} .community-section__title {
    font-weight: 500;
    font-size: 2.5rem;
    line-height: 1.2;
    margin: 0;
    color: #181D27;
  }

  {% if section.settings.title_font_size != blank %}
  #shopify-section-{{ section.id }} .community-section__title {
    font-size: {{ section.settings.title_font_size }}px;
  }
  {% endif %}

  {% if section.settings.title_font_weight != blank %}
  #shopify-section-{{ section.id }} .community-section__title {
    font-weight: {{ section.settings.title_font_weight }};
  }
  {% endif %}

  {% if section.settings.title_line_height != blank %}
  #shopify-section-{{ section.id }} .community-section__title {
    line-height: {{ section.settings.title_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .community-section__description {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
    color: #535862;
  }

  {% if section.settings.description_font_size != blank %}
  #shopify-section-{{ section.id }} .community-section__description {
    font-size: {{ section.settings.description_font_size }}px;
  }
  {% endif %}

  {% if section.settings.description_font_weight != blank %}
  #shopify-section-{{ section.id }} .community-section__description {
    font-weight: {{ section.settings.description_font_weight }};
  }
  {% endif %}

  {% if section.settings.description_line_height != blank %}
  #shopify-section-{{ section.id }} .community-section__description {
    line-height: {{ section.settings.description_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .community-section__button {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: #26736D;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
    width: fit-content;
  }

  #shopify-section-{{ section.id }} .community-section__button:hover {
    background-color: #1f5952;
  }

  #shopify-section-{{ section.id }} .community-section__right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .community-item {
    display: flex;
    gap: 1rem;
    align-items: center;

    background: #FFFFFF;
    border-radius: 16px;
        padding: 1rem;
  }

  #shopify-section-{{ section.id }} .community-item__image {
    width: 80px;
    height: 80px;
    background: #E5E5E5;
    border-radius: 8px;
    flex-shrink: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .community-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .community-item__content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .community-item__tag {
    font-size: 0.875rem;
    color: #535862;
    font-weight: 450;
    font-size: 16px;
    line-height: 150%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .community-item__title {
    font-weight: 500;
    line-height: 145%;
    color: #181D27;
    margin: 0;
  }

  {% if section.settings.item_title_font_size != blank %}
  #shopify-section-{{ section.id }} .community-item__title {
    font-size: {{ section.settings.item_title_font_size }}px;
  }
  {% endif %}

  /* Tablet Styles */
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .community-section__wrapper {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Mobile Styles */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: var(--section-padding-top-mobile);
      --section-padding-bottom: var(--section-padding-bottom-mobile);
    }

    #shopify-section-{{ section.id }} .community-item__tag {
      font-size: 0.875rem;
    font-weight: 500;
          font-weight: 500;
    line-height: 24px;
    }

    #shopify-section-{{ section.id }} .community-section__title {
      font-size: 1.75rem;
    }

    #shopify-section-{{ section.id }} .community-item__content {
      gap: 4px;
    }

    {% if section.settings.title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .community-section__title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.title_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .community-section__title {
      font-weight: {{ section.settings.title_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.title_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .community-section__title {
      line-height: {{ section.settings.title_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .community-section__description {
      font-size: 1rem;
    }

    {% if section.settings.description_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .community-section__description {
      font-size: {{ section.settings.description_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.description_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .community-section__description {
      font-weight: {{ section.settings.description_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.description_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .community-section__description {
      line-height: {{ section.settings.description_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .community-section__right {
      gap: 0.5rem;
    }

    #shopify-section-{{ section.id }} .community-item {
      padding: 12px;
      gap: 1rem;
    }

    #shopify-section-{{ section.id }} .community-item__image {
      width: 64px;
      height: 64px;
    }

    #shopify-section-{{ section.id }} .community-item__title {
      font-size: 0.9375rem;
    }

    {% if section.settings.item_title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .community-item__title {
      font-size: {{ section.settings.item_title_font_size_mobile }}px;
    }
    {% endif %}
  }
{%- endstyle -%}

<div class="community-section section section--page-width color-{{ section.settings.color_scheme }}" style="padding-top: var(--section-padding-top); padding-bottom: var(--section-padding-bottom);">
  <div class="container">
    <div class="community-section__wrapper">
      <div class="community-section__left">
        {%- if section.settings.title != blank -%}
          <h2 class="community-section__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="community-section__description">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          {%- if section.settings.button_link != blank -%}
            <a href="{{ section.settings.button_link }}" class="community-section__button">{{ section.settings.button_text }}</a>
          {%- else -%}
            <button class="community-section__button" type="button">{{ section.settings.button_text }}</button>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="community-section__right">
        {%- for block in section.blocks -%}
          {%- if block.type == 'community_item' -%}
            <div class="community-item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="community-item__image">
                  <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.title }}" loading="lazy">
                </div>
              {%- else -%}
                <div class="community-item__image"></div>
              {%- endif -%}

              <div class="community-item__content">
                {%- if block.settings.tag != blank -%}
                  <p class="community-item__tag">{{ block.settings.tag }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="community-item__title">{{ block.settings.title }}</h3>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

