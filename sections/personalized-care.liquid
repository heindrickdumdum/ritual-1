<style>
  #shopify-section-{{ section.id }} .personalized-care-section {

    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .personalized-care-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
  }

  /* Left Content */
  #shopify-section-{{ section.id }} .personalized-care-content {
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
    padding-top: var(--padding-block-start);
    padding-bottom: var(--padding-block-end);
    max-width: 580px;
    
  }

  #shopify-section-{{ section.id }} .personalized-care-heading {
    line-height: normal;
        font-weight: 500;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
  }

  #shopify-section-{{ section.id }} .personalized-care-description {
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0 0 2.5rem 0;
    opacity: 0.95;
  }

  #shopify-section-{{ section.id }} .personalized-care-description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .button .app-store-icon {
    width: 20px;
    height: 20px;
  }

  /* Right Content - Image */
  #shopify-section-{{ section.id }} .personalized-care-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .personalized-care-image {
    max-width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .personalized-care-placeholder {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1;
    background: rgba(var(--color-foreground), 0.05);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .personalized-care-placeholder svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  /* Responsive */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .personalized-care-grid {
      gap: 60px;
    }

    #shopify-section-{{ section.id }} .personalized-care-heading {
      font-size: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .personalized-care-section {
      padding: 60px 0;
    }

    #shopify-section-{{ section.id }} .personalized-care-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .personalized-care-content {
      text-align: center;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .personalized-care-heading {
      font-size: 36px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .personalized-care-heading {
      font-size: 32px;
    }
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="personalized-care-section color-{{ section.settings.color_scheme }}">
  <div class="section section--page-width color-{{ section.settings.color_scheme }}">
    <div class="personalized-care-grid">
      <!-- Left Column - Customizable Content -->
      <div class="personalized-care-content">
        {% if section.settings.heading != blank %}
          <h2 class="personalized-care-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="personalized-care-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a 
            href="{{ section.settings.button_link }}" 
            class="button button--primary tw-flex tw-items-center tw-gap-2 tw-rounded-lg tw-px-8"
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            <svg class="app-store-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.09997 21.99C7.78997 22.03 6.79997 20.68 5.95997 19.47C4.24997 17 2.93997 12.45 4.69997 9.39C5.56997 7.87 7.12997 6.91 8.81997 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z" fill="currentColor"/>
            </svg>
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      <!-- Right Column - Image Only -->
      <div class="personalized-care-visual">
        {% if section.settings.phone_mockup_image != blank %}
          {{
            section.settings.phone_mockup_image
            | image_url: width: 800
            | image_tag:
              class: 'personalized-care-image',
              loading: 'lazy',
              alt: section.settings.phone_mockup_image.alt | default: 'Phone mockup'
          }}
        {% else %}
          <div class="personalized-care-placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Personalized Care",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personalized Care at Every Step"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>At Ritual, we make it simple to get hair care that's truly made for you. From your first quiz to your ongoing routine, every recommendation is tailored to your goals, lifestyle, and needs. As your body changes, your plan adapts—so you always know what to use, when, and why.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "App Store"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "phone_mockup_image",
      "label": "Phone mockup image",
      "info": "Upload the complete phone mockup design as shown in the mockup"
    },
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Personalized Care"
    }
  ]
}
{% endschema %}
