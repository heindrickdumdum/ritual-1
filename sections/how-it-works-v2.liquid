{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }

  #shopify-section-{{ section.id }} .how-it-works {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .how-it-works__header {
    text-align: center;
    margin-bottom: 5rem;
  }

  #shopify-section-{{ section.id }} .how-it-works__title {
    font-weight: 500;
    font-size: 2.75rem;
    line-height: 1.2;
    margin: 0 0 1rem 0;
    color: #181D27;
  }

  {% if section.settings.title_font_size != blank %}
  #shopify-section-{{ section.id }} .how-it-works__title {
    font-size: {{ section.settings.title_font_size }}px;
  }
  {% endif %}

  {% if section.settings.title_font_weight != blank %}
  #shopify-section-{{ section.id }} .how-it-works__title {
    font-weight: {{ section.settings.title_font_weight }};
  }
  {% endif %}

  {% if section.settings.title_line_height != blank %}
  #shopify-section-{{ section.id }} .how-it-works__title {
    line-height: {{ section.settings.title_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .how-it-works__subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
    color: #535862;
  }

  {% if section.settings.subtitle_font_size != blank %}
  #shopify-section-{{ section.id }} .how-it-works__subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
  }
  {% endif %}

  #shopify-section-{{ section.id }} .how-it-works__steps {
    display: flex;
    /* grid-template-columns: repeat(3, 1fr); */
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .how-it-works__step {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    /* flex: 0 0 432px; */
    width: 100%;
    max-width: 432px;
  }

  #shopify-section-{{ section.id }} .how-it-works__step-label {
    font-weight: 500;
    font-size: 18px;
    line-height: 145%;
    color: #717680;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-it-works__step-title {
    font-weight: 500;
    line-height: 136%;
    letter-spacing: -0.02em;
    color: #181D27;
    margin: 0;
  }

  {% if section.settings.step_title_font_size != blank %}
  #shopify-section-{{ section.id }} .how-it-works__step-title {
    font-size: {{ section.settings.step_title_font_size }}px;
  }
  {% endif %}

  #shopify-section-{{ section.id }} .how-it-works__step-description {
    font-weight: 450;
    line-height: 145%;
    /* Gray/600 */
    color: #535862;
    margin: 0;
  }

  {% if section.settings.step_description_font_size != blank %}
  #shopify-section-{{ section.id }} .how-it-works__step-description {
    font-size: {{ section.settings.step_description_font_size }}px;
  }
  {% endif %}

  #shopify-section-{{ section.id }} .how-it-works__image-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .how-it-works__main-image {
    width: 100%;
    aspect-ratio: 4/3;
    background: #E5E5E5;
    border-radius: 12px;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  #shopify-section-{{ section.id }} .how-it-works__main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .how-it-works__thumbnails {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .how-it-works__thumbnail {
    width: 80px;
    height: 80px;
    background: #E5E5E5;
    border-radius: 8px;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s ease;
    flex-shrink: 0;
    border: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .how-it-works__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .how-it-works__thumbnail--active {
    border-color: #26736D;
  }

  #shopify-section-{{ section.id }} .how-it-works__thumbnail:hover {
    border-color: #1f5952;
  }

  #shopify-section-{{ section.id }} .how-it-works__progress {
    height: 2px;
    background: #E5E5E0;
    border-radius: 1px;
    overflow: hidden;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how-it-works__progress-bar {
    height: 100%;
    background: #181D27;
    transition: width 0.3s ease;
    width: 0%;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__nav--wrapper {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-it-works__progress {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-it-works__step-label--wrapper {
        padding: 32px 0px 0px;
        border-top: 1px solid #E9EAEB;
  }

  /* Tablet & Mobile Styles */
  @media (max-width: 1200px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: var(--section-padding-top-mobile);
      --section-padding-bottom: var(--section-padding-bottom-mobile);
    }

    #shopify-section-{{ section.id }} .how-it-works__header {
      margin-bottom: 2.5rem;
    }

    #shopify-section-{{ section.id }} .how-it-works__title {
      font-size: 1.75rem;
    }

    {% if section.settings.title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works__title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
    {% endif %}

    #shopify-section-{{ section.id }} .how-it-works__subtitle {
      font-size: 1rem;
    }

    #shopify-section-{{ section.id }} .how-it-works__steps {
      display: flex;
      flex-wrap: nowrap;
      gap: 0.75rem;
      /* overflow-x: auto;
      overflow-y: hidden; */
      overflow: hidden;
      scroll-behavior: smooth;
      margin: 0 -20px;
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .how-it-works__step {
      flex: 0 0 360px;
    }

    #shopify-section-{{ section.id }} .how-it-works__thumbnail {
      width: 60px;
      height: 60px;
    }

    #shopify-section-{{ section.id }} .how-it-works__step-title {
      font-size: 1.25rem;
    }

    {% if section.settings.step_title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works__step-title {
      font-size: {{ section.settings.step_title_font_size_mobile }}px;
    }
    {% endif %}

    #shopify-section-{{ section.id }} .how-it-works__carousel-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__nav--wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__nav {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #4A9B8E;
      border: none;
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.3s ease;
      z-index: 2;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__nav:hover {
      opacity: 0.9;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__nav:disabled {
      cursor: not-allowed;
      background: #F7F7F4;
      border: 1px solid #D5D7DA;
      color: #181D27;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__nav svg {
      width: 24px;
      height: 24px;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__nav--wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    #shopify-section-{{ section.id }} .how-it-works__progress {
      display: block;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .how-it-works__header {
      margin-bottom: 1.25rem;
    }
    #shopify-section-{{ section.id }} .how-it-works__step {
      flex: 0 0 360px;
    }
  }
{%- endstyle -%}

<div class="how-it-works section section--page-width color-{{ section.settings.color_scheme }}" style="padding-top: var(--section-padding-top); padding-bottom: var(--section-padding-bottom);">
  <div class="container">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="how-it-works__header">
        {%- if section.settings.title != blank -%}
          <h2 class="how-it-works__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="how-it-works__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="how-it-works__carousel" data-carousel>
      <div class="how-it-works__steps" data-carousel-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="how-it-works__step" {{ block.shopify_attributes }} data-step="{{ forloop.index }}">
            <div class="how-it-works__step-label--wrapper tw-flex tw-flex-col tw-gap-2">
              {%- if block.settings.step_label != blank -%}
                <p class="how-it-works__step-label">{{ block.settings.step_label }}</p>
              {%- else -%}
                <p class="how-it-works__step-label">Step {{ forloop.index }}</p>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="how-it-works__step-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="how-it-works__step-description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>

            <div class="how-it-works__image-gallery">
              {%- if block.settings.image_1 != blank -%}
                <div class="how-it-works__main-image" data-main-image="{{ forloop.index }}">
                  <img src="{{ block.settings.image_1 | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy">
                </div>

                <div class="how-it-works__thumbnails">
                  {%- if block.settings.image_1 != blank -%}
                    <button class="how-it-works__thumbnail how-it-works__thumbnail--active" data-thumbnail="{{ forloop.index }}-1" aria-label="View image 1">
                      <img src="{{ block.settings.image_1 | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy">
                    </button>
                  {%- endif -%}
                  
                  {%- if block.settings.image_2 != blank -%}
                    <button class="how-it-works__thumbnail" data-thumbnail="{{ forloop.index }}-2" aria-label="View image 2">
                      <img src="{{ block.settings.image_2 | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy">
                    </button>
                  {%- endif -%}
                  
                  {%- if block.settings.image_3 != blank -%}
                    <button class="how-it-works__thumbnail" data-thumbnail="{{ forloop.index }}-3" aria-label="View image 3">
                      <img src="{{ block.settings.image_3 | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy">
                    </button>
                  {%- endif -%}

                  {%- if block.settings.image_4 != blank -%}
                    <button class="how-it-works__thumbnail" data-thumbnail="{{ forloop.index }}-4" aria-label="View image 4">
                      <img src="{{ block.settings.image_4 | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy">
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      </div>
      
      <div class="how-it-works-carousel__nav--wrapper">
        <div>
          <button class="how-it-works-carousel__nav how-it-works-carousel__nav--prev" data-carousel-prev aria-label="Previous step">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
        </div>

        <div class="how-it-works__progress">
          <div class="how-it-works__progress-bar" data-carousel-progress></div>
        </div>

        <div>
          <button class="how-it-works-carousel__nav how-it-works-carousel__nav--next" data-carousel-next aria-label="Next step">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;

    // Handle thumbnail clicks to switch main image
    const thumbnails = section.querySelectorAll('.how-it-works__thumbnail');
    
    thumbnails.forEach(thumbnail => {
      thumbnail.addEventListener('click', function() {
        const thumbnailId = this.dataset.thumbnail;
        const [stepIndex, imageIndex] = thumbnailId.split('-');
        const mainImage = section.querySelector(`[data-main-image="${stepIndex}"]`);
        
        if (mainImage) {
          // Get the clicked thumbnail's image
          const newImageSrc = this.querySelector('img').src;
          mainImage.querySelector('img').src = newImageSrc;
          
          // Update active state
          const siblingThumbnails = this.parentElement.querySelectorAll('.how-it-works__thumbnail');
          siblingThumbnails.forEach(tb => tb.classList.remove('how-it-works__thumbnail--active'));
          this.classList.add('how-it-works__thumbnail--active');
        }
      });
    });

    // Handle steps carousel on mobile
    const carousels = section.querySelectorAll('[data-carousel]');
    
    carousels.forEach(carousel => {
      const track = carousel.querySelector('[data-carousel-track]');
      const prevBtn = carousel.querySelector('[data-carousel-prev]');
      const nextBtn = carousel.querySelector('[data-carousel-next]');
      const progressBar = carousel.querySelector('[data-carousel-progress]');
      const steps = track.querySelectorAll('.how-it-works__step');
      
      let currentIndex = 0;
      
      function calculateStepWidth() {
        if (steps.length === 0) return 0;
        const stepWidth = steps[0].offsetWidth;
        const trackStyle = window.getComputedStyle(track);
        const gap = parseFloat(trackStyle.gap) || 6;
        return stepWidth + gap;
      }
      
      function updateCarousel() {
        const stepWidth = calculateStepWidth();
        track.scrollTo({
          left: currentIndex * stepWidth,
          behavior: 'smooth'
        });
        
        // Update progress bar
        const progress = steps.length > 0 ? ((currentIndex + 1) / steps.length) * 100 : 0;
        progressBar.style.width = `${progress}%`;
        
        // Update button states
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex >= steps.length - 1;
      }
      
      prevBtn.addEventListener('click', function() {
        if (currentIndex > 0) {
          currentIndex--;
          updateCarousel();
        }
      });
      
      nextBtn.addEventListener('click', function() {
        if (currentIndex < steps.length - 1) {
          currentIndex++;
          updateCarousel();
        }
      });
      
      // Initialize progress bar
      updateCarousel();
    });
  });
</script>

