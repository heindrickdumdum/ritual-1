{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-bg-color: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} {
    padding-top: 60px;
    padding-bottom: 60px;
    background-color: var(--section-bg-color);
  }

  #shopify-section-{{ section.id }} .product-testimonials-wrapper {
    padding-top: 60px;
    padding-bottom: 60px;
    background-color: var(--section-bg-color);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .product-testimonials-main {
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .product-testimonials-main h2 {
    font-size: 44px;
    line-height: 146%;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap-style: balance;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .product-testimonials-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
    max-width: 720px;
    align-self: center;
  }

  #shopify-section-{{ section.id }} .product-testimonials-main .description {
    color: #535862;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .testimonials-carousel-container {
    position: relative;
  }

  #shopify-section-{{ section.id }} .testimonials-carousel-track {
    display: flex;
    gap: 40px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .testimonials-carousel-track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .testimonial-card {
    background-color: #F7F7F4;
    padding: 16px;
    border-radius: 20px;
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    flex-direction: row;
    gap: 40px;
    justify-content: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .testimonial-images {
    flex: 0 0 calc(70% - 20px);
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .testimonial-image {
    flex: 1;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .testimonial-image {
    border-radius: 12px;
    border: 1px solid #E3E3DE;
  }

  #shopify-section-{{ section.id }} .testimonial-image-label {
    position: absolute;
    top: 20px;
    left: 20px;
    font-size: 14px;
    line-height: 145%;
    font-weight: 500;
    color: #181D27;
    padding: 4px 12px;
    border-radius: 999px;
    background-color: white;
  }

  #shopify-section-{{ section.id }} .testimonial-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .testimonial-content-wrapper {
    flex: 0 0 calc(30% - 20px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .testimonial-content {
    font-size: 24px;
    line-height: 100%;
    font-weight: 400;
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .testimonial-author {
    font-size: 16px;
    font-weight: 600;
    line-height: 150%;
  }

  #shopify-section-{{ section.id }} .testimonial-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .testimonial-tag {
    display: inline-block;
    background-color: #EEEDE7;
    padding: 4px 12px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 500;
    line-height: 145%;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .carousel-controls {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    margin-top: 40px;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .carousel-dots {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .carousel-dot {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #E3E3DE;
    border: none;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .carousel-dot-progress {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .carousel-dot-track {
    fill: none;
    stroke: transparent;
    stroke-width: 2;
  }

  #shopify-section-{{ section.id }} .carousel-dot-indicator {
    fill: none;
    stroke: #26736D;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 113.1;
    stroke-dashoffset: 113.1;
  }

  #shopify-section-{{ section.id }} .carousel-dot.active .carousel-dot-track {
    stroke: #26736D;
    opacity: 0.4;
  }

  #shopify-section-{{ section.id }} .carousel-dot.active.is-playing .carousel-dot-indicator {
    animation: testimonialDotProgress var(--testimonial-autoplay-duration, 5000ms) linear forwards;
  }

  @keyframes testimonialDotProgress {
    from {
      stroke-dashoffset: 113.1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  #shopify-section-{{ section.id }} .carousel-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s linear;
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.05em;
    border: 1px solid #F5F5F5;
    filter: drop-shadow(0 2px 4px rgba(10, 13, 18, 0.04)) drop-shadow(0 4px 6px rgba(10, 13, 18, 0.03)) drop-shadow(0 12px 16px rgba(10, 13, 18, 0.08));
  }

  #shopify-section-{{ section.id }} .carousel-btn:hover:not(:disabled) {
    background-color: #26736D;
    color: white;
    border-color: #26736D;
  }

  #shopify-section-{{ section.id }} .carousel-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .testimonials-cta {
    background-color: #26736D;
    width: fit-content;
    color: white;
    padding: 16px 32px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    transition: opacity 0.3s linear;
    text-decoration: none;
    display: inline-block;
    align-self: center;
  }

  #shopify-section-{{ section.id }} .testimonials-cta:hover {
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .product-testimonials-wrapper {
      overflow: visible;
      padding-top: 0;
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .product-testimonials-main {
      gap: 40px;
      margin: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .product-testimonials-main h2 {
      font-size: 24px;
      font-weight: 700;
      line-height: 32px;
      letter-spacing: -0.02em;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .product-testimonials-main .description {
      text-align: left;
      font-size: 16px;
      line-height: 24px;
    }

    #shopify-section-{{ section.id }} .testimonial-card {
      flex-direction: column;
      justify-content: flex-start;
      padding: 16px;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .testimonial-images {
      flex: none;
      gap: 8px;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .testimonial-content-wrapper {
      display: flex;
      gap: 20px;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .testimonial-image {
      height: fit-content;
      aspect-ratio: 1 / 1;
      max-width: calc(50%);
    }

    #shopify-section-{{ section.id }} .testimonial-image-label {
      top: 8px;
      left: 8px;
    }

    #shopify-section-{{ section.id }} .testimonial-image img {
      object-fit: cover;
    }

    #shopify-section-{{ section.id }} .testimonial-content {
      font-size: 18px;
      line-height: 120%;
      font-weight: 500;

    }

    #shopify-section-{{ section.id }} .testimonial-author {
      font-size: 14px;
      line-height: 24px;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .carousel-progress-bar {
      max-width: 120px;
    }

    #shopify-section-{{ section.id }} .carousel-controls {
      margin-top: 32px;
      justify-content: space-between;
    }

    #shopify-section-{{ section.id }} .testimonials-cta {
      font-size: 16px;
      line-height: 24px;
      width: 100%;
      text-align: center;
    }
  }
{%- endstyle -%}

<div class="product-testimonials-wrapper section">
  <div class="product-testimonials-main">
    <div class="product-testimonials-heading">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.description %}
        <div class="description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    {% assign testimonials = product.metafields.custom.testimonials %}
    {% if testimonials %}
      <div class="testimonials-carousel-container">
        <div class="testimonials-carousel-track" id="carousel-track-{{ section.id }}">
          {% for testimonial in testimonials.value %}
            <div class="testimonial-card">
              <div class="testimonial-images">
                <div class="testimonial-image">
                  {% if testimonial.before_image %}
                    {% if testimonial.before_text %}
                      <div class="testimonial-image-label">{{ testimonial.before_text }}</div>
                    {% endif %}
                    <img
                      src="{{ testimonial.before_image | image_url: width: 300 }}"
                      width="{{ testimonial.before_image.width }}"
                      height="{{ testimonial.before_image.height }}"
                      alt="Before"
                    >
                  {% endif %}
                </div>
                <div class="testimonial-image">
                  {% if testimonial.after_image %}
                    {% if testimonial.after_text %}
                      <div class="testimonial-image-label">{{ testimonial.after_text }}</div>
                    {% endif %}
                    <img
                      src="{{ testimonial.after_image | image_url: width: 300 }}"
                      width="{{ testimonial.after_image.width }}"
                      height="{{ testimonial.after_image.height }}"
                      alt="After"
                    >
                  {% endif %}
                </div>
              </div>
              <div class="testimonial-content-wrapper">
                <div class="testimonial-content">{{ testimonial.content }}</div>
                <div class="testimonial-author">— {{ testimonial.name_age }}</div>
                {% if testimonial.tags %}
                  <div class="testimonial-tags">
                    {% for tag in testimonial.tags.value %}
                      <span class="testimonial-tag">{{ tag }}</span>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="carousel-controls">
          <button class="carousel-btn" id="prev-btn-{{ section.id }}" aria-label="Previous testimonial">❮</button>
          <div class="carousel-dots" id="carousel-dots-{{ section.id }}">
            {% for testimonial in testimonials.value %}
              <button
                class="carousel-dot{% if forloop.first %} active{% endif %}"
                data-index="{{ forloop.index0 }}"
                aria-label="Go to testimonial {{ forloop.index }}"
              >
                <svg class="carousel-dot-progress" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                  <circle class="carousel-dot-track" cx="20" cy="20" r="18"></circle>
                  <circle class="carousel-dot-indicator" cx="20" cy="20" r="18"></circle>
                </svg>
              </button>
            {% endfor %}
          </div>
          <button class="carousel-btn" id="next-btn-{{ section.id }}" aria-label="Next testimonial">❯</button>
        </div>
      </div>
      <a href="{{ section.settings.button_link }}" class="testimonials-cta">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.getElementById('carousel-track-{{ section.id }}');
    const prevBtn = document.getElementById('prev-btn-{{ section.id }}');
    const nextBtn = document.getElementById('next-btn-{{ section.id }}');
    const dotsContainer = document.getElementById('carousel-dots-{{ section.id }}');

    if (!track || !prevBtn || !nextBtn || !dotsContainer) return;

    const dots = dotsContainer.querySelectorAll('.carousel-dot');

    if (!dots.length) return;

    const AUTOPLAY_DURATION = 5000;
    let currentIndex = 0;
    let isAnimating = false;
    let animationTimeout;
    let resizeTimeout;
    let autoplayTimeout;

    track.style.setProperty('--testimonial-autoplay-duration', `${AUTOPLAY_DURATION}ms`);

    function getCardWidth() {
      return track.querySelector('.testimonial-card').offsetWidth + 40;
    }

    function updateDots() {
      dots.forEach((dot, index) => {
        const isActive = index === currentIndex;
        dot.classList.toggle('active', isActive);

        if (!isActive) {
          dot.classList.remove('is-playing');
        }
      });
    }

    function startActiveDotProgress() {
      const activeDot = dots[currentIndex];

      if (!activeDot) return;

      activeDot.classList.remove('is-playing');
      void activeDot.offsetWidth;
      activeDot.classList.add('is-playing');
    }

    function updateButtons() {
      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex === dots.length - 1;
    }

    function scrollToIndex(index) {
      index = Math.max(0, Math.min(index, dots.length - 1));
      const cardWidth = getCardWidth();
      const targetScroll = index * cardWidth;

      currentIndex = index;
      isAnimating = true;
      clearTimeout(animationTimeout);
      animationTimeout = setTimeout(() => {
        isAnimating = false;
      }, 600);

      track.scrollLeft = targetScroll;
      updateDots();
      updateButtons();
    }

    function clearAutoplay() {
      clearTimeout(autoplayTimeout);
      dots.forEach((dot) => dot.classList.remove('is-playing'));
    }

    function startAutoplay() {
      if (dots.length < 2) {
        clearAutoplay();
        return;
      }

      clearTimeout(autoplayTimeout);
      startActiveDotProgress();

      autoplayTimeout = setTimeout(() => {
        const nextIndex = currentIndex === dots.length - 1 ? 0 : currentIndex + 1;
        scrollToIndex(nextIndex);
        startAutoplay();
      }, AUTOPLAY_DURATION);
    }

    function handleResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        const cardWidth = getCardWidth();
        const targetScroll = currentIndex * cardWidth;
        track.scrollLeft = targetScroll;
      }, 150);
    }

    prevBtn.addEventListener('click', () => {
      scrollToIndex(currentIndex - 1);
      startAutoplay();
    });

    nextBtn.addEventListener('click', () => {
      scrollToIndex(currentIndex + 1);
      startAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        scrollToIndex(parseInt(dot.dataset.index));
        startAutoplay();
      });
    });

    track.addEventListener('scroll', (event) => {
      if (isAnimating) return; // Skip while scroll animation in progress
      const cardWidth = getCardWidth();
      currentIndex = Math.round(track.scrollLeft / cardWidth);
      updateDots();
      updateButtons();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearAutoplay();
      } else {
        startAutoplay();
      }
    });

    window.addEventListener('resize', handleResize);

    updateDots();
    updateButtons();
    startAutoplay();
  });
</script>

{% schema %}
{
  "name": "Product Testimonials",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Testimonials"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "CTA Button Text",
      "default": "Buy Now & Save 40%"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Product Testimonials",
      "category": "Products",
      "settings": {
        "heading": "Join Thousands Who've Regained Confidence in Their Hair",
        "description": "<p>See how real users achieved visible growth and restored their natural shine.</p>"
      }
    }
  ]
}
{% endschema %}
