{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .contact-faq-wrapper {
    width: 100%;
    background-color: var(--section-background-color);
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .contact-faq {
    display: flex;
    flex-direction: column;
    gap: 60px;
    width: 100%;
    max-width: var(--full-page-grid-central-column-width);
    margin-inline: auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .contact-faq__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .contact-faq__title {
    font-size: 44px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .contact-faq__list {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    border-top: 1px solid #e5e7eb;
  }

  #shopify-section-{{ section.id }} .contact-faq__item {
    border-bottom: 1px solid #e5e7eb;
    padding: 32px 0;
  }

  #shopify-section-{{ section.id }} .contact-faq__question {
    font-size: 18px;
    line-height: 28px;
    font-weight: 700;
    color: #181D27;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.2s;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .contact-faq__answer {
    font-size: 16px;
    line-height: 24px;
    color: #535862;
    padding-top: 20px;
    display: none;
    animation: fadeIn 0.3s;
  }

  #shopify-section-{{ section.id }} .contact-faq__item.open .contact-faq__answer {
    display: block;
  }

  #shopify-section-{{ section.id }} .contact-faq__icon {
    margin: 0;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .contact-faq__icon .icon-expand {
    display: block;
  }

  #shopify-section-{{ section.id }} .contact-faq__icon .icon-collapse {
    display: none;
  }

  #shopify-section-{{ section.id }} .contact-faq__item.open .contact-faq__icon .icon-expand {
    display: none;
  }

  #shopify-section-{{ section.id }} .contact-faq__item.open .contact-faq__icon .icon-collapse {
    display: block;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .contact-faq-wrapper {
      padding-top: 64px;
      padding-bottom: 64px;
    }

    #shopify-section-{{ section.id }} .contact-faq {
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .contact-faq__header {
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .contact-faq__title {
      font-size: 24px;
      line-height: 32px;
      letter-spacing: -0.02em;
    }

    #shopify-section-{{ section.id }} .contact-faq__question {
      font-size: 16px;
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .contact-faq__answer {
      font-size: 16px;
      line-height: 24px;
      font-weight: 500;
      padding-right: 40px;
      padding-top: 16px;
    }

    #shopify-section-{{ section.id }} .contact-faq__icon {
      width: 24px;
      height: 24px;
    }

    #shopify-section-{{ section.id }} .contact-faq__item {
      padding: 24px 0;
    }
  }
{%- endstyle -%}

<div class="contact-faq-wrapper">
  <div class="contact-faq">
    <div class="contact-faq__header">
      <h2 class="contact-faq__title">Got Questions? We've Got Answers.</h2>
    </div>
    <div class="contact-faq__list" id="faq-list-{{ section.id }}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="contact-faq__item" {{ block.shopify_attributes }}>
            <div class="contact-faq__question">
              <span>{{ block.settings.question }}</span>
              <span class="contact-faq__icon">
                <span class="icon-expand">{{- 'icon-expand.svg' | inline_asset_content -}}</span>
                <span class="icon-collapse">{{- 'icon-collapse.svg' | inline_asset_content -}}</span>
              </span>
            </div>
            <div class="contact-faq__answer">{{ block.settings.answer }}</div>
          </div>
        {% endfor %}
      {% else %}
        <div class="contact-faq__item open">
          <div class="contact-faq__question">
            <span>When will I start seeing results?</span>
            <span class="contact-faq__icon">
              <span class="icon-expand">{{- 'icon-expand.svg' | inline_asset_content -}}</span>
              <span class="icon-collapse">{{- 'icon-collapse.svg' | inline_asset_content -}}</span>
            </span>
          </div>
          <div class="contact-faq__answer">
            Most users notice visible improvement within 3—6 months of consistent use.
          </div>
        </div>
        <div class="contact-faq__item">
          <div class="contact-faq__question">
            <span>What affects women's hair growth?</span>
            <span class="contact-faq__icon">
              <span class="icon-expand">{{- 'icon-expand.svg' | inline_asset_content -}}</span>
              <span class="icon-collapse">{{- 'icon-collapse.svg' | inline_asset_content -}}</span>
            </span>
          </div>
          <div class="contact-faq__answer"></div>
        </div>
        <div class="contact-faq__item">
          <div class="contact-faq__question">
            <span>Will hair grow on other parts of my body?</span>
            <span class="contact-faq__icon">
              <span class="icon-expand">{{- 'icon-expand.svg' | inline_asset_content -}}</span>
              <span class="icon-collapse">{{- 'icon-collapse.svg' | inline_asset_content -}}</span>
            </span>
          </div>
          <div class="contact-faq__answer"></div>
        </div>
        <div class="contact-faq__item">
          <div class="contact-faq__question">
            <span>What are the main differences in formulas between Nutrafol Men, and Women's Balance?</span>
            <span class="contact-faq__icon">
              <span class="icon-expand">{{- 'icon-expand.svg' | inline_asset_content -}}</span>
              <span class="icon-collapse">{{- 'icon-collapse.svg' | inline_asset_content -}}</span>
            </span>
          </div>
          <div class="contact-faq__answer"></div>
        </div>
        <div class="contact-faq__item">
          <div class="contact-faq__question">
            <span>How is Nutrafol different from other hair growth products?</span>
            <span class="contact-faq__icon">
              <span class="icon-expand">{{- 'icon-expand.svg' | inline_asset_content -}}</span>
              <span class="icon-collapse">{{- 'icon-collapse.svg' | inline_asset_content -}}</span>
            </span>
          </div>
          <div class="contact-faq__answer"></div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var faqList = document.getElementById('faq-list-{{ section.id }}');
    if (!faqList) return;
    faqList.addEventListener('click', function (e) {
      var btn = e.target.closest('.contact-faq__question');
      if (!btn) return;
      var item = btn.closest('.contact-faq__item');
      var open = item.classList.contains('open');
      // Close all
      faqList.querySelectorAll('.contact-faq__item').forEach(function (i) {
        i.classList.remove('open');
        i.querySelector('.contact-faq__question').setAttribute('aria-expanded', 'false');
      });
      // Open clicked
      if (!open) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Contact FAQ",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "number",
      "id": "padding_top",
      "label": "Section padding top (px)",
      "default": 80
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Section padding bottom (px)",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fff"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQ",
      "category": "Contact"
    }
  ]
}
{% endschema %}
