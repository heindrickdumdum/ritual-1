{% schema %}
{
  "name": "Price Section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f3ef"
    },
    {
      "type": "color",
