{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-background: {{ section.settings.background_color }};
    --card-background: {{ section.settings.card_background }};
    --button-background: {{ section.settings.button_color }};
    --text-color: {{ section.settings.text_color }};
    --price-color: {{ section.settings.price_color }};
    --padding-top: {{ section.settings.padding-block-start }}px;
    --padding-bottom: {{ section.settings.padding-block-end }}px;
    --padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --padding-top: var(--padding-top-mobile);
      --padding-bottom: var(--padding-bottom-mobile);
    }
  }
{%- endstyle -%}

<div class="section price-section" style="background-color: var(--section-background); padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);">
  <div class="container">
    <div class="price-section__wrapper">
      {%- comment -%} Left Content {%- endcomment -%}
      <div class="price-section__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="price-section__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="price-section__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="price-section__features">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'feature' -%}
                  <li class="price-section__feature" {{ block.shopify_attributes }}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5.00098 13.9995L8.50098 17.4995L19.001 6.49951" stroke="#26736D" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                    <span>{{ block.settings.text }}</span>
                  </li>
              {%- endcase -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_trust_badge -%}
          <div class="price-section__trust">
            <div class="price-section__avatars">
              {%- if section.settings.avatar_1 != blank -%}
                <img src="{{ section.settings.avatar_1 | image_url: width: 48 }}" alt="" width="48" height="48" loading="lazy">
              {%- endif -%}
              {%- if section.settings.avatar_2 != blank -%}
                <img src="{{ section.settings.avatar_2 | image_url: width: 48 }}" alt="" width="48" height="48" loading="lazy">
              {%- endif -%}
              {%- if section.settings.avatar_3 != blank -%}
                <img src="{{ section.settings.avatar_3 | image_url: width: 48 }}" alt="" width="48" height="48" loading="lazy">
              {%- endif -%}
            </div>
            <div class="price-section__trust-text">{{ section.settings.trust_text }}</div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Pricing Card {%- endcomment -%}
      <div class="price-section__card">
        <div class="price-section__pricing">
          {%- if section.settings.original_price != blank -%}
            <span class="price-section__original-price">{{ section.settings.original_price }}</span>
          {%- endif -%}
          {%- if section.settings.price != blank -%}
            <div class="price-section__price">{{ section.settings.price }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.card_features != blank -%}
          <ul class="price-section__card-features">
            {%- assign card_features = section.settings.card_features | newline_to_br | split: '<br />' -%}
            {%- for feature in card_features -%}
              {%- if feature != blank -%}
                <li class="price-section__card-feature">
                 <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 14C0 6.26801 6.26801 0 14 0C21.732 0 28 6.26801 28 14C28 21.732 21.732 28 14 28C6.26801 28 0 21.732 0 14Z" fill="#E3E3DE"/>
                <path d="M9.33484 15.333L11.6682 17.6663L18.6682 10.333" stroke="#181D27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>


                  <span>{{ feature }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link }}" class="price-section__button">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}

        {%- if section.settings.show_payment_icons -%}
          <div class="price-section__payment-icons">
            {%- if section.settings.payment_icon_type == 'dynamic' -%}
              {%- for type in shop.enabled_payment_types limit: section.settings.payment_icons_limit -%}
                <div class="price-section__payment-icon">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- if section.settings.payment_icon_1 != blank -%}
                <img src="{{ section.settings.payment_icon_1 | image_url: width: 100 }}" alt="{{ section.settings.payment_icon_1_alt }}" width="50" height="32" loading="lazy">
              {%- endif -%}
              {%- if section.settings.payment_icon_2 != blank -%}
                <img src="{{ section.settings.payment_icon_2 | image_url: width: 100 }}" alt="{{ section.settings.payment_icon_2_alt }}" width="50" height="32" loading="lazy">
              {%- endif -%}
              {%- if section.settings.payment_icon_3 != blank -%}
                <img src="{{ section.settings.payment_icon_3 | image_url: width: 100 }}" alt="{{ section.settings.payment_icon_3_alt }}" width="50" height="32" loading="lazy">
              {%- endif -%}
              {%- if section.settings.payment_icon_4 != blank -%}
                <img src="{{ section.settings.payment_icon_4 | image_url: width: 100 }}" alt="{{ section.settings.payment_icon_4_alt }}" width="50" height="32" loading="lazy">
              {%- endif -%}
              {%- if section.settings.payment_icon_5 != blank -%}
                <img src="{{ section.settings.payment_icon_5 | image_url: width: 100 }}" alt="{{ section.settings.payment_icon_5_alt }}" width="50" height="32" loading="lazy">
              {%- endif -%}
              {%- if section.settings.payment_icon_6 != blank -%}
                <img src="{{ section.settings.payment_icon_6 | image_url: width: 100 }}" alt="{{ section.settings.payment_icon_6_alt }}" width="50" height="32" loading="lazy">
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
