  }
  {% endif %}

  {% if section.settings.heading_font_weight != blank %}
  #shopify-section-{{ section.id }} .price-section__heading {
    font-weight: {{ section.settings.heading_font_weight }};
  }
  {% endif %}

  {% if section.settings.heading_line_height != blank %}
  #shopify-section-{{ section.id }} .price-section__heading {
    line-height: {{ section.settings.heading_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .price-section__description {
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0 0 2rem 0;
    color: #535862;
  }

  {% if section.settings.description_font_size != blank %}
