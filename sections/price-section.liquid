    line-height: {{ section.settings.description_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .price-section__features {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0 0 3rem 0;
  }

  #shopify-section-{{ section.id }} .price-section__feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
