    line-height: {{ section.settings.button_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .price-section__button:hover {
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .price-section__payment-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
