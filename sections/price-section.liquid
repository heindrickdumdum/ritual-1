    padding: 6px;
    color: #26736D;
    border-radius: 20px;
    width: 28px;
    height: 28px;
  }

  #shopify-section-{{ section.id }} .price-section__trust {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: 0.5rem;
  }

