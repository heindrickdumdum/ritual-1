{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
  }

  #shopify-section-{{ section.id }} .section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .how-it-works-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-header__title {
    font-weight: 400;
    margin: 0 0 0.5rem;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .how-it-works-header__description {
    line-height: normal;
    font-size: 1.25rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-it-works-steps {
    display: flex;
    flex-direction: column;
    row-gap: 2rem;
    column-gap: 1rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-step {
    display: grid;
    grid-template-columns: 1fr 548px;
    gap: 3rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__content {
    max-width: 732px;
    border-top: 1px solid #E9EAEB;
    padding-top: 2rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__label {
    font-size: 1.125rem;
    color: rgba(var(--color-foreground), 0.5);
    margin: 0 0 0.5rem;
    letter-spacing: 0.05em;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__title {
    font-weight: 500;
    margin: 0 0 0.75rem;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .how-it-works-step__description {
    font-size: 1.125rem;
    color: #535862;
    line-height: normal;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__image--wrapper {
    
  }

  #shopify-section-{{ section.id }} .how-it-works-step__image {
    width: 100%;
    max-width: 34.25rem;
    height: 350px;
    background: #E5E5E0;
    border-radius: 16px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile carousel styles */
  #shopify-section-{{ section.id }} .how-it-works-carousel {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__wrapper {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__track {
    display: flex;
    gap: 1rem;
    scroll-snap-type: x mandatory;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* padding: 0 1rem; */
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__slide {
    flex: 0 0 calc(100% - 2rem);
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    max-width: 360px;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__slide .how-it-works-step__content {
    padding-top: 0;
    max-width: 100%;
    margin-bottom: 1.5rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__slide .how-it-works-step__image {
    height: 280px;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__button {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: #E5E5E0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__button--next {
    background: #4A9B8E;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__button svg {
    width: 20px;
    height: 20px;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__button--next svg {
    stroke: white;
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__progress {
    flex: 1;
    height: 4px;
    background: #E5E5E0;
    border-radius: 2px;
    overflow: hidden;
    /* max-width: 180px; */
  }

  #shopify-section-{{ section.id }} .how-it-works-carousel__progress-bar {
    height: 100%;
    background: #181D27;
    transition: width 0.3s ease;
    width: 0%;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .how-it-works-step {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    #shopify-section-{{ section.id }} .how-it-works-step__image {
      height: 250px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: var(--section-padding-top-mobile);
      --section-padding-bottom: var(--section-padding-bottom-mobile);
    }

    #shopify-section-{{ section.id }} .how-it-works-header {
      margin-bottom: 2.5rem;
      text-align: left;
      padding: 0 1rem;
    }

    #shopify-section-{{ section.id }} .how-it-works-header__title {
      line-height: normal;
      margin-bottom: 0.75rem;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__slide:last-child {
      margin-right: 20px;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__slide .how-it-works-step__content {
      padding: 0;
      padding-top: 1.5rem;
      margin-bottom: 1rem;
    }

    #shopify-section-{{ section.id }} .how-it-works-step__title,
    #shopify-section-{{ section.id }} .how-it-works-step__label {
      margin-bottom: 8px;
    }

    {% if section.settings.header_title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-header__title {
      font-size: {{ section.settings.header_title_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.header_title_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-header__title {
      font-weight: {{ section.settings.header_title_font_weight_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .how-it-works-header__description {
      font-size: {{ section.settings.header_description_font_size_mobile | default: 16 }}px;
    }

    {% if section.settings.header_description_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-header__description {
      font-weight: {{ section.settings.header_description_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.step_label_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-step__label {
      font-size: {{ section.settings.step_label_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.step_label_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-step__label {
      font-weight: {{ section.settings.step_label_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.step_title_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-step__title {
      font-size: {{ section.settings.step_title_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.step_title_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-step__title {
      font-weight: {{ section.settings.step_title_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.step_description_font_size_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-step__description {
      font-size: {{ section.settings.step_description_font_size_mobile }}px;
    }
    {% endif %}

    {% if section.settings.step_description_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .how-it-works-step__description {
      font-weight: {{ section.settings.step_description_font_weight_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .how-it-works-steps {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel {
      display: block;
      margin-right: -20px;
    }

    #shopify-section-{{ section.id }} .how-it-works-carousel__navigation {
      margin-right: 20px;
    }
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tw-overflow-x-hidden">
  <div class="container">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="how-it-works-header">
        {%- if section.settings.title != blank -%}
          <h2 class="how-it-works-header__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <p class="how-it-works-header__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Desktop layout {%- endcomment -%}
    <div class="how-it-works-steps">
      {%- for block in section.blocks -%}
        <article class="how-it-works-step" {{ block.shopify_attributes }}>
          <div class="how-it-works-step__content">
            {%- if block.settings.label != blank -%}
              <p class="how-it-works-step__label">{{ block.settings.label }}</p>
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <h3 class="how-it-works-step__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            
            {%- if block.settings.description != blank -%}
              <p class="how-it-works-step__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>

          <div class="how-it-works-step__image--wrapper tw-flex tw-justify-end">
            <div class="how-it-works-step__image">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    width: block.settings.image.width,
                    height: block.settings.image.height,
                    alt: block.settings.image.alt
                }}
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- comment -%} Mobile carousel layout {%- endcomment -%}
    <div class="how-it-works-carousel">
      <div class="how-it-works-carousel__wrapper tw-overflow-x-visible">
        <div class="how-it-works-carousel__track tw-overflow-x-visible" data-carousel-track>
          {%- for block in section.blocks -%}
            <div class="how-it-works-carousel__slide" {{ block.shopify_attributes }}>
              <div class="how-it-works-step__content">
                {%- if block.settings.label != blank -%}
                  <p class="how-it-works-step__label">{{ block.settings.label }}</p>
                {%- endif -%}
                
                {%- if block.settings.title != blank -%}
                  <h3 class="how-it-works-step__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                
                {%- if block.settings.description != blank -%}
                  <p class="how-it-works-step__description">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>

              <div class="how-it-works-step__image">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      width: block.settings.image.width,
                      height: block.settings.image.height,
                      alt: block.settings.image.alt
                  }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="how-it-works-carousel__navigation">
        <button class="how-it-works-carousel__button how-it-works-carousel__button--prev" data-carousel-prev aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="how-it-works-carousel__progress">
          <div class="how-it-works-carousel__progress-bar" data-carousel-progress></div>
        </div>

        <button class="how-it-works-carousel__button how-it-works-carousel__button--next" data-carousel-next aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const track = document.querySelector('[data-carousel-track]');
    if (!track) return;

    const slides = track.querySelectorAll('.how-it-works-carousel__slide');
    const prevBtn = document.querySelector('[data-carousel-prev]');
    const nextBtn = document.querySelector('[data-carousel-next]');
    const progressBar = document.querySelector('[data-carousel-progress]');
    
    let currentIndex = 0;
    const maxIndex = slides.length - 1;

    function updateCarousel() {
      const slideWidth = slides[0].offsetWidth + 16; // slide width + gap
      track.scrollTo({
        left: slideWidth * currentIndex,
        behavior: 'smooth'
      });

      // Update progress bar
      const progress = maxIndex > 0 ? (currentIndex / maxIndex) * 100 : 100;
      progressBar.style.width = `${progress}%`;

      // Update buttons
      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex === maxIndex;
    }

    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel();
      }
    });

    nextBtn.addEventListener('click', () => {
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateCarousel();
      }
    });

    // Handle scroll snap
    track.addEventListener('scroll', () => {
      const slideWidth = slides[0].offsetWidth + 16;
      const newIndex = Math.round(track.scrollLeft / slideWidth);
      if (newIndex !== currentIndex) {
        currentIndex = newIndex;
        const progress = maxIndex > 0 ? (currentIndex / maxIndex) * 100 : 100;
        progressBar.style.width = `${progress}%`;
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex === maxIndex;
      }
    });

    // Initialize
    updateCarousel();
  })();
</script>

