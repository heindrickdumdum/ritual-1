{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
  }

  #shopify-section-{{ section.id }} .section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .how-it-works-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-header__title {
    font-weight: 400;
    margin: 0 0 0.5rem;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .how-it-works-header__description {
    font-size: 1.25rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-it-works-steps {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  #shopify-section-{{ section.id }} .how-it-works-step {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .how-it-works-step {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .how-it-works-step__content {
    max-width: 500px;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__label {
    font-size: 0.875rem;
    color: rgba(var(--color-foreground), 0.5);
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__title {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .how-it-works-step__description {
    font-size: 0.9375rem;
    color: rgba(var(--color-foreground), 0.7);
    line-height: 1.6;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-it-works-step__image {
    width: 100%;
    height: 350px;
    background: #E5E5E0;
    border-radius: 16px;
    overflow: hidden;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .how-it-works-step__image {
      height: 250px;
    }
  }

  #shopify-section-{{ section.id }} .how-it-works-step__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="how-it-works-header">
        {%- if section.settings.title != blank -%}
          <h2 class="how-it-works-header__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <p class="how-it-works-header__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="how-it-works-steps">
      {%- for block in section.blocks -%}
        <article class="how-it-works-step" {{ block.shopify_attributes }}>
          <div class="how-it-works-step__content">
            {%- if block.settings.label != blank -%}
              <p class="how-it-works-step__label">{{ block.settings.label }}</p>
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <h3 class="how-it-works-step__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            
            {%- if block.settings.description != blank -%}
              <p class="how-it-works-step__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>

          <div class="how-it-works-step__image">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  alt: block.settings.image.alt
              }}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Simple steps to personalized wellness solutions"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Step label",
          "default": "Step 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Step description text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "Step 1",
            "title": "Tell Us About Yourself",
            "description": "Complete a short consultation form about your health goals and medical history"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Step 2",
            "title": "Review by Medical Team",
            "description": "Licensed healthcare providers review your information and create a personalized plan"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Step 3",
            "title": "Delivered to Your Door",
            "description": "Receive your treatment discreetly with ongoing support from our care team"
          }
        }
      ]
    }
  ]
}
{% endschema %}
