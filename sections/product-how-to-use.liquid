{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg-color: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .how-to-use-wrapper {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-bg-color);
  }

  #shopify-section-{{ section.id }} .how-to-use-main {
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    gap: 144px;
  }

  #shopify-section-{{ section.id }} .how-to-use-images {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header {
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header h2 {
    margin: 0;
    font-weight: 500;
    font-size: 44px;
    line-height: 136%;
    letter-spacing: -0.02em;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header p {
    margin: 0;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    letter-spacing: 0%;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-wrapper {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-item {
    width: 100%;
    aspect-ratio: 11 / 9;
    position: relative;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 20px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background-color: white;
    color: #26736D;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 16px;
    line-height: 150%;
    font-weight: 700;
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .how-to-use-list {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .how-to-use-title {
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .how-to-use-description {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-to-use-steps {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step {
    display: flex;
    flex-direction: row;
    gap: 32px;
    position: relative;
    padding-bottom: 50px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #E9EAEB;
  }

  #shopify-section-{{ section.id }} .how-to-use-step.active::after {
    background: linear-gradient(to right, #181D27 var(--progress, 0%), #E9EAEB var(--progress, 0%));
  }

  #shopify-section-{{ section.id }} .how-to-use-step-number.active {
    background-color: #26736D;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-number {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #26736D;
    color: white;
    font-size: 18px;
    line-height: 145%;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-title {
    margin: 0;
    font-weight: 700;
    font-size: 24px;
    line-height: 140%;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-details {
    margin: 0;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #535862;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .how-to-use-main {
      flex-direction: column;
      gap: 32px;
    }
  }
{%- endstyle -%}

<div class="how-to-use-wrapper section">
  <div class="how-to-use-main">
    {%- if section.blocks.size > 0 -%}
      <div class="how-to-use-images">
        <div class="how-to-use-image-header">
          <h2>How to Use for Best Results</h2>
          <p>A simple, 3-step daily ritual for stronger, fuller hair.</p>
        </div>
        <div class="how-to-use-image-wrapper">
          {%- for block in section.blocks -%}
            <div
              class="how-to-use-image-item"
              data-step="{{ forloop.index }}"
              {%- if forloop.first %}
                style="display: block;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {%- render 'image', image: block.settings.image -%}
              {%- endif -%}
              <div class="how-to-use-step-badge">Step - {{ forloop.index }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="how-to-use-list">
        <div class="how-to-use-header">
          {%- if section.settings.title != blank -%}
            <h2 class="how-to-use-title">{{ section.settings.title }}</h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <p class="how-to-use-description">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>

        <div class="how-to-use-steps" data-section-id="{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'step' -%}
                <div
                  class="how-to-use-step"
                  data-step="{{ forloop.index }}"
                  {{ block.shopify_attributes }}
                  {%- if forloop.first %}
                    data-active="true"
                  {% endif %}
                >
                  <div class="how-to-use-step-number">{{ forloop.index }}</div>

                  <div class="how-to-use-step-content">
                    {%- if block.settings.title != blank -%}
                      <h3 class="how-to-use-step-title">{{ block.settings.title }}</h3>
                    {%- endif -%}

                    {%- if block.settings.details != blank -%}
                      <p class="how-to-use-step-details">{{ block.settings.details }}</p>
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const stepsContainer = document.querySelector(`[data-section-id="${sectionId}"]`);
    const imageWrapper = document.querySelector(`#shopify-section-${sectionId} .how-to-use-image-wrapper`);

    if (!stepsContainer || !imageWrapper) return;

    const steps = Array.from(stepsContainer.querySelectorAll('[data-step]'));
    const imageItems = Array.from(imageWrapper.querySelectorAll('[data-step]'));
    const totalSteps = steps.length;
    let currentStep = 0;
    let animationInterval = null;
    let stepTimeout = null;

    // Preload all images
    function preloadImages() {
      imageItems.forEach((item) => {
        const img = item.querySelector('img');
        if (img && img.src) {
          const preloadImg = new Image();
          preloadImg.src = img.src;
        }
      });
    }

    function updateStep(stepIndex) {
      // Remove active class from all steps
      steps.forEach((step) => {
        step.classList.remove('active');
        step.removeAttribute('data-active');
      });

      // Add active class to current step
      steps[stepIndex].classList.add('active');
      steps[stepIndex].setAttribute('data-active', 'true');

      // Update image display
      imageItems.forEach((item) => {
        item.style.display = 'none';
      });
      imageItems[stepIndex].style.display = 'block';

      // Reset progress
      steps.forEach((step) => {
        step.style.setProperty('--progress', '0%');
      });
    }

    function animateProgress() {
      const currentStepElement = steps[currentStep];
      const duration = 3000; // 3 seconds
      const startTime = Date.now();

      if (animationInterval) clearInterval(animationInterval);

      animationInterval = setInterval(() => {
        const elapsed = Date.now() - startTime;
        const progress = Math.min((elapsed / duration) * 100, 100);
        currentStepElement.style.setProperty('--progress', progress + '%');

        if (progress >= 100) {
          clearInterval(animationInterval);
          // Move to the next step after a short delay to allow the progress bar to fill
          if (stepTimeout) clearTimeout(stepTimeout);
          stepTimeout = setTimeout(() => {
            currentStep = (currentStep + 1) % totalSteps;
            updateStep(currentStep);
            animateProgress();
          }, 0);
        }
      }, 16); // ~60fps
    }

    // Preload all images first
    preloadImages();

    // Initialize first step
    updateStep(0);
    animateProgress();
  });
</script>

{% schema %}
{
  "name": "Product How To Use",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step"
        },
        {
          "type": "textarea",
          "id": "details",
          "label": "Step Details"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product How To Use",
      "category": "Products"
    }
  ]
}
{% endschema %}
