{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg-color: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .how-to-use-wrapper {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-bg-color);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .how-to-use-main {
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    gap: 144px;
  }

  #shopify-section-{{ section.id }} .how-to-use-images {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header {
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header-mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header-desktop {
    display: flex;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header h2 {
    margin: 0;
    font-weight: 500;
    font-size: 44px;
    line-height: 136%;
    letter-spacing: -0.02em;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-header p {
    margin: 0;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    letter-spacing: 0%;
    color: #535862;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-wrapper {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-item {
    width: 100%;
    aspect-ratio: 11 / 9;
    position: relative;
  }

  #shopify-section-{{ section.id }} .how-to-use-image-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 20px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background-color: white;
    color: #26736D;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 16px;
    line-height: 150%;
    font-weight: 700;
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .how-to-use-list {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .how-to-use-title {
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .how-to-use-description {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-to-use-steps {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step {
    display: flex;
    flex-direction: row;
    gap: 32px;
    position: relative;
    padding-bottom: 50px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #E9EAEB;
  }

  #shopify-section-{{ section.id }} .how-to-use-step.active::after {
    background: linear-gradient(to right, #181D27 var(--progress, 0%), #E9EAEB var(--progress, 0%));
  }

  #shopify-section-{{ section.id }} .how-to-use-step-number {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #26736D;
    color: white;
    font-size: 18px;
    line-height: 145%;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-number-mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-number.active {
    background-color: #26736D;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-image {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-to-use-progress-bar {
    display: none;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-title {
    margin: 0;
    font-weight: 700;
    font-size: 24px;
    line-height: 140%;
  }

  #shopify-section-{{ section.id }} .how-to-use-step-details {
    margin: 0;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #535862;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .how-to-use-image-header-mobile {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .how-to-use-image-header-mobile h2 {
      margin: 0;
      font-size: 24px;
      line-height: 32px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #181D27;
    }

    #shopify-section-{{ section.id }} .how-to-use-image-header-mobile p {
      margin: 0;
      font-size: 16px;
      line-height: 24px;
      font-weight: 500;
      color: #535862;
    }

    #shopify-section-{{ section.id }} .how-to-use-image-header-desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-to-use-wrapper {
      padding-top: 64px;
      padding-bottom: 64px;
    }

    #shopify-section-{{ section.id }} .how-to-use-main {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .how-to-use-images {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-to-use-list {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .how-to-use-header {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-to-use-steps {
      display: flex;
      flex-direction: row;
      gap: 8px;
      width: 100%;
      box-sizing: border-box;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #shopify-section-{{ section.id }} .how-to-use-steps::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-to-use-step {
      flex-direction: column;
      gap: 0;
      padding: 0;
      width: calc((100vw - 32px - 8px) * 0.9);
      min-width: calc((100vw - 32px - 8px) * 0.9);
      flex-shrink: 0;
      scroll-snap-align: start;
      overflow: hidden;
      background: white;
      position: relative;
    }

    #shopify-section-{{ section.id }} .how-to-use-step:last-child {
      margin-right: 0;
    }

    #shopify-section-{{ section.id }} .how-to-use-step::after {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-image {
      display: block;
      width: 100%;
      aspect-ratio: 12 / 11;
      overflow: hidden;
      position: relative;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-badge {
      position: absolute;
      bottom: 12px;
      left: 12px;
      padding: 4px 12px;
      font-size: 14px;
      line-height: 24px;
      font-weight: 700;
      background-color: white;
      color: #26736D;
      border-radius: 8px;
      z-index: 10;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-content {
      display: flex;
      flex-direction: column;
      padding: 0;
      margin-top: 32px;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-number-desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-number-mobile {
      display: flex;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-number-mobile {
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-title {
      font-size: 20px;
      line-height: 28px;
      font-weight: 700;
      margin: 0;
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .how-to-use-step-details {
      font-size: 16px;
      line-height: 24px;
      font-weight: 500;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .how-to-use-progress-bar {
      display: block;
      width: 100%;
      height: 2px;
      background-color: #E9EAEB;
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .how-to-use-progress-bar-fill {
      height: 100%;
      background-color: #181D27;
      width: 0%;
      transition: width 0.1s linear;
    }
  }
{%- endstyle -%}

<div class="how-to-use-wrapper section">
  <div class="how-to-use-image-header how-to-use-image-header-mobile">
    <h2>How to Use for Best Results</h2>
    <p>A simple, 3-step daily ritual for stronger, fuller hair.</p>
  </div>

  <div class="how-to-use-header">
    {%- if section.settings.title != blank -%}
      <h2 class="how-to-use-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="how-to-use-description">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <div class="how-to-use-main">
    {%- if section.blocks.size > 0 -%}
      <div class="how-to-use-images">
        <div class="how-to-use-image-header how-to-use-image-header-desktop">
          <h2>How to Use for Best Results</h2>
          <p>A simple, 3-step daily ritual for stronger, fuller hair.</p>
        </div>
        <div class="how-to-use-image-wrapper">
          {%- for block in section.blocks -%}
            <div
              class="how-to-use-image-item"
              data-step="{{ forloop.index }}"
              {%- if forloop.first %}
                style="display: block;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {%- render 'image', image: block.settings.image -%}
              {%- endif -%}
              <div class="how-to-use-step-badge">Step - {{ forloop.index }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="how-to-use-list">
        <div class="how-to-use-steps" data-section-id="{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'step' -%}
                <div
                  class="how-to-use-step"
                  data-step="{{ forloop.index }}"
                  {{ block.shopify_attributes }}
                  {%- if forloop.first %}
                    data-active="true"
                  {% endif %}
                >
                  <div class="how-to-use-step-number how-to-use-step-number-desktop">{{ forloop.index }}</div>

                  <div class="how-to-use-step-image">
                    {%- if block.settings.image != blank -%}
                      {%- render 'image', image: block.settings.image -%}
                    {%- endif -%}
                    <div class="how-to-use-step-badge">Step {{ forloop.index }}</div>
                  </div>

                  <div class="how-to-use-step-content">
                    <div class="how-to-use-step-number how-to-use-step-number-mobile">{{ forloop.index }}</div>
                    {%- if block.settings.title != blank -%}
                      <h3 class="how-to-use-step-title">{{ block.settings.title }}</h3>
                    {%- endif -%}

                    {%- if block.settings.details != blank -%}
                      <p class="how-to-use-step-details">{{ block.settings.details }}</p>
                    {%- endif -%}
                  </div>

                  <div class="how-to-use-progress-bar">
                    <div class="how-to-use-progress-bar-fill"></div>
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const imageWrapper = document.querySelector(`#shopify-section-${sectionId} .how-to-use-image-wrapper`);
    const stepsContainer = document.querySelector(`#shopify-section-${sectionId} .how-to-use-steps`);
    const isMobile = window.innerWidth <= 768;

    if (!imageWrapper || !stepsContainer) return;

    const imageItems = Array.from(imageWrapper.querySelectorAll('[data-step]'));
    const steps = Array.from(stepsContainer.querySelectorAll('[data-step]'));
    let currentStep = 0;
    let animationInterval = null;
    let stepTimeout = null;

    function updateStep(stepIndex) {
      // Update active class on steps
      steps.forEach((step) => {
        step.classList.remove('active');
        step.removeAttribute('data-active');
      });
      steps[stepIndex].classList.add('active');
      steps[stepIndex].setAttribute('data-active', 'true');

      // Reset progress
      steps.forEach((step) => {
        step.style.setProperty('--progress', '0%');
        const progressFill = step.querySelector('.how-to-use-progress-bar-fill');
        if (progressFill) {
          progressFill.style.width = '0%';
        }
      });

      if (isMobile) {
        // Mobile: Scroll to the step
        const step = steps[stepIndex];
        const container = stepsContainer;
        const cardWidth = step.offsetWidth;
        const gap = 8;
        const scrollLeft = stepIndex * (cardWidth + gap);
        container.scrollLeft = scrollLeft;
      } else {
        // Desktop: Update image display
        imageItems.forEach((item) => {
          item.style.display = 'none';
        });
        imageItems[stepIndex].style.display = 'block';
      }
    }

    function animateProgress() {
      const duration = 3000; // 3 seconds
      const startTime = Date.now();

      if (animationInterval) clearInterval(animationInterval);

      animationInterval = setInterval(() => {
        const elapsed = Date.now() - startTime;
        const progress = Math.min((elapsed / duration) * 100, 100);

        // Update the progress for the current step
        steps[currentStep].style.setProperty('--progress', progress + '%');

        // Update the width of the progress bar fill
        const progressFill = steps[currentStep].querySelector('.how-to-use-progress-bar-fill');
        if (progressFill) {
          progressFill.style.width = progress + '%';
        }


        // If progress is complete move to the next step
        if (progress >= 100) {
          clearInterval(animationInterval);
          
          if (stepTimeout) clearTimeout(stepTimeout);
          stepTimeout = setTimeout(() => {
            currentStep = (currentStep + 1) % steps.length;
            updateStep(currentStep);
            animateProgress();
          }, 0);
        }
      }, 16); // ~60fps
    }

    // Initialize first step
    updateStep(0);
    animateProgress();
  });
</script>

{% schema %}
{
  "name": "Product How To Use",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step"
        },
        {
          "type": "textarea",
          "id": "details",
          "label": "Step Details"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product How To Use",
      "category": "Products"
    }
  ]
}
{% endschema %}
