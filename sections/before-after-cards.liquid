{{ 'overflow-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --section-padding-top-mobile: {{ section.settings.padding-block-start-mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding-block-end-mobile }}px;
    --heading-font-size: {{ section.settings.heading_font_size }}px;
    --heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --card-title-font-size: {{ section.settings.card_title_font_size }}px;
    --card-title-font-size-mobile: {{ section.settings.card_title_font_size_mobile }}px;
    --detail-font-size: {{ section.settings.detail_font_size }}px;
    --detail-font-size-mobile: {{ section.settings.detail_font_size_mobile }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .section {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #shopify-section-{{ section.id }} .before-after-carousel__nav--wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  #shopify-section-{{ section.id }} .before-after-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .before-after-header__title {
    font-weight: 400;
    font-size: var(--heading-font-size);
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  {% if section.settings.heading_font_weight != blank %}
  #shopify-section-{{ section.id }} .before-after-header__title {
    font-weight: {{ section.settings.heading_font_weight }};
  }
  {% endif %}

  {% if section.settings.heading_line_height != blank %}
  #shopify-section-{{ section.id }} .before-after-header__title {
    line-height: {{ section.settings.heading_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .before-after-carousel {
    position: relative;
    margin-bottom: 5rem;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__wrapper {
    /* overflow: hidden; */
    /* margin: 0 60px; */
    margin-bottom: 0.5rem;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .before-after-card {
    flex: 0 0 432px;
    background: #F7F7F5;
    border-radius: 20px;
    padding: 1rem;
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    min-width: 22.5rem; /* 360px */
  }

  #shopify-section-{{ section.id }} .before-after-card__content {
    padding: 0.5rem;
  }

  #shopify-section-{{ section.id }} .before-after-card__images {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .before-after-card__image-wrapper {
    flex: 1;
    position: relative;
    aspect-ratio: 49 / 60;
    border-radius: 12px;
    background: #E5E5E0;
  }

  #shopify-section-{{ section.id }} .before-after-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
  }

  #shopify-section-{{ section.id }} .before-after-card__image-label {
    position: absolute;
    bottom: -1.75rem;
    width: 196px;
    height: 20px;
    font-style: normal;
    font-weight: 500;
    font-size: 14px;
    line-height: 145%;
    color: #717680;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .before-after-card__title {
    font-size: var(--card-title-font-size);
    font-weight: 500;
    margin: 0 0 1rem;
    color: rgb(var(--color-foreground));
  }

  {% if section.settings.card_title_font_weight != blank %}
  #shopify-section-{{ section.id }} .before-after-card__title {
    font-weight: {{ section.settings.card_title_font_weight }};
  }
  {% endif %}

  {% if section.settings.card_title_line_height != blank %}
  #shopify-section-{{ section.id }} .before-after-card__title {
    line-height: {{ section.settings.card_title_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .before-after-card__details {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .before-after-card__detail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--detail-font-size);
    padding: 1rem 0;
  }

  {% if section.settings.detail_font_weight != blank %}
  #shopify-section-{{ section.id }} .before-after-card__detail {
    font-weight: {{ section.settings.detail_font_weight }};
  }
  {% endif %}

  {% if section.settings.detail_line_height != blank %}
  #shopify-section-{{ section.id }} .before-after-card__detail {
    line-height: {{ section.settings.detail_line_height }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .before-after-card__detail.detail--treatment {
    border-width: 1px 0px;
    border-style: solid;
    border-color: #E9EAEB;
  }

  #shopify-section-{{ section.id }} .before-after-card__detail.detail--duration {
    padding-bottom: 0;
  }

  #shopify-section-{{ section.id }} .before-after-card__detail-label {
    color: rgba(var(--color-foreground), 0.6);
  }

  #shopify-section-{{ section.id }} .before-after-card__detail-value {
    color: rgb(var(--color-foreground));
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__nav {
    /* position: absolute; */
    /* top: 50%; */
    /* transform: translateY(-50%); */
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #4A9B8E;
    border: none;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__nav:hover {
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__nav:disabled {
    /* opacity: 0.3; */
    cursor: not-allowed;
    background: #F7F7F4;
    border: 1px solid #D5D7DA;
    color: #181D27;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__nav--prev {
    left: 0;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__nav--next {
    right: 0;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__nav svg {
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__progress {
    height: 2px;
    background: #E5E5E0;
    border-radius: 1px;
    overflow: hidden;
    max-width: 1192px;
    /* margin: 0 auto 2rem; */
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .before-after-carousel__progress-bar {
    height: 100%;
    background: #181D27;
    transition: width 0.3s ease;
  }

  #shopify-section-{{ section.id }} .before-after-cta {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .before-after-cta__button {
    display: inline-block;
    background: #26736D;
    color: white;
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .before-after-cta__button:hover {
    opacity: 0.9;
  }

  /* Mobile Styles */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: var(--section-padding-top-mobile);
      --section-padding-bottom: var(--section-padding-bottom-mobile);
    }

    #shopify-section-{{ section.id }} .before-after-header__title {
      font-size: var(--heading-font-size-mobile);
    }

    {% if section.settings.heading_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .before-after-header__title {
      font-weight: {{ section.settings.heading_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.heading_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .before-after-header__title {
      line-height: {{ section.settings.heading_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .before-after-carousel__track {
      gap: 0.75rem;
    }

    #shopify-section-{{ section.id }} .before-after-card {
      flex: 0 0 260px;
    }

    #shopify-section-{{ section.id }} .before-after-card__title {
      font-size: var(--card-title-font-size-mobile);
    }

    {% if section.settings.card_title_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .before-after-card__title {
      font-weight: {{ section.settings.card_title_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.card_title_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .before-after-card__title {
      line-height: {{ section.settings.card_title_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .before-after-card__detail {
      font-size: var(--detail-font-size-mobile);
    }

    {% if section.settings.detail_font_weight_mobile != blank %}
    #shopify-section-{{ section.id }} .before-after-card__detail {
      font-weight: {{ section.settings.detail_font_weight_mobile }};
    }
    {% endif %}

    {% if section.settings.detail_line_height_mobile != blank %}
    #shopify-section-{{ section.id }} .before-after-card__detail {
      line-height: {{ section.settings.detail_line_height_mobile }};
    }
    {% endif %}

    #shopify-section-{{ section.id }} .before-after-carousel {
      margin-bottom: 2.5rem;
    }

    #shopify-section-{{ section.id }} .before-after-header {
      text-align: left;
      margin-bottom: 2.5rem;
    }

    #shopify-section-{{ section.id }} .before-after-carousel__nav--wrapper {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .before-after-carousel__nav {
      width: 48px;
      height: 48px;
    }
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section  color-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="before-after-header">
        <h2 class="before-after-header__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="section--{{ section.settings.section_width }}">
      <div class="before-after-carousel" data-carousel>
        <div class="before-after-carousel__wrapper">
          <div class="before-after-carousel__track" data-carousel-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'testimonial_card' -%}
                <article class="before-after-card" {{ block.shopify_attributes }}>
                  <div class="before-after-card__images">
                    <div class="before-after-card__image-wrapper">
                      {%- if block.settings.before_image != blank -%}
                        {{
                          block.settings.before_image
                          | image_url: width: 400
                          | image_tag:
                            loading: 'lazy',
                            width: block.settings.before_image.width,
                            height: block.settings.before_image.height,
                            alt: section.settings.before_label
                        }}
                      {%- endif -%}
                      <span class="before-after-card__image-label">{{ section.settings.before_label }}</span>
                    </div>
                    <div class="before-after-card__image-wrapper">
                      {%- if block.settings.after_image != blank -%}
                        {{
                          block.settings.after_image
                          | image_url: width: 400
                          | image_tag:
                            loading: 'lazy',
                            width: block.settings.after_image.width,
                            height: block.settings.after_image.height,
                            alt: section.settings.after_label
                        }}
                      {%- endif -%}
                      <span class="before-after-card__image-label">{{ section.settings.after_label }}</span>
                    </div>
                  </div>

                  <div class="before-after-card__content">
                    {%- if block.settings.title != blank -%}
                      <h3 class="before-after-card__title">{{ block.settings.title }}</h3>
                    {%- endif -%}

                    <div class="before-after-card__details">
                      {%- if block.settings.treatment != blank -%}
                        <div class="before-after-card__detail detail--treatment">
                          <span class="before-after-card__detail-label">{{ section.settings.treatment_label }}</span>
                          <span class="before-after-card__detail-value">{{ block.settings.treatment }}</span>
                        </div>
                      {%- endif -%}

                      {%- if block.settings.duration != blank -%}
                        <div class="before-after-card__detail detail--duration">
                          <span class="before-after-card__detail-label">{{ section.settings.duration_label }}</span>
                          <span class="before-after-card__detail-value">{{ block.settings.duration }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="sm:tw-py-8 tw-py-[0]">
          <div class="before-after-carousel__nav--wrapper tw-flex tw-items-center tw-relative tw-mt-8 tw-max-w-[1360px] tw-mx-auto">
          <div>
            <button class="before-after-carousel__nav before-after-carousel__nav--prev" data-carousel-prev aria-label="{{ section.settings.previous_button_label }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
          </div>

          <div class="before-after-carousel__progress tw-w-full">
            <div class="before-after-carousel__progress-bar" data-carousel-progress></div>
          </div>

          <div>
            <button class="before-after-carousel__nav before-after-carousel__nav--next" data-carousel-next aria-label="{{ section.settings.next_button_label }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>

          </div>

          
        </div>
        </div>
      </div>
    </div>

    {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
      <div class="before-after-cta">
        <a href="{{ section.settings.button_url }}" class="before-after-cta__button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carousels = document.querySelectorAll('[data-carousel]');
    
    carousels.forEach(carousel => {
      const track = carousel.querySelector('[data-carousel-track]');
      const prevBtn = carousel.querySelector('[data-carousel-prev]');
      const nextBtn = carousel.querySelector('[data-carousel-next]');
      const progressBar = carousel.querySelector('[data-carousel-progress]');
      const cards = track.querySelectorAll('.before-after-card');
      
      let currentIndex = 0;
      
      function calculateCardWidth() {
        if (cards.length === 0) return 0;
        const cardWidth = cards[0].offsetWidth;
        const trackStyle = window.getComputedStyle(track);
        const gap = parseFloat(trackStyle.gap) || 24;
        return cardWidth + gap;
      }
      
      function calculateMaxIndex() {
        const wrapperWidth = carousel.querySelector('.before-after-carousel__wrapper').offsetWidth;
        const trackWidth = track.scrollWidth;
        
        // If all content fits in the container, no scrolling is needed
        if (trackWidth <= wrapperWidth) {
          return 0;
        }
        
        const cardWidth = calculateCardWidth();
        if (cardWidth === 0) return 0;
        
        // Calculate how many cards are visible at once
        const visibleCards = Math.floor(wrapperWidth / cardWidth);
        
        // maxIndex is the number of cards minus the visible cards
        // This ensures we navigate through all cards without skipping
        return Math.max(0, cards.length - visibleCards);
      }

      function updateCarousel() {
        const wrapperWidth = carousel.querySelector('.before-after-carousel__wrapper').offsetWidth;
        const trackWidth = track.scrollWidth;
        const allItemsVisible = trackWidth <= wrapperWidth;
        
        // If all items are visible, don't apply any transform
        if (allItemsVisible) {
          track.style.transform = 'translateX(0px)';
          progressBar.style.width = '100%';
          prevBtn.disabled = true;
          nextBtn.disabled = true;
          return;
        }
        
        const cardWidth = calculateCardWidth();
        const maxIndex = calculateMaxIndex();
        const maxOffset = Math.max(0, trackWidth - wrapperWidth);
        
        // Use card-based navigation, but cap at maxOffset to prevent empty space
        const offset = Math.min(currentIndex * cardWidth, maxOffset);
        
        track.style.transform = `translateX(-${offset}px)`;
        
        // Update progress bar
        const progress = maxIndex > 0 ? ((currentIndex + 1) / (maxIndex + 1)) * 100 : 100;
        progressBar.style.width = `${progress}%`;
        
        // Update button states
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex >= maxIndex;
      }

      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          updateCarousel();
        }
      });

      nextBtn.addEventListener('click', () => {
        const maxIndex = calculateMaxIndex();
        if (currentIndex < maxIndex) {
          currentIndex++;
          updateCarousel();
        }
      });

      updateCarousel();

      // Update on resize
      window.addEventListener('resize', () => {
        currentIndex = 0;
        updateCarousel();
      });
    });
  });
</script>

{% schema %}
{
  "name": "Before After Cards",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Results You'll Love - Here's the Proof"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start Your Free Consultation"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
