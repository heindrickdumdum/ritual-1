{% comment %}
  Renders a reviews summary header block

  Accepts:
  - block: {Object} Block object
  - heading_text: {String} Heading text (e.g., "Our customers rate us")
  - average_rating: {Number} Average rating value (e.g., 4.8)
  - total_reviews: {Number} Total number of reviews

  Usage:
  {% render 'block-review', block: block %}
{% endcomment %}

{%- liquid
  assign heading = block.settings.heading_text | default: 'Our customers rate us'
  assign rating = block.settings.average_rating | default: 4.8
  assign total_reviews = block.settings.total_reviews | default: 52
  assign show_half_stars = block.settings.show_half_stars | default: true
  
  # Calculate full stars and half star
  assign rating_floor = rating | floor
  assign rating_decimal = rating | modulo: 1
  assign has_half_star = false
  assign half_star_position = 0
  
  if rating_decimal >= 0.25 and rating_decimal < 0.75
    assign has_half_star = true
    assign half_star_position = rating_floor | plus: 1
  elsif rating_decimal >= 0.75
    assign rating_floor = rating_floor | plus: 1
  endif
-%}

<div class="review-summary-block" {{ block.shopify_attributes }}>
  <div class="review-summary-block__container">
    <p class="review-summary-block__heading">{{ heading }}</p>
    
    <div class="review-summary-block__stars" role="img" aria-label="{{ rating }} out of 5 stars">
      {%- for i in (1..5) -%}
        {%- if i <= rating_floor -%}
          {%- comment %} Full star {% endcomment -%}
          <svg class="review-summary-block__star" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 2L25.878 13.764L38.776 15.528L29.388 24.472L31.756 37.236L20 30.764L8.244 37.236L10.612 24.472L1.224 15.528L14.122 13.764L20 2Z" fill="#F4D06F" stroke="#F4D06F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- elsif i == half_star_position and has_half_star and show_half_stars -%}
          {%- comment %} Half star {% endcomment -%}
          <svg class="review-summary-block__star review-summary-block__star--half" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="half-fill-{{ block.id }}">
                <stop offset="50%" stop-color="#F4D06F"/>
                <stop offset="50%" stop-color="transparent"/>
              </linearGradient>
            </defs>
            <path d="M20 2L25.878 13.764L38.776 15.528L29.388 24.472L31.756 37.236L20 30.764L8.244 37.236L10.612 24.472L1.224 15.528L14.122 13.764L20 2Z" fill="url(#half-fill-{{ block.id }})" stroke="#F4D06F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- else -%}
          {%- comment %} Empty star {% endcomment -%}
          <svg class="review-summary-block__star review-summary-block__star--empty" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 2L25.878 13.764L38.776 15.528L29.388 24.472L31.756 37.236L20 30.764L8.244 37.236L10.612 24.472L1.224 15.528L14.122 13.764L20 2Z" stroke="#F4D06F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <p class="review-summary-block__stats">
      <span class="review-summary-block__rating">{{ rating }}</span>/5 based on <span class="review-summary-block__count">{{ total_reviews }}</span> reviews
    </p>
  </div>
</div>

<style>
  .review-summary-block {
    background: transparent;
    padding: 1.5rem 2rem;
  }

  .review-summary-block__container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .review-summary-block__heading {
    font-size: 1.5rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .review-summary-block__stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .review-summary-block__star {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .review-summary-block__stats {
    font-size: 1.5rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .review-summary-block__rating,
  .review-summary-block__count {
    font-weight: 600;
  }

  @media screen and (max-width: 768px) {
    .review-summary-block {
      padding: 1.25rem 1rem;
    }

    .review-summary-block__container {
      gap: 0.75rem;
    }

    .review-summary-block__heading {
      font-size: 1.125rem;
    }

    .review-summary-block__star {
      width: 28px;
      height: 28px;
    }

    .review-summary-block__stats {
      font-size: 1.125rem;
    }
  }

  @media screen and (max-width: 480px) {
    .review-summary-block__container {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Reviews Summary",
  "tag": "div",
  "class": "review-summary-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "Our customers rate us"
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Average Rating",
      "default": "4.8",
      "info": "Enter decimal number (e.g., 4.8)"
    },
    {
      "type": "number",
      "id": "total_reviews",
      "label": "Total Reviews",
      "default": 52
    },
    {
      "type": "checkbox",
      "id": "show_half_stars",
      "label": "Show Half Stars",
      "default": true,
      "info": "Display half stars for ratings like 4.5"
    },
    {
      "type": "header",
      "content": "Style Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Reviews Summary",
      "settings": {
        "heading_text": "Our customers rate us",
        "average_rating": "4.8",
        "total_reviews": 52,
        "show_half_stars": true
      }
    }
  ]
}
{% endschema %}
