{% comment %}
  Renders a customer review block

  Accepts:
  - block: {Object} Block object
  - review_rating: {Number} Rating value (1-5)
  - review_author: {String} Reviewer name
  - review_date: {String} Review date
  - review_title: {String} Review title/headline
  - review_content: {String} Review text content
  - verified_purchase: {Boolean} Whether this is a verified purchase

  Usage:
  {% render 'block-review', block: block %}
{% endcomment %}

{%- liquid
  assign rating = block.settings.review_rating | default: 5
  assign author = block.settings.review_author | default: 'Customer'
  assign date = block.settings.review_date | default: 'now'
  assign title = block.settings.review_title
  assign content = block.settings.review_content
  assign verified = block.settings.verified_purchase | default: false
  assign show_avatar = block.settings.show_avatar | default: false
  assign avatar_style = block.settings.avatar_style | default: 'circle'
-%}

<div class="review-block" {{ block.shopify_attributes }}>
  <div class="review-block__container">
    {%- comment %} Review Header {% endcomment -%}
    <div class="review-block__header">
      {%- if show_avatar -%}
        <div class="review-block__avatar review-block__avatar--{{ avatar_style }}">
          {%- if block.settings.avatar_image != blank -%}
            {{ block.settings.avatar_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'review-block__avatar-image' }}
          {%- else -%}
            <div class="review-block__avatar-placeholder">
              <span class="review-block__avatar-initial">{{ author | slice: 0 }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="review-block__meta">
        <div class="review-block__author-line">
          <h3 class="review-block__author">{{ author }}</h3>
          {%- if verified -%}
            <span class="review-block__verified">
              <svg class="review-block__verified-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 0L10.4 5.6L16 6.4L12 10.4L13.2 16L8 13.2L2.8 16L4 10.4L0 6.4L5.6 5.6L8 0Z" fill="currentColor"/>
                <path d="M6 8L7.5 9.5L10.5 6.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="review-block__verified-text">Verified Purchase</span>
            </span>
          {%- endif -%}
        </div>

        {%- comment %} Star Rating {% endcomment -%}
        <div class="review-block__rating" role="img" aria-label="{{ rating }} out of 5 stars">
          {%- for i in (1..5) -%}
            {%- if i <= rating -%}
              <svg class="review-block__star review-block__star--filled" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 0L11.0206 6.57295L18 7.60081L13.5 12.1771L14.5106 19L9 15.5729L3.48937 19L4.5 12.1771L0 7.60081L6.97937 6.57295L9 0Z" fill="currentColor"/>
              </svg>
            {%- else -%}
              <svg class="review-block__star review-block__star--empty" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 0L11.0206 6.57295L18 7.60081L13.5 12.1771L14.5106 19L9 15.5729L3.48937 19L4.5 12.1771L0 7.60081L6.97937 6.57295L9 0Z" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if date != blank -%}
          <p class="review-block__date">{{ date | date: '%B %d, %Y' }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment %} Review Content {% endcomment -%}
    <div class="review-block__body">
      {%- if title != blank -%}
        <h4 class="review-block__title">{{ title }}</h4>
      {%- endif -%}

      {%- if content != blank -%}
        <div class="review-block__content">
          {{ content }}
        </div>
      {%- endif -%}
    </div>

    {%- comment %} Optional Product Reference {% endcomment -%}
    {%- if block.settings.show_product_reference and block.settings.product != blank -%}
      <div class="review-block__product">
        <p class="review-block__product-label">Reviewing:</p>
        <a href="{{ block.settings.product.url }}" class="review-block__product-link">
          {{ block.settings.product.title }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .review-block {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .review-block:last-child {
    border-bottom: none;
  }

  .review-block__container {
    max-width: 100%;
  }

  .review-block__header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .review-block__avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    overflow: hidden;
  }

  .review-block__avatar--circle {
    border-radius: 50%;
  }

  .review-block__avatar--square {
    border-radius: 8px;
  }

  .review-block__avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-block__avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    font-weight: 600;
    font-size: 1.25rem;
  }

  .review-block__meta {
    flex: 1;
    min-width: 0;
  }

  .review-block__author-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .review-block__author {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: rgb(18, 18, 18);
  }

  .review-block__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: #10b981;
    font-weight: 500;
  }

  .review-block__verified-icon {
    width: 14px;
    height: 14px;
    color: #10b981;
  }

  .review-block__rating {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .review-block__star {
    width: 16px;
    height: 16px;
  }

  .review-block__star--filled {
    color: #fbbf24;
  }

  .review-block__star--empty {
    color: #d1d5db;
  }

  .review-block__date {
    font-size: 0.875rem;
    color: rgb(115, 115, 115);
    margin: 0;
  }

  .review-block__body {
    margin-top: 1rem;
  }

  .review-block__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
    color: rgb(18, 18, 18);
  }

  .review-block__content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(51, 51, 51);
  }

  .review-block__product {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .review-block__product-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(115, 115, 115);
    margin: 0 0 0.25rem 0;
    font-weight: 600;
  }

  .review-block__product-link {
    color: rgb(18, 18, 18);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .review-block__product-link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .review-block {
      padding: 1.5rem 0;
    }

    .review-block__avatar {
      width: 40px;
      height: 40px;
    }

    .review-block__author {
      font-size: 0.9375rem;
    }

    .review-block__title {
      font-size: 1rem;
    }

    .review-block__content {
      font-size: 0.875rem;
    }
  }
</style>

{% schema %}
{
  "name": "Review",
  "tag": "div",
  "class": "review-block-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "review_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "label": "Rating"
    },
    {
      "type": "text",
      "id": "review_author",
      "label": "Reviewer Name",
      "default": "Sarah Johnson"
    },
    {
      "type": "text",
      "id": "review_date",
      "label": "Review Date",
      "default": "2024-01-15",
      "info": "Format: YYYY-MM-DD"
    },
    {
      "type": "checkbox",
      "id": "verified_purchase",
      "label": "Verified Purchase",
      "default": true
    },
    {
      "type": "header",
      "content": "Review Content"
    },
    {
      "type": "text",
      "id": "review_title",
      "label": "Review Title",
      "default": "Amazing product!"
    },
    {
      "type": "textarea",
      "id": "review_content",
      "label": "Review Text",
      "default": "I've been using this product for a few weeks now and I'm absolutely loving it. The quality is exceptional and it exceeded my expectations. Highly recommend to anyone looking for a reliable solution!"
    },
    {
      "type": "header",
      "content": "Avatar Settings"
    },
    {
      "type": "checkbox",
      "id": "show_avatar",
      "label": "Show Avatar",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "avatar_image",
      "label": "Avatar Image",
      "info": "Optional - if not set, will show initial letter"
    },
    {
      "type": "select",
      "id": "avatar_style",
      "label": "Avatar Style",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "Product Reference"
    },
    {
      "type": "checkbox",
      "id": "show_product_reference",
      "label": "Show Product Reference",
      "default": false
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Review",
      "settings": {
        "review_rating": 5,
        "review_author": "Sarah Johnson",
        "review_title": "Amazing product!",
        "review_content": "I've been using this product for a few weeks now and I'm absolutely loving it. The quality is exceptional and it exceeded my expectations. Highly recommend to anyone looking for a reliable solution!",
        "verified_purchase": true,
        "show_avatar": true,
        "avatar_style": "circle"
      }
    }
  ]
}
{% endschema %}
